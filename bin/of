#!/usr/bin/env python3
"""of: the Organic Framework CLI, v0.

A thin layer over herdr. It reads the position registries and binds each
position to its live holder by agent session id.

  of apply [--dry-run]   name live holders in herdr and set their pane tokens
  of who [--json] [-l]   one table of positions and live agents
  of go <name>           focus an agent by canonical name, alias, role, pane or session
  of desk [...]          the desk and the attention router (see `of desk --help`)
  of model [...]         the model at time t and the owner's measures (of_studio: bin/of_studio_cli.py)
  of studio [--file P]   the Studio page (of_studio)
  of capacity status     model limits per account, and who runs where (of_capacity; docs/capacity.md)

No daemon, no state of its own. Needs python3 with PyYAML and the herdr CLI.
Registries: registry/positions.yaml in each organization repo listed in
~/.config/of/orgs.yaml (schema: docs/registry.md). Set OF_ORGS to use another
list, OF_HERDR to use another herdr binary.
"""

import argparse
import json
import os
import re
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

if __name__ == "__main__" and len(sys.argv) > 1 and sys.argv[1] == "hook":
    # the collector and the guard, never blocked by a missing PyYAML; only when run as the program:
    # of_hook loads this file as a module (of_cli) to read the registries, which must not re-enter here
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    import of_hook  # noqa: E402
    sys.exit(of_hook.main(sys.argv[2:]))  # event, plus any flags (e.g. --deny-secrets for the @mention block)

try:
    import yaml
except ImportError:
    sys.exit("of: PyYAML is missing. Install it with `python3 -m pip install --user pyyaml`.")

from of_locale import tr  # noqa: E402  what a person reads, in their language (bin/of_locale.py)

NAME_RE = re.compile(r"^[a-z][a-z0-9_-]{0,31}$")
SOURCE = "of:registry"
DESK = "desk"  # the desk workspace label; `of desk` owns its layout


def pane_label(name):
    return f"■ {name} ■"


ASK_MARK = re.compile(r"\s*·\s*❓ asks you|\s*❓\d+$")


def strip_label(text):
    return ASK_MARK.sub("", text.strip().strip("■").strip()).strip()


def base_label(text):
    """A tab or pane label without the ask marker the ask display adds (`k8s ❓1`, `· ❓ asks you`)."""
    t = (text or "").strip()
    if t.startswith("■"):
        return pane_label(strip_label(t))
    return ASK_MARK.sub("", t).strip()
TOKENS = ("system", "role", "summary")
SUMMARY_MAX = 40
STATUSES = ("active", "parked", "finished")
THROUGHPUT = ("raise", "sustain", "expense", "measure", "coordinate")
MEMORY_SCOPES = ("position", "unit", "org")  # RFC 0006: the registry key memory: (bin/of_memory.py SCOPES)
HELD = set()  # organizations on hold in orgs.yaml: `of apply` leaves their panes alone
BROKEN = set()  # organizations whose registry did not parse this run
_WARNED_HEAD = set()  # organizations whose committed registry stood in for a broken working copy (warned once)


def committed_registry(path, timeout=5):
    """The registry as last committed (git show HEAD:<path>), parsed, or None: the stand-in while the working copy
    does not parse."""
    root = os.path.dirname(os.path.dirname(path))
    try:
        top = subprocess.run(["git", "-C", root, "rev-parse", "--show-toplevel"], capture_output=True, text=True,
                             timeout=timeout)
        if top.returncode != 0:
            return None
        rel = os.path.relpath(os.path.realpath(path), os.path.realpath(top.stdout.strip()))
        r = subprocess.run(["git", "-C", root, "show", f"HEAD:{rel}"], capture_output=True, text=True,
                           timeout=timeout)
        if r.returncode != 0:
            return None
        doc = yaml.safe_load(r.stdout) or {}
        return doc if isinstance(doc, dict) else None
    except (OSError, subprocess.TimeoutExpired, yaml.YAMLError):
        return None
ORG_SHORT = {}  # organization -> short name for unit workspace labels (`short:` in orgs.yaml)
ORGS_FILE = os.environ.get("OF_ORGS") or os.path.join(os.environ.get("OF_CONFIG_DIR") or os.path.expanduser("~/.config/of"), "orgs.yaml")
HERDR = os.environ.get("OF_HERDR", "herdr")


class OfError(Exception):
    pass


# ---------------------------------------------------------------- registry

def org_agents(org, orgs_file=ORGS_FILE):
    """The organization's default model and effort for its agents' sessions: `agents: {model, effort}` on its
    orgs.yaml entry, which of init writes (opus, xhigh; the founder, 2026-11-11). {} when unset."""
    try:
        with open(orgs_file) as fh:
            doc = yaml.safe_load(fh) or {}
    except (OSError, yaml.YAMLError):
        return {}
    for o in doc.get("orgs") or []:
        if isinstance(o, dict) and o.get("name") == org and isinstance(o.get("agents"), dict):
            return {k: str(v) for k, v in o["agents"].items() if k in ("model", "effort") and v}
    return {}


def _org_entry(org, orgs_file=ORGS_FILE):
    """The organization's entry in orgs.yaml, {} when missing."""
    try:
        with open(orgs_file) as fh:
            doc = yaml.safe_load(fh) or {}
    except (OSError, yaml.YAMLError):
        return {}
    return next((o for o in doc.get("orgs") or [] if isinstance(o, dict) and o.get("name") == org), {})


def _org_paths(orgs_file=ORGS_FILE):
    with open(orgs_file) as fh:
        doc = yaml.safe_load(fh) or {}
    return {o.get("name"): list(o.get("paths") or []) for o in doc.get("orgs") or []}


def org_registries(orgs_file=ORGS_FILE):
    """Return [(org name, registry path, workspace label)] from the machine's list of organizations."""
    if not os.path.exists(orgs_file):
        raise OfError(f"no organizations listed: create {orgs_file} (see docs/registry.md)")
    with open(orgs_file) as fh:
        doc = yaml.safe_load(fh) or {}
    base = os.path.dirname(os.path.abspath(orgs_file))
    out = []
    for o in doc.get("orgs") or []:
        if not o.get("path"):
            continue  # joined through a server only, no local checkout of its repository yet
        root = os.path.join(base, os.path.expanduser(str(o["path"])))
        name = o.get("name") or os.path.basename(root)
        out.append((name, os.path.join(root, "registry", "positions.yaml"), o.get("workspace") or name))
        ORG_SHORT[name] = str(o.get("short") or o.get("workspace") or name)
        if o.get("hold"):
            HELD.add(name)
    return out


def load_positions(orgs_file=ORGS_FILE, deep=False):
    """Return (positions, problems). A position is a dict with an added `_file` and `_org`."""
    positions, problems, seen = [], [], {}
    for org, path, workspace in org_registries(orgs_file):
        rel = f"{org}:registry/positions.yaml"
        if not os.path.exists(path):
            problems.append(f"{rel}: missing ({path})")
            continue
        try:
            with open(path) as fh:
                doc = yaml.safe_load(fh) or {}
        except yaml.YAMLError as e:  # one broken registry (say, mid-edit) must not stop the others
            mark = getattr(e, "problem_mark", None)
            where = (f" at line {mark.line + 1}" if mark else "") + f": {getattr(e, 'problem', None) or e}"
            BROKEN.add(org)
            doc = committed_registry(path)
            if doc is None:
                problems.append(f"{rel}: not valid YAML{where}; its positions are skipped")
                continue
            # a user organization, 2026-11-11: a minute of invalid YAML mid-edit failed every session's of send and of inbox
            # ("cannot tell which position you are") and paged through the relay; the last commit keeps them working
            msg = (f"{rel}: the working copy is not valid YAML{where}; using its last committed version (HEAD) "
                   f"until it is fixed")
            problems.append(msg)
            if org not in _WARNED_HEAD:
                _WARNED_HEAD.add(org)
                print(f"of: warning: {msg}", file=sys.stderr)
        for p in doc.get("positions") or []:
            name = p.get("name", "")
            if not isinstance(p, dict):
                problems.append(f"{rel}: an entry is not a mapping: {p!r}")
                continue
            for trap in yaml_traps(p):
                problems.append(f"{rel}: {p.get('name', '?')}: {trap}")
            p["_file"], p["_org"], p["_orgid"], p["_workspace"] = rel, org, doc.get("organization") or org, workspace
            p["_root"] = os.path.dirname(os.path.dirname(path))  # the organization's repository
            p["_systems"] = doc.get("systems") or {}
            p["_units"] = doc.get("units") if isinstance(doc.get("units"), dict) else {}
            p["_memory_org"] = doc.get("memory")  # RFC 0006: the organization's memory scope (bin/of_memory.py)
            p["_delegations"] = doc.get("delegations") if isinstance(doc.get("delegations"), list) else []
            p["_unit"] = p.get("unit") or unit_of(p.get("system"), p["_units"])  # `unit:` places an owner in it
            if p.get("unit") and p["unit"] not in p["_units"]:
                problems.append(f"{rel}: {name}: unit {p['unit']!r} is not in units:")
            p["_home_ws"] = want_workspace(p)
            u = (p["_units"].get(p["_unit"]) or {}) if p["_unit"] else {}
            p["_unit_owner"] = u.get("owner")
            p["_delegation"] = next((x for x in reversed(doc.get("delegations") or [])
                                     if isinstance(x, dict) and x.get("unit") == p["_unit"]
                                     and x.get("to_owner") == u.get("owner")), None)
            if not NAME_RE.match(name):
                problems.append(f"{rel}: invalid name {name!r} (must match {NAME_RE.pattern})")
                continue
            if len(str(p.get("summary") or "")) > SUMMARY_MAX:
                problems.append(f"{rel}: {name}: summary is longer than {SUMMARY_MAX} characters")
            if p.get("status") is not None and p.get("status") not in STATUSES:
                problems.append(f"{rel}: {name}: status {p.get('status')!r} is not one of {', '.join(STATUSES)}")
            if p.get("memory") is not None and p.get("memory") not in MEMORY_SCOPES:
                problems.append(f"{rel}: {name}: memory {p.get('memory')!r} is not one of {', '.join(MEMORY_SCOPES)}")
            if p.get("throughput") is not None and p.get("throughput") not in THROUGHPUT:
                problems.append(f"{rel}: {name}: throughput {p.get('throughput')!r} is not one of {', '.join(THROUGHPUT)}")
            problems += [f"{rel}: {name}: {x}" for x in check_mandate_fields(p)]
            w = p.get("waiting_on")
            if w is not None and waiting_rank(w) is None:
                problems.append(f"{rel}: {name}: waiting_on {w!r} is not 'owner', a position name or 'external:<who>'")
            for key in [name] + list(p.get("aliases") or []):
                if key in seen:
                    problems.append(f"{rel}: {key!r} is used by both {seen[key]} and {name}")
                else:
                    seen[key] = name
            positions.append(p)
    for org, path, _ in org_registries(orgs_file) if deep else ():  # the systems map: `of registry check` only
        if os.path.exists(path) and org not in BROKEN:
            with open(path) as fh:
                text = fh.read()
            problems += [f"{org}:registry/positions.yaml: line {ln}: key {k!r} appears twice in one mapping "
                         "(YAML keeps the last one)" for ln, k in duplicate_keys(text)]
            for ln, k, kept, com, cut in comment_cuts(text):
                rel = f"{org}:registry/positions.yaml: line {ln}: {k}"
                kept = kept if len(kept) <= 40 else "…" + kept[-40:].split(" ", 1)[-1]
                problems.append(f"{rel}: the value is cut by a comment at ' {com[:30]}': YAML reads only {kept!r}; "
                                "quote the value" if cut else
                                f"{WARN}{rel}: ' {com[:30]}' after the value: if it is text, quote the value; "
                                "if it is a comment, put two spaces before the hash")
            doc = yaml.safe_load(text) or {}
            names = {p["name"] for p in positions if p.get("_org") == org}
            roots = _org_paths(orgs_file).get(org, [])
            problems += [f"{org}:registry/positions.yaml: systems: {pr}"
                         for pr in check_systems(doc.get("systems"), names, roots)]
            problems += [(f"{WARN}{org}:registry/positions.yaml: {pr[len(WARN):]}" if pr.startswith(WARN)
                          else f"{org}:registry/positions.yaml: {pr}") for pr in check_people(
                doc, [p for p in doc.get("positions") or [] if isinstance(p, dict) and p.get("name")])]
            problems += [(f"{WARN}{org}:registry/positions.yaml: {pr[len(WARN):]}" if pr.startswith(WARN)
                          else f"{org}:registry/positions.yaml: {pr}")
                         for pr in check_cells(doc, [p for p in doc.get("positions") or [] if isinstance(p, dict)
                                                     and p.get("name")])]
            try:
                import of_grants
                org_grants = of_grants.load(orgs_file).get(org) or []
            except Exception:  # noqa: BLE001 - grants are checked on their own below
                org_grants = []
            problems += [(f"{WARN}{org}:registry/positions.yaml: {pr[len(WARN):]}" if pr.startswith(WARN)
                          else f"{org}:registry/positions.yaml: {pr}") for pr in check_provisional(
                doc, [p for p in doc.get("positions") or [] if isinstance(p, dict) and p.get("name")], org_grants)]
            try:  # the organization's plugin choices (docs/plugins.md §2)
                import of_family
                problems += [(f"{WARN}{org}:registry/positions.yaml: {pr[len(WARN):]}" if pr.startswith(WARN)
                              else f"{org}:registry/positions.yaml: {pr}") for pr in of_family.check_org(doc)]
            except Exception as e:  # noqa: BLE001
                problems.append(f"{org}:registry/positions.yaml: plugins: the check could not run ({e})")
            problems += [f"{WARN}{org}:registry/positions.yaml: {pr[len(WARN):]}" for pr in check_evidence(
                doc, [p for p in doc.get("positions") or [] if isinstance(p, dict) and p.get("name")])]
    for org, path, _ in org_registries(orgs_file):
        units = next((p["_units"] for p in positions if p.get("_org") == org), None)
        if units is None and os.path.exists(path) and org not in BROKEN:
            with open(path) as fh:
                units = (yaml.safe_load(fh) or {}).get("units")
        if units is not None:
            names = {p["name"] for p in positions if p.get("_org") == org}
            systems = next((p["_systems"] for p in positions if p.get("_org") == org), {})
            problems += [f"{org}:registry/positions.yaml: units: {pr}" for pr in check_units(units, names, systems)]
        dels = next((p.get("_delegations") for p in positions if p.get("_org") == org), None)
        if dels:
            names = {p["name"] for p in positions if p.get("_org") == org}
            problems += [f"{org}:registry/positions.yaml: delegations: {pr}"
                         for pr in check_delegations(dels, names, units or {})]
    for org in sorted({p["_org"] for p in positions}):  # RFC 0006: the memory scope at the top and on units
        first = next(p for p in positions if p["_org"] == org)
        rel = f"{org}:registry/positions.yaml"
        if first.get("_memory_org") is not None and first["_memory_org"] not in MEMORY_SCOPES:
            problems.append(f"{rel}: memory {first['_memory_org']!r} is not one of {', '.join(MEMORY_SCOPES)}")
        for uid, u in (first.get("_units") or {}).items():
            if isinstance(u, dict) and u.get("memory") is not None and u["memory"] not in MEMORY_SCOPES:
                problems.append(f"{rel}: units: {uid}: memory {u['memory']!r} is not one of {', '.join(MEMORY_SCOPES)}")
    for org, path, _ in org_registries(orgs_file):  # works: (docs/works.md, step 1)
        if org in BROKEN or not os.path.exists(path):
            continue
        with open(path) as fh:
            works = (yaml.safe_load(fh) or {}).get("works")
        if works is not None:
            names = {p["name"] for p in positions if p.get("_org") == org}
            systems = next((p["_systems"] for p in positions if p.get("_org") == org), {})
            units = next((p["_units"] for p in positions if p.get("_org") == org), None)
            statuses = {p["name"]: p.get("status") for p in positions if p.get("_org") == org}
            problems += [f"{org}:registry/positions.yaml: works: {pr}"
                         for pr in check_works(works, names, systems, units, statuses)]
            problems += [f"{org}: works: {pr}" for pr in loop_files(works, _org_paths(orgs_file).get(org) or [])]
    if deep:  # tool profiles (docs/tools.md; of_tools.check, of_tools's rules)
        try:
            import of_tools
            problems += [f"{pr.split(': ', 1)[0]}:registry/positions.yaml: {pr.split(': ', 1)[1]}" if ": " in pr else pr
                         for pr in of_tools.check(of_tools.registries(orgs_file))]
        except Exception as e:  # noqa: BLE001
            problems.append(f"tools: the check could not run ({type(e).__name__}: {e})")
    known = {org for org, _, _ in org_registries(orgs_file)}
    for p in positions:
        if p.get("serves") and p["serves"] not in known:
            problems.append(f"{p['_file']}: {p['name']}: serves {p['serves']!r} is not an organization in orgs.yaml")
    return positions, problems


def waiting_rank(w):
    """0 owner, 1 peer (a position name), 2 external:<who>, 3 not waiting; None if invalid."""
    if not w:
        return 3
    if not isinstance(w, str):
        return None
    if w == "owner":
        return 0
    if w.startswith("external:") and len(w) > len("external:"):
        return 2
    return 1 if NAME_RE.match(w) else None


MANAGEMENT_FUNCTIONS = ("strategy", "goals", "operations", "administration", "corporate_governance",
                        "corporate_finance", "management_accounting", "marketing", "hr", "leadership", "org_change",
                        "asset_management", "community", "productization")


def check_mandate_fields(p):
    """response_window, mandate_exit {done_when, review}, mandate_functions (docs/registry.md)."""
    import datetime as dt
    out = []
    rw = p.get("response_window")
    if rw is not None and not (isinstance(rw, int) and not isinstance(rw, bool) and rw > 0):
        out.append(f"response_window {rw!r} must be a positive number of minutes")
    ex = p.get("mandate_exit")
    if ex is not None:
        if not isinstance(ex, dict) or not isinstance(ex.get("done_when"), str) or not ex["done_when"].strip():
            out.append("mandate_exit must be a mapping with done_when: \"<checkable criteria>\" (and optional review)")
        else:
            extra = set(ex) - {"done_when", "review"}
            if extra:
                out.append(f"mandate_exit: unknown key(s) {', '.join(sorted(extra))}")
            rv = ex.get("review")
            if rv is not None:
                try:
                    dt.date.fromisoformat(str(rv))
                except ValueError:
                    out.append(f"mandate_exit.review {rv!r} must be a date YYYY-MM-DD")
    fn = p.get("mandate_functions")
    if fn is not None:
        if not isinstance(fn, list):
            out.append("mandate_functions must be a list")
        else:
            out += [f"mandate_functions: {f!r} is not one of {', '.join(MANAGEMENT_FUNCTIONS)}"
                    for f in fn if f not in MANAGEMENT_FUNCTIONS]
    return out


STRING_FIELDS = ("name", "system", "role", "kind", "owner", "summary", "status", "waiting_on", "note",
                 "mandate", "throughput", "serves")


def yaml_traps(p, path=""):
    """Typical YAML slips: a sentence parsed as a key with a null value, a mapping or
    list where a string belongs, aliases that are not a list of strings."""
    out = []
    if not path:
        for k in STRING_FIELDS:
            v = p.get(k)
            if v is not None and not isinstance(v, str):
                out.append(f"{k} must be a string, got {type(v).__name__}: {v!r}"[:200])
        al = p.get("aliases")
        if al is not None and (not isinstance(al, list) or not all(isinstance(x, (str, int)) for x in al)):
            out.append(f"aliases must be a list of strings: {al!r}"[:200])
    for k, v in p.items():
        here = f"{path}{k}"
        if v is None and isinstance(k, str) and (" " in k or len(k) > 40):
            out.append(f"key {here!r} has no value: probably a sentence that needs `note: ...` or quotes"[:200])
        elif isinstance(v, dict):
            out.extend(yaml_traps(v, here + "."))
    return out


# ------------------------------------------------------------- glob logic
# Path patterns: `**` crosses directories, `*` and `?` stay within one, `[...]` is a class.

def _glob_tokens(p):
    toks, i = [], 0
    while i < len(p):
        if p.startswith("**", i):
            toks.append(("**",))
            i += 2
        elif p[i] == "*":
            toks.append(("*",))
            i += 1
        elif p[i] == "?":
            toks.append(("?",))
            i += 1
        elif p[i] == "[" and "]" in p[i + 1:]:
            j = p.index("]", i + 1)
            toks.append(("[", p[i + 1:j]))
            i = j + 1
        else:
            toks.append(("c", p[i]))
            i += 1
    return toks


def glob_regex(p):
    out = []
    for t in _glob_tokens(p):
        out.append({"**": ".*", "*": "[^/]*", "?": "[^/]"}.get(t[0]) if t[0] in ("**", "*", "?")
                   else (f"[{t[1]}]" if t[0] == "[" else re.escape(t[1])))
    return re.compile("^" + "".join(out) + "$")


def _class_chars(t):
    """A finite set of characters a token can produce, or None for 'any but /'."""
    if t[0] == "c":
        return {t[1]}
    if t[0] == "[":
        body, chars, i = t[1], set(), 0
        if body.startswith(("!", "^")):
            return None  # negated class: treat as any but /, conservatively
        while i < len(body):
            if i + 2 < len(body) and body[i + 1] == "-":
                chars.update(chr(c) for c in range(ord(body[i]), ord(body[i + 2]) + 1))
                i += 3
            else:
                chars.add(body[i])
                i += 1
        return chars
    return None  # "?"


def _chars_meet(x, y):
    cx, cy = _class_chars(x), _class_chars(y)
    if cx is None and cy is None:
        return True
    if cx is None:
        return any(c != "/" for c in cy)
    if cy is None:
        return any(c != "/" for c in cx)
    return bool(cx & cy)


def globs_intersect(a, b):
    """Can one path match both patterns? Exact for literals, ?, *, ** and simple classes."""
    A, B = _glob_tokens(a), _glob_tokens(b)
    star = ("*", "**")
    seen, stack = set(), [(0, 0)]
    while stack:
        i, j = stack.pop()
        if (i, j) in seen:
            continue
        seen.add((i, j))
        if i == len(A) and j == len(B):
            return True
        nxt = []
        if i < len(A) and A[i][0] in star:
            nxt.append((i + 1, j))                       # A's star matches nothing more
            if j < len(B) and B[j][0] not in star:       # A's star eats B's next character
                if A[i][0] == "**" or _class_chars(B[j]) is None or any(c != "/" for c in _class_chars(B[j])):
                    nxt.append((i, j + 1))
        if j < len(B) and B[j][0] in star:
            nxt.append((i, j + 1))
            if i < len(A) and A[i][0] not in star:
                if B[j][0] == "**" or _class_chars(A[i]) is None or any(c != "/" for c in _class_chars(A[i])):
                    nxt.append((i + 1, j))
        if i < len(A) and j < len(B) and A[i][0] not in star and B[j][0] not in star and _chars_meet(A[i], B[j]):
            nxt.append((i + 1, j + 1))
        stack.extend(nxt)
    return False


TREE_REF = {"ref": "local"}  # `of registry check --ref remote|local`; remote = the GitHub default branch


REMOTE_FILES_TTL_S = 900  # 2026-11-11: 23 repositories by `gh api` took 80 s of every registry check


def _remote_files(d):
    """Files on the GitHub default branch of a local clone's origin, read-only through `gh api`
    (no fetch, nothing written to the other position's repository, no SSH). None if unavailable.
    Kept for REMOTE_FILES_TTL_S in the state folder, so checks in a row ask GitHub once."""
    r = subprocess.run(["git", "-C", d, "remote", "get-url", "origin"], capture_output=True, text=True, timeout=10)
    m = re.search(r"github\.com[:/]([^/]+/[^/]+?)(?:\.git)?$", r.stdout.strip()) if r.returncode == 0 else None
    if not m:
        return None
    import hashlib
    import of_events
    cache_file = os.path.join(of_events.STATE_DIR, "tree-cache", hashlib.sha1(m.group(1).encode()).hexdigest() + ".json")
    try:
        if __import__("time").time() - os.path.getmtime(cache_file) < REMOTE_FILES_TTL_S:
            with open(cache_file) as fh:
                return json.load(fh)
    except (OSError, ValueError):
        pass
    files = _remote_files_fetch(m.group(1))
    if files is not None:
        try:
            os.makedirs(os.path.dirname(cache_file), mode=0o700, exist_ok=True)
            with open(cache_file, "w") as fh:
                json.dump(files, fh)
        except OSError:
            pass
    return files


def _remote_files_fetch(slug):
    m = re.match(r"(.*)", slug)
    try:
        b = subprocess.run(["gh", "api", f"repos/{m.group(1)}", "--jq", ".default_branch"],
                           capture_output=True, text=True, timeout=30)
        if b.returncode != 0 or not b.stdout.strip():
            return None
        t = subprocess.run(["gh", "api", f"repos/{m.group(1)}/git/trees/{b.stdout.strip()}?recursive=1"],
                           capture_output=True, text=True, timeout=120)
        tree = json.loads(t.stdout) if t.returncode == 0 else None
    except (subprocess.SubprocessError, OSError, ValueError):
        return None
    if not tree or tree.get("truncated"):
        return None
    return [x["path"] for x in tree.get("tree") or [] if x.get("type") == "blob"]


def _repo_files(roots, repo, cache):
    """Tracked files of a local repository, relative to its parent root, or None if not local.
    With TREE_REF remote, the files on GitHub's default branch (a local clone may be days old),
    falling back to the local index when GitHub is not reachable."""
    if repo in cache:
        return cache[repo]
    cache[repo] = None
    for root in roots:
        d = os.path.join(os.path.expanduser(root), repo)
        if os.path.isdir(os.path.join(d, ".git")) or os.path.isfile(os.path.join(d, ".git")):
            files = _remote_files(d) if TREE_REF["ref"] == "remote" else None
            if files is None:
                r = subprocess.run(["git", "-C", d, "ls-files", "-z"], capture_output=True, timeout=60)
                if r.returncode == 0:
                    files = [x for x in r.stdout.decode("utf-8", "replace").split("\0") if x]
            if files is not None:
                cache[repo] = [f"{repo}/{x}" for x in files]
            break
    return cache[repo]


def path_conflicts(claims, roots=(), parents=None):
    """claims: [(system, pattern)]. Two systems conflict when one path can be theirs both:
    checked against the real files when the repository is local, else by pattern intersection. A subsystem shares
    its paths with its ancestors by design (RFC 0007): such pairs are never compared. `parents`: {system: parent}.
    Each pattern is matched against its repository's files once, and pairs compare the matched sets (2026-11-11:
    with storefront's subsystems every intersecting pair re-scanned the repository, and the check took 2.5 minutes)."""
    out, cache, matched = [], {}, {}
    parents = parents or {}

    def ancestors(sid):
        seen = set()
        while sid in parents and parents[sid] and parents[sid] not in seen:
            sid = parents[sid]
            seen.add(sid)
        return seen

    def repo_of(pat):
        return pat.split("/", 1)[0] if "/" in pat and not any(c in pat.split("/", 1)[0] for c in "*?[") else None

    def files_of(pat):
        if pat not in matched:
            repo = repo_of(pat)
            files = _repo_files(roots, repo, cache) if repo and roots else None
            if files is None:
                matched[pat] = None
            else:
                rx = glob_regex(pat)
                matched[pat] = frozenset(f for f in files if rx.match(f))
        return matched[pat]
    for sid, pat in claims:  # a pattern that matches no tracked file is a stale or mistyped claim
        got = files_of(pat)
        if got is not None and not got:
            out.append(f"{sid} ({pat}) matches no tracked file in {repo_of(pat)}")
    family = {sid: ancestors(sid) for sid, _ in claims}
    for x in range(len(claims)):
        for y in range(x + 1, len(claims)):
            (s1, p1), (s2, p2) = claims[x], claims[y]
            if s1 == s2 or s1 in family[s2] or s2 in family[s1] or not globs_intersect(p1, p2):
                continue
            f1, f2 = files_of(p1), files_of(p2)
            if f1 is not None and f2 is not None:
                both = sorted(f1 & f2)
                if both:
                    out.append(f"{s1} ({p1}) and {s2} ({p2}) both claim {len(both)} file(s), e.g. {both[0]}")
            elif f1 is None and f2 is None:
                out.append(f"{s1} ({p1}) and {s2} ({p2}) can claim the same path")
            else:
                known = f1 if f1 is not None else f2
                other = p2 if f1 is not None else p1
                rx = glob_regex(other)
                both = sorted(f for f in known if rx.match(f))
                if both:
                    out.append(f"{s1} ({p1}) and {s2} ({p2}) both claim {len(both)} file(s), e.g. {both[0]}")
    return out


def unit_of(system, units):
    """The id of the unit whose `systems` list this system, or None."""
    for uid, u in (units or {}).items():
        if isinstance(u, dict) and system in (u.get("systems") or []):
            return uid
    return None


def check_units(units, position_names, systems):
    """units: {id: {name, owner, systems}} (docs/registry.md): ids, owners, each system in at most one unit."""
    if not isinstance(units, dict):
        return ["must be a mapping of unit id to its description"]
    out, home = [], {}
    for uid, u in units.items():
        if not SYSTEM_ID.match(str(uid)):
            out.append(f"{uid!r}: invalid unit id (must match {SYSTEM_ID.pattern})")
        if not isinstance(u, dict):
            out.append(f"{uid}: must be a mapping")
            continue
        if u.get("owner") is None or u["owner"] not in position_names:
            out.append(f"{uid}: owner {u.get('owner')!r} is not a position of this organization")
        if not isinstance(u.get("systems"), list) or not u["systems"]:
            out.append(f"{uid}: systems must be a non-empty list")
            continue
        for sid in u["systems"]:
            if systems and sid not in systems:
                out.append(f"{uid}: system {sid!r} is not in the systems map")
            if sid in home and home[sid] != uid:
                out.append(f"system {sid!r} is in two units: {home[sid]} and {uid}")
            home.setdefault(sid, uid)
    return out


def duplicate_keys(text):
    """[(line, key)] for a key repeated in one mapping: YAML keeps the last silently, so a hand edit
    that adds a field twice goes unseen. Checked by of registry check."""
    import yaml as _y

    class L(_y.SafeLoader):
        pass
    found = []

    def mapping(loader, node, deep=False):
        seen = set()
        for k, _ in node.value:
            key = loader.construct_object(k, deep=deep)
            if key in seen:
                found.append((k.start_mark.line + 1, key))
            seen.add(key)
        return _y.SafeLoader.construct_mapping(loader, node, deep)
    L.add_constructor(_y.resolver.BaseResolver.DEFAULT_MAPPING_TAG, mapping)
    try:
        _y.load(text, Loader=L)
    except _y.YAMLError:
        pass
    return found


def comment_cuts(text):
    """[(line, key, kept, comment, is_cut)] for a comment right after an unquoted value. YAML ends such a value at
    ' #', so 'Refunds work, RFC #2338.' reads 'Refunds work, RFC' and the file still parses (acme_org, 2026-11-08). One
    space before the hash and a word after it is a cut (is_cut, a problem); one space and a space after is either,
    a warning. A comment written the usual way, two spaces before the hash, is left alone. The ends come from the
    parser's own marks, so a quoted value or a hash inside a word is never reported."""
    import yaml as _y
    try:
        root = _y.compose(text, Loader=_y.SafeLoader)
    except _y.YAMLError:
        return []
    lines, found = text.splitlines(), []
    stack = [(root, "")] if root is not None else []
    while stack:
        n, key = stack.pop()
        if isinstance(n, _y.MappingNode):
            stack += [x for k, v in n.value for x in ((k, key), (v, k.value if isinstance(k, _y.ScalarNode) else key))]
        elif isinstance(n, _y.SequenceNode):
            stack += [(v, key) for v in n.value]
        elif isinstance(n, _y.ScalarNode) and n.style is None and n.end_mark.line < len(lines):
            m = re.match(r"([ \t]+)#(.*)", lines[n.end_mark.line][n.end_mark.column:])
            if m and len(m.group(1)) == 1:
                found.append((n.end_mark.line + 1, key, n.value, "#" + m.group(2), m.group(2)[:1] not in ("", " ")))
    return sorted(found)


def check_delegations(dels, position_names, units):
    """delegations: [{id, unit, from_owner, to_owner, envelope, reporting: {escalate_when}, way_back}]."""
    out = []
    for i, x in enumerate(dels):
        if not isinstance(x, dict):
            out.append(f"[{i}] must be a mapping")
            continue
        tag = x.get("id") or f"[{i}]"
        if x.get("unit") not in units:
            out.append(f"{tag}: unit {x.get('unit')!r} is not in units:")
        for k in ("from_owner", "to_owner"):
            if x.get(k) not in position_names:
                out.append(f"{tag}: {k} {x.get(k)!r} is not a position of this organization")
        if not isinstance(x.get("envelope"), dict):
            out.append(f"{tag}: envelope must be a mapping")
        esc = (x.get("reporting") or {}).get("escalate_when")
        if not esc:
            out.append(f"{tag}: reporting.escalate_when is required")
        else:
            import of_classify
            out += [f"{tag}: escalate_when {e!r} is not understood" for e in esc if not of_classify.ESCALATE.match(str(e).strip())]
        ra = (x.get("envelope") or {}).get("risk_appetite") if isinstance(x.get("envelope"), dict) else None
        if ra is not None and ra not in ("low", "medium", "high"):
            out.append(f"{tag}: envelope.risk_appetite {ra!r} is not one of low, medium, high")
    return out


WORK_KINDS = ("rfc", "project", "incident", "window", "migration")
WORK_STATES = ("done", "parked")  # set by the structure keeper; every other state is derived (docs/works.md §3)
WORK_ID = re.compile(r"^[a-z0-9][a-z0-9._-]{1,63}$")


WARN = "warning: "  # a check line that reports without failing `of registry check`


def doc_path(doc, roots):
    """The local file of a work's doc ('<repo>:<path> (note)') under the organization's paths, or None."""
    m = re.match(r"^([\w./-]+):(\S+)", str(doc or ""))
    if not m:
        return None
    repo, rel = m.group(1), m.group(2)
    for root in roots:
        r = os.path.expanduser(str(root))
        for base in (r if os.path.basename(r.rstrip("/")) == repo.rpartition("/")[2] else None,
                     os.path.join(r, repo.rpartition("/")[2]), os.path.join(os.path.dirname(r), repo.rpartition("/")[2])):
            if base and os.path.isfile(os.path.join(base, rel)):
                return os.path.join(base, rel)
    return None


def loop_files(works, roots):
    """A `loop.yaml` beside a work's doc (RFC 0005 §4) is checked like a `loop:` in the registry; a work with both is a
    problem (one place per loop)."""
    import of_loop
    out = []
    for wid, w in (works or {}).items():
        if not isinstance(w, dict) or not w.get("doc"):
            continue
        dp = doc_path(w["doc"], roots)
        ly = os.path.join(os.path.dirname(dp), "loop.yaml") if dp else None
        if not ly or not os.path.isfile(ly):
            continue
        if "loop" in w:
            out.append(f"{wid}: loop is both in the registry and in {ly.replace(os.path.expanduser('~'), '~')}: keep one")
            continue
        try:
            with open(ly) as fh:
                doc = yaml.safe_load(fh) or {}
        except (OSError, yaml.YAMLError) as e:
            out.append(f"{wid}: {ly}: unreadable ({type(e).__name__})")
            continue
        out += of_loop.check_loop(doc.get("loop", doc), wid, WARN)
    return out


def work_loop(org, wid, orgs_file=None):
    """(the work's entry, its loop) from the registry, or from the loop.yaml beside its doc; (None, None) if unknown."""
    regs = {o: p for o, p, _ in org_registries(orgs_file or ORGS_FILE)}
    if org not in regs:
        return None, None
    with open(regs[org]) as fh:
        w = ((yaml.safe_load(fh) or {}).get("works") or {}).get(wid)
    if not isinstance(w, dict):
        return None, None
    if "loop" in w:
        return w, w["loop"]
    dp = doc_path(w.get("doc"), _org_paths(orgs_file or ORGS_FILE).get(org) or [])
    ly = os.path.join(os.path.dirname(dp), "loop.yaml") if dp else None
    if ly and os.path.isfile(ly):
        with open(ly) as fh:
            doc = yaml.safe_load(fh) or {}
        return w, doc.get("loop", doc)
    return w, None


def check_works(works, position_names, systems, units=None, statuses=None):
    """works: {id: {title, kind, doc, systems, owner, doers, stages, done_when, due, review, state, match}}
    (docs/registry.md, Works). Doers and owners are positions of this organization or people outside the
    registry written external:<name>; an omitted owner is the unit owner of the work's systems."""
    out = []
    if not isinstance(works, dict):
        return ["works: must be a mapping of work id -> work"]

    def who(x):
        return isinstance(x, str) and (x in position_names or re.match(r"^external:[A-Za-z0-9_.-]{1,64}$", x))
    for wid, w in works.items():
        tag = str(wid)
        if not WORK_ID.match(tag):
            out.append(f"{tag}: the id must match {WORK_ID.pattern}")
        if not isinstance(w, dict):
            out.append(f"{tag}: must be a mapping")
            continue
        if "loop" in w:  # a development loop (RFC 0005 §4): someone owns it and someone does it (4b5a274)
            import of_loop
            out += of_loop.check_loop(w["loop"], tag, WARN)
            if not w.get("owner"):
                out.append(f"{tag}: a work with a loop needs an owner")
            if not w.get("doers"):
                out.append(f"{tag}: a work with a loop needs doers")
        if not w.get("title"):
            out.append(f"{tag}: title is required")
        if w.get("kind") not in WORK_KINDS:
            out.append(f"{tag}: kind {w.get('kind')!r} is not one of {', '.join(WORK_KINDS)}")
        for s_ in w.get("systems") or []:
            if systems and s_ not in systems:
                out.append(f"{tag}: system {s_!r} is not in the systems map")
        if w.get("owner") is not None and not who(w["owner"]):
            out.append(f"{tag}: owner {w['owner']!r} is not a position here or external:<name>")
        doers = w.get("doers") or []
        if not isinstance(doers, list):
            out.append(f"{tag}: doers must be a list")
        else:
            out += [f"{tag}: doer {d!r} is not a position here or external:<name>" for d in doers if not who(d)]
            out += [f"{WARN}{tag}: doer {d} is {(statuses or {}).get(d)}: the work has lost its doer"
                    for d in doers if (statuses or {}).get(d) in ("parked", "finished", "done", "closed")
                    and w.get("state") not in WORK_STATES]  # a work set done or parked needs no doer (acme_org)
        if units and w.get("owner") is None:  # the unit owner is the default only when the systems sit in one unit
            live = [s_ for s_ in w.get("systems") or [] if ((systems or {}).get(s_) or {}).get("lifecycle", "live") == "live"]
            # only live systems ask for an owner (docs/registry.md, lifecycle): a retired one in another unit does not
            in_units = {u for u, x in units.items() for s_ in live if s_ in ((x or {}).get("systems") or [])}
            if len(in_units) > 1:
                out.append(f"{tag}: its systems span units {', '.join(sorted(in_units))}: owner is required")
        if w.get("state") is not None and w["state"] not in WORK_STATES:
            out.append(f"{tag}: state {w['state']!r}: only {', '.join(WORK_STATES)} are set by hand; the rest is derived")
        for k in ("due", "review"):
            if w.get(k) is not None and not re.match(r"^\d{4}-\d{2}-\d{2}", str(w[k])):
                out.append(f"{tag}: {k} {w[k]!r} is not a date (YYYY-MM-DD)")
        stages, seen = w.get("stages") or [], set()
        if not isinstance(stages, list):
            out.append(f"{tag}: stages must be a list")
            stages = []
        for i, st in enumerate(stages):
            if not isinstance(st, dict) or not st.get("id"):
                out.append(f"{tag}: stages[{i}] needs an id (the token PRs and branches use: t7, p2, part-1)")
                continue
            if st["id"] in seen:
                out.append(f"{tag}: stage id {st['id']!r} appears twice")
            seen.add(st["id"])
            if st.get("state", "open") not in ("done", "open"):
                out.append(f"{tag}: stage {st['id']}: state {st.get('state')!r} is not done or open")
            if not st.get("done_when"):
                out.append(f"{tag}: stage {st['id']}: done_when is required")
        m = w.get("match") or {}
        if not isinstance(m, dict):
            out.append(f"{tag}: match must be a mapping")
        else:
            if any(not isinstance(x, int) for x in m.get("prs") or []):
                out.append(f"{tag}: match.prs are PR numbers")
            for k in ("branches", "paths", "tags"):
                if not isinstance(m.get(k) or [], list):
                    out.append(f"{tag}: match.{k} must be a list")
            for k in ("branches", "paths"):  # a glob, or '<repo>:<glob>' with both parts
                for g in m.get(k) or [] if isinstance(m.get(k) or [], list) else []:
                    r_, sep, glob = str(g).partition(":")
                    if not isinstance(g, str) or not (glob if sep else r_) or (sep and not r_):
                        out.append(f"{tag}: match.{k} {g!r} is not a glob or <repo>:<glob>")
    return out


SYSTEM_KINDS = ("target", "enabling", "creating")
SYSTEM_LIFECYCLES = ("live", "unsupported", "retired")  # docs/registry.md (5523cb6); absent means live
EDGE_KINDS = ("uses", "interacts", "enabled_by")
EDGE_BASES = ("cochange", "runtime", "both")
SYSTEM_ID = re.compile(r"^[a-z][a-z0-9_-]{0,31}$")


def _strings(v):
    """A string or a list of strings (evidence on edges and on personal_data)."""
    return isinstance(v, str) or (isinstance(v, list) and all(isinstance(x, str) for x in v))


def check_personal_data(sid, pd):
    """docs/registry.md, Systems map (324b090): personal_data is {whose, where, evidence?}; whose and where are
    non-empty strings, evidence a string or a list of strings."""
    if pd is None:
        return []
    if not isinstance(pd, dict):
        return [f"{sid}: personal_data must be a mapping with whose, where and evidence"]
    out = [f"{sid}: personal_data.{k} must be a non-empty string" for k in ("whose", "where")
           if not (isinstance(pd.get(k), str) and pd[k].strip())]
    if pd.get("evidence") is not None and not _strings(pd["evidence"]):
        out.append(f"{sid}: personal_data.evidence must be a string or a list of strings")
    return out


def check_systems(systems, position_names, roots=()):
    """The systems map (docs/registry.md): ids, kinds, parents, keepers, edges, path ownership."""
    if systems is None:
        return []
    if not isinstance(systems, dict):
        return ["must be a mapping of system id to its description"]
    out, owner_of_path, repo_only = [], {}, {}
    for sid, sysd in systems.items():
        head, dot, tail = str(sid).rpartition(".")
        if dot:  # RFC 0007: a subsystem is <parent>.<name>, with parent set to the part before the last dot
            if not (SYSTEM_ID.match(tail) and isinstance(sysd, dict) and sysd.get("parent") == head):
                out.append(f"{sid!r}: invalid system id (a dotted id names a subsystem: <parent>.<name>, with "
                           f"parent: {head})")
        elif not SYSTEM_ID.match(str(sid)):
            out.append(f"{sid!r}: invalid system id (must match {SYSTEM_ID.pattern})")
        if not isinstance(sysd, dict):
            out.append(f"{sid}: must be a mapping")
            continue
        if sysd.get("kind") is not None and sysd["kind"] not in SYSTEM_KINDS:
            out.append(f"{sid}: kind {sysd['kind']!r} is not one of {', '.join(SYSTEM_KINDS)}")
        if sysd.get("lifecycle") is not None and sysd["lifecycle"] not in SYSTEM_LIFECYCLES:
            out.append(f"{sid}: lifecycle {sysd['lifecycle']!r} is not one of {', '.join(SYSTEM_LIFECYCLES)}")
        if sysd.get("parent") is not None and sysd["parent"] not in systems:
            out.append(f"{sid}: parent {sysd['parent']!r} is not a system")
        if sysd.get("keeper") is not None and sysd["keeper"] not in position_names:
            out.append(f"{sid}: keeper {sysd['keeper']!r} is not a position of this organization")
        cf = sysd.get("confirm")
        if cf is not None and cf is not True and not (
                isinstance(cf, list) and cf and all(x in ("keeper", "boundary", "live") for x in cf)):
            out.append(f"{sid}: confirm must be true or a list of keeper, boundary, live")
        g = sysd.get("governed_by")
        if g is not None and g != "self" and not (isinstance(g, str) and g.startswith("external:") and len(g) > 9):
            out.append(f"{sid}: governed_by {g!r} must be self or external:<who>")
        for e in sysd.get("depends_on") or []:
            if not isinstance(e, dict) or e.get("system") not in systems:
                out.append(f"{sid}: depends_on target {e.get('system') if isinstance(e, dict) else e!r} is not a system")
            elif e.get("kind") is not None and e["kind"] not in EDGE_KINDS:
                out.append(f"{sid}: edge to {e['system']}: kind {e['kind']!r} is not one of {', '.join(EDGE_KINDS)}")
            elif e.get("system") == sid:
                out.append(f"{sid}: depends on itself")
            elif e.get("observed_by") is not None and e["observed_by"] not in EDGE_BASES:
                out.append(f"{sid}: edge to {e['system']}: observed_by {e['observed_by']!r} is not one of "
                           f"{', '.join(EDGE_BASES)}")
            elif e.get("evidence") is not None and not _strings(e["evidence"]):
                out.append(f"{sid}: edge to {e['system']}: evidence must be a string or a list of strings")
        out += check_personal_data(sid, sysd.get("personal_data"))
        for path in sysd.get("paths") or []:
            owner_of_path.setdefault(sid, []).append(str(path))
        if sysd.get("repos") and not sysd.get("paths"):
            for repo in sysd["repos"]:
                repo_only.setdefault(repo, []).append(sid)
    out += path_conflicts([(sid, p) for sid, ps in owner_of_path.items() for p in ps], roots,
                          parents={k: v.get("parent") for k, v in systems.items() if isinstance(v, dict)})
    for repo, sids in repo_only.items():
        if len(sids) > 1:
            out.append(f"repository {repo!r} is claimed whole by {', '.join(sids)}; give each its paths")
    seen = set()
    for sid in systems:  # parent cycles
        chain, cur = [], sid
        while cur in systems and isinstance(systems[cur], dict) and systems[cur].get("parent") and cur not in chain:
            chain.append(cur)
            cur = systems[cur]["parent"]
        if cur in chain and sid not in seen:
            out.append(f"{sid}: parent chain has a cycle ({' -> '.join(chain + [cur])})")
            seen.update(chain)
    return out


ASK_REF = re.compile(r"^[0-9a-f]{8}$|^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")


PERSON_STATUSES = ("active", "left")


def check_people(doc, positions):
    """People (docs/registry.md "People", of_architect c2e24e8): ids, name, status and machines; every
    holder.person names a listed person; a human holder names one; a person who left holds no active position."""
    people = doc.get("people")
    out = []
    if people is not None and not isinstance(people, dict):
        return ["people: must map a person's id to {name, machines, status}"]
    people = people or {}
    for pid, pd in people.items():
        tag = f"people: {pid}"
        if not SYSTEM_ID.match(str(pid)):
            out.append(f"{tag}: invalid id (must match {SYSTEM_ID.pattern}; never an email)")
        if not isinstance(pd, dict):
            out.append(f"{tag}: must be a mapping")
            continue
        if not str(pd.get("name") or "").strip():
            out.append(f"{tag}: name is required")
        if pd.get("status", "active") not in PERSON_STATUSES:
            out.append(f"{tag}: status {pd.get('status')!r} is not one of {', '.join(PERSON_STATUSES)}")
        m = pd.get("machines")
        if m is not None and not (isinstance(m, list) and all(isinstance(x, str) and x for x in m)):
            out.append(f"{tag}: machines must be a list of machine ids")
    for p in positions:
        h = p.get("holder") or {}
        if not isinstance(h, dict):
            continue
        who = h.get("person")
        if h.get("runtime") == "human" and not who:
            out.append(f"positions: {p['name']}: a human holder names its person (holder.person)")
        if who is None:
            continue
        if who not in people:  # before the registry lists people at all: a warning, so today's registries pass
            out.append(f"{'' if people else WARN}positions: {p['name']}: holder.person {who!r} is not in people:")
        elif (people[who] or {}).get("status") == "left" and (p.get("status") or "active") == "active":
            out.append(f"positions: {p['name']}: held by {who}, who left; give it a new holder or close it")
    return out


def check_evidence(doc, positions):
    """docs/registry.md, People, "Who does what needs evidence" (of_architect e9c6b16; the founder, 2026-11-11: a
    paraphrase put a colleague on systems he does not keep). Warnings, so today's registries pass: a person-held claim
    with no `evidence:` beside it, in the same mapping (authorship with its window, or an ask id):
    - a position's `holder.person` (in `holder`);
    - a system whose `keeper` is a position held by a person, or whose `governed_by` is `external:<who>` (in the
      system's entry);
    - an `owns` entry of a position held by a person (in the entry);
    - a work whose `doers` name `external:<who>` (in the work's entry)."""
    out = []
    by = {p["name"]: p for p in positions if isinstance(p, dict) and p.get("name")}

    def person(name):
        h = (by.get(name) or {}).get("holder")
        return h.get("person") if isinstance(h, dict) else None

    def has(m):
        return isinstance(m, dict) and bool(str(m.get("evidence") or "").strip())

    hint = "add evidence: beside it (authorship with its window, or an ask id)"
    for name, p in by.items():
        h = p.get("holder")
        if isinstance(h, dict) and h.get("person") and not has(h):
            out.append(f"{WARN}positions: {name}: holder.person {h['person']!r} without evidence; {hint}")
        if person(name):
            for o in p.get("owns") or []:
                if isinstance(o, dict) and not has(o):
                    out.append(f"{WARN}positions: {name}: owns {o.get('system')}/{o.get('method')}: decided by "
                               f"{person(name)}'s position without evidence; {hint}")
    systems = doc.get("systems") if isinstance(doc.get("systems"), dict) else {}
    for sid, sd in systems.items():
        if not isinstance(sd, dict) or has(sd):
            continue
        k, g = sd.get("keeper"), sd.get("governed_by")
        if isinstance(k, str) and person(k):
            out.append(f"{WARN}systems: {sid}: keeper {k} is {person(k)}'s position, without evidence; {hint}")
        if isinstance(g, str) and g.startswith("external:"):
            out.append(f"{WARN}systems: {sid}: governed_by {g} without evidence; {hint}")
    works = doc.get("works") if isinstance(doc.get("works"), dict) else {}
    for wid, w in works.items():
        if not isinstance(w, dict) or has(w):
            continue
        ext = [d for d in (w.get("doers") or []) if isinstance(d, str) and d.startswith("external:")]
        if ext:
            out.append(f"{WARN}works: {wid}: doers {', '.join(ext)} without evidence; {hint}")
    return out


def check_provisional(doc, positions, grants=()):
    """docs/registry.md, Fields, `provisional` (of_architect 728ff7a; of_onboarding's package dbb8a77; the founder,
    2026-11-11): a position added before the structure was finished, on a yes the person typed in their conductor's
    pane. Problems: a `provisional` without all of asked, at, by and event; a kind other than project; any power
    beyond the defaults (credentials, its own tools, a grant, a delegation it owns, a unit it owns). A warning: one still
    provisional after its onboarding run's work (`<org>-onboarding`) is done."""
    out = []
    names = {p["name"] for p in positions if isinstance(p, dict) and p.get("name")}
    units = doc.get("units") if isinstance(doc.get("units"), dict) else {}
    dels = [x for x in doc.get("delegations") or [] if isinstance(x, dict)]
    works = doc.get("works") if isinstance(doc.get("works"), dict) else {}
    org = doc.get("organization")
    run = works.get(f"{org}-onboarding") if org else None
    run = run or next((w for wid, w in works.items() if str(wid).endswith("-onboarding") and isinstance(w, dict)), None)
    for p in positions:
        if not isinstance(p, dict) or "provisional" not in p:
            continue
        name, pv, tag = p.get("name"), p.get("provisional"), f"positions: {p.get('name')}: provisional"
        missing = [k for k in ("asked", "at", "by", "event") if not (isinstance(pv, dict) and str(pv.get(k) or "").strip())]
        if missing:
            out.append(f"{tag}: needs {', '.join(missing)} (the person's words, the time, their conductor, the "
                       "of.human_prompt event id of their yes)")
        if p.get("kind") != "project":
            out.append(f"{tag}: only a position of kind project may be provisional, not {p.get('kind')!r}")
        powers = []
        if p.get("credentials"):
            powers.append("credentials")
        if [t for t in p.get("tools") or [] if not str(t).startswith("-")]:
            powers.append("tools beyond the defaults")
        if any(isinstance(g, dict) and g.get("subject") == name and not g.get("revoked") for g in grants):
            powers.append("a grant")
        if any(x.get("to_owner") == name for x in dels):
            powers.append("a delegation")
        if any(isinstance(u, dict) and u.get("owner") == name for u in units.values()):
            powers.append("a unit")
        if powers:
            out.append(f"{tag}: holds {', '.join(powers)}; a provisional position holds none until the structure "
                       "keeper folds it into the structure by a diff")
        if isinstance(run, dict) and run.get("state") == "done":
            out.append(f"{WARN}{tag}: still provisional after the onboarding run's work is done; fold it into the "
                       "structure by a diff (kept, merged or finished)")
    return out


def check_cells(doc, positions):
    """RFC 0007 step 2 (of_architect, 2026-11-10), warnings only, so today's registries keep passing:
    - a governance fact with no owner's ask id under `confirmed:`: a system's `keeper`, a non-`self` `governed_by`,
      a non-default `lifecycle` (a retold "(founder, 2026-11-06)" confirmed "Dana keeps the Solana bots", which he
      says is false); a confirmed value that is not an ask id;
    - two positions deciding one cell (system or subsystem x kind of work) in `owns`;
    - an `owns` entry, or a system's `needs`, naming an unknown system or kind of work.
    The rules are of_model's (governance, cells_of), so this check and Studio's Systems and Cells pages agree
    (of_studio, 8b4230d). `positions`: the organization's position dicts."""
    import of_model
    systems = doc.get("systems") or {}
    if not isinstance(systems, dict):
        return []
    out = []
    if doc.get("methods") is not None and not isinstance(doc.get("methods"), dict):
        out.append(f"{WARN}methods: must be a mapping of kind id to its one-line definition")
    for k in (doc.get("methods") or {}) if isinstance(doc.get("methods"), dict) else []:
        if not SYSTEM_ID.match(str(k)):
            out.append(f"{WARN}methods: {k!r}: invalid kind id (must match {SYSTEM_ID.pattern})")
    methods = of_model.methods_of(doc)
    for sid, sd in systems.items():
        if not isinstance(sd, dict):
            continue
        conf = sd.get("confirmed")
        if conf is not None and not isinstance(conf, dict):
            out.append(f"{WARN}systems: {sid}: confirmed must map a fact ({', '.join(of_model.GOVERNANCE_FACTS)}) to "
                       "an ask id")
            continue
        for fact, ref in (conf or {}).items():
            if fact not in of_model.GOVERNANCE_FACTS:
                out.append(f"{WARN}systems: {sid}: confirmed.{fact}: not a governance fact "
                           f"({', '.join(of_model.GOVERNANCE_FACTS)})")
            elif not ASK_REF.match(str(ref or "")):
                out.append(f"{WARN}systems: {sid}: confirmed.{fact} {ref!r} is not an ask id")
        for g in of_model.governance(sd):
            if g["required"] and not g["ask"]:
                out.append(f"{WARN}systems: {sid}: {g['fact']} {g['value']!r} has no owner's ask id under confirmed: "
                           "(a comment with his name and a date confirms nothing; RFC 0007 §2.2)")
    owners = {}
    for p in positions:
        good = []
        for i, c in enumerate(p.get("owns") or []):
            if not isinstance(c, dict) or not c.get("system") or not c.get("method"):
                out.append(f"{WARN}positions: {p['name']}: owns[{i}]: must be {{system, method, decides}}")
                continue
            good.append({"system": str(c["system"]), "method": str(c["method"]), "decides": c.get("decides") is True})
        owners[p["name"]] = dict(p, owns=good, status=p.get("status") or "active")
    cells = of_model.cells_of(owners, {k: v for k, v in systems.items() if isinstance(v, dict)}, methods)
    for u in cells["unknown"]:
        where = f"positions: {u['position']}: owns" if u["position"] else f"systems: {u['system']}: needs"
        out.append(f"{WARN}{where} {u['system']} x {u['method']}: {u['why']} "
                   f"(kinds: {', '.join(methods)}; add one under methods:)")
    for r in cells["two_deciders"]:
        out.append(f"{WARN}cells: {r['system']} x {r['method']} has {len(r['deciders'])} deciders "
                   f"({', '.join(r['deciders'])}); at most one decides, the others are doers")
    return out


def session_of(p):
    return ((p.get("holder") or {}).get("session") or "").strip() or None


# ------------------------------------------------------------------- herdr

def herdr_json(*args):
    try:
        out = subprocess.run([HERDR, *args], capture_output=True, text=True, timeout=20)
    except FileNotFoundError:
        raise OfError(f"herdr not found ({HERDR})")
    if out.returncode != 0:
        raise OfError(f"herdr {' '.join(args)} failed: {(out.stderr or out.stdout).strip()}")
    return json.loads(out.stdout)["result"]


def herdr_do(args, dry_run):
    print(("would run: " if dry_run else "run: ") + " ".join(_quote(a) for a in [HERDR, *args]))
    if dry_run:
        return True
    import of_focus
    why = of_focus.block(args)
    if why:
        print(f"  held back: {why}; it runs when he has moved on", file=sys.stderr)
        return False
    out = subprocess.run([HERDR, *args], capture_output=True, text=True, timeout=20)
    if out.returncode != 0:
        print(f"  failed: {(out.stderr or out.stdout).strip()}", file=sys.stderr)
        return False
    return True


def _quote(a):
    return a if re.match(r"^[\w:./=@%+-]+$", a) else "'" + a.replace("'", "'\\''") + "'"


def live_agents():
    return herdr_json("agent", "list")["agents"]


def live_agents_or_none(warn=True):
    """herdr's agents and the agents in tmux or screen (bin/of_tmux.py, bin/of_screen.py: machines without herdr,
    docs/remote.md §3 row 5), for the commands that only read them or type through the relay (`of who`, the relay,
    routed asks). Without herdr, one warning: `of who` still lists the positions from the registries (lab-quickstart
    Q1). Commands that change herdr's panes (`of apply`, `of go`, views) keep live_agents(): a tmux or screen pane is
    never theirs."""
    import of_screen
    import of_tmux
    tmux = []
    for mod in (of_tmux, of_screen):
        try:
            tmux += mod.agents()
        except Exception:  # noqa: BLE001 - a broken report never hides herdr's agents
            pass
    try:
        return live_agents() + tmux
    except OfError as e:
        if warn:
            print(f"of: herdr unavailable ({e}); showing the registry" + (" and the agents in tmux or screen" if tmux else
                  " only") + ". Agents get names, states and the desk when they run in herdr panes (README).",
                  file=sys.stderr)
        return tmux


def agent_session(a):
    return ((a.get("agent_session") or {}).get("value")) or None


# ----------------------------------------------------------------- binding

def bind(positions, agents):
    """Return (pairs, unheld, unknown): bound (position, agent) pairs,
    positions without a live holder, live agents without a position."""
    by_session = {}
    for a in agents:
        s = agent_session(a)
        if s:
            by_session.setdefault(s, []).append(a)
    pairs, unheld, used = [], [], set()
    for p in positions:
        hits = by_session.get(session_of(p) or "", [])
        if len(hits) == 1:
            pairs.append((p, hits[0]))
            used.add(hits[0]["pane_id"])
        else:
            unheld.append(p)
    # A position with no session yet binds to a live agent started under its canonical
    # name (`claude -n <name>`); `of apply` reports it for the owner to confirm.
    still = []
    for p in unheld:
        if session_of(p):
            still.append(p)
            continue
        hits = [a for a in agents if a["pane_id"] not in used
                and p["name"] in (a.get("name"), a.get("terminal_title_stripped"))]
        if len(hits) == 1:
            pairs.append((p, hits[0]))
            used.add(hits[0]["pane_id"])
            p["_bound_by_name"] = agent_session(hits[0])
        else:
            still.append(p)
    unheld = still
    unknown = [a for a in agents if a["pane_id"] not in used]
    return pairs, unheld, unknown


# ------------------------------------------------------------------- apply

def plan_apply(positions, agents, tabs, workspaces, labels=None):
    """Return (commands, notes). Pure: no herdr calls. `labels` maps pane id to its label."""
    labels = labels or {}
    desk_ws = {w["workspace_id"] for w in workspaces if w.get("label") == DESK}
    pairs, unheld, unknown = bind(positions, agents)
    held = [(p, a) for p, a in pairs if p.get("_org") in HELD]
    pairs = [(p, a) for p, a in pairs if p.get("_org") not in HELD]
    cmds, notes = [], []
    for p, a in held:
        notes.append(f"on hold: {p['name']} (pane {a['pane_id']}), organization {p['_org']} is on hold in orgs.yaml")
    live_names = {a.get("name"): a for a in agents if a.get("name")}

    for p, a in pairs:
        pane = a["pane_id"]
        if p.get("_bound_by_name"):
            notes.append(f"bound by name: {p['name']} -> pane {pane}, session {p['_bound_by_name']}; "
                         f"confirm by writing holder.session in {p['_file']}")
        if a.get("name") != p["name"]:
            other = live_names.get(p["name"])
            if other and other["pane_id"] != pane:
                notes.append(f"{p['name']}: name is taken by pane {other['pane_id']}; not renamed")
            else:
                cmds.append(["agent", "rename", pane, p["name"]])
        if base_label(labels.get(pane) or "") != pane_label(p["name"]):
            cmds.append(["pane", "rename", pane, pane_label(p["name"])])
        want = {k: str(p[k]) for k in TOKENS if p.get(k) not in (None, "")}
        have = {k: v for k, v in (a.get("tokens") or {}).items() if k in TOKENS}
        if want != have:
            args = ["pane", "report-metadata", pane, "--source", SOURCE]
            for k in TOKENS:
                if k in want:
                    args += ["--token", f"{k}={want[k]}"]
                elif k in have:
                    args += ["--clear-token", k]
            cmds.append(args)

    # A tab that holds one bound agent is labelled with its role (not on the desk, not a pinned view).
    import of_views
    pinned = of_views.pinned_positions()
    tab_by_id = {t["tab_id"]: t for t in tabs}
    for p, a in pairs:
        if p["name"] in pinned:
            continue
        t = tab_by_id.get(a.get("tab_id"))
        if p.get("_unit"):
            continue  # a unit's tabs are its systems (plan_layout)
        if t and a["workspace_id"] not in desk_ws and t.get("pane_count") == 1 and p.get("role") and base_label(t.get("label")) != p["role"]:
            cmds.append(["tab", "rename", t["tab_id"], p["role"]])

    # A workspace is an organization: one whose agents all belong to one organization
    # is labelled with that organization's workspace label (orgs.yaml). The desk is left alone.
    bound_ws = {}
    for p, a in pairs:
        if p["name"] in pinned:
            continue  # a view's tab may hold several organizations' agents; it labels nothing
        bound_ws.setdefault(a["workspace_id"], set()).add(want_workspace(p))
    unknown_ws = {a["workspace_id"] for a in unknown}
    for w in workspaces:
        wid = w["workspace_id"]
        orgs = bound_ws.get(wid)
        if wid in desk_ws or not orgs or len(orgs) != 1 or wid in unknown_ws:
            continue
        want = next(iter(orgs))
        if want and w.get("label") != want:
            cmds.append(["workspace", "rename", wid, want])

    for p in unheld:
        s = session_of(p)
        taken = live_names.get(p["name"])
        hint = f"; a live agent at {taken['pane_id']} has this name (session {agent_session(taken)})" if taken else ""
        notes.append(f"no live holder: {p['name']} (session {s or 'not set'}){hint}")
    for a in unknown:
        notes.append(f"no position: pane {a['pane_id']} name={a.get('name') or '-'} "
                     f"agent={a.get('agent')} session={agent_session(a) or '-'} cwd={a.get('cwd')}")
    return cmds, notes


def want_workspace(p):
    """A position's workspace label: `<org short>·<unit>` when its system is in a unit, else the organization's."""
    if p.get("_unit"):
        return f"{ORG_SHORT.get(p.get('_org')) or p.get('_workspace')}·{p['_unit']}"
    return p.get("_workspace")


LAYOUT_DEFAULTS = {"max_per_tab": 4, "three": "left+2"}  # ~/.config/of/layout.yaml
STATE_ORDER = {"blocked": 0, "working": 1, "done": 2, "idle": 3, "unknown": 4}


def layout_config(path=None):
    cfg = dict(LAYOUT_DEFAULTS)
    path = path or os.path.join(os.path.dirname(ORGS_FILE), "layout.yaml")
    try:
        with open(path) as fh:
            cfg.update({k: v for k, v in (yaml.safe_load(fh) or {}).items() if k in LAYOUT_DEFAULTS})
    except FileNotFoundError:
        pass
    cfg["max_per_tab"] = max(1, min(4, int(cfg["max_per_tab"])))
    return cfg


def tab_label(system, i):
    return system if i == 0 else f"{system}·{i + 1}"


def expected_rects(n, area, three="left+2"):
    """The balanced layout of n (1..4) panes in `area` {x, y, width, height}: [(x, y, w, h)]."""
    x, y, w, h = area["x"], area["y"], area["width"], area["height"]
    hw, hh = w / 2, h / 2
    if n == 1:
        return [(x, y, w, h)]
    if n == 2:
        return [(x, y, hw, h), (x + hw, y, hw, h)]
    if n == 3 and three == "columns":
        return [(x + i * w / 3, y, w / 3, h) for i in range(3)]
    if n == 3:
        return [(x, y, hw, h), (x + hw, y, hw, hh), (x + hw, y + hh, hw, hh)]
    return [(x, y, hw, hh), (x + hw, y, hw, hh), (x, y + hh, hw, hh), (x + hw, y + hh, hw, hh)]


def balanced(layout, panes, three="left+2", tol=2):
    """Does this tab's layout (herdr pane layout) hold exactly `panes`, in the balanced shape and order?"""
    if not layout:
        return False
    got = {p["pane_id"]: p["rect"] for p in layout.get("panes") or []}
    if set(got) != set(panes):
        return False
    want = sorted(expected_rects(len(panes), layout["area"], three))
    have = sorted((r["x"], r["y"], r["width"], r["height"]) for r in got.values())
    return all(abs(a - b) <= tol for w_, h_ in zip(want, have) for a, b in zip(w_, h_))


def plan_layout(positions, agents, tabs, workspaces, renamed=None, layouts=None, cfg=None):
    """Pure. For organizations with units: the live unit positions of each system go into their
    unit's workspace, at most `max_per_tab` per tab (`storefront`, `storefront·2`, ...), blocked and
    working first, parked last, each tab in a balanced layout (1 full, 2 side by side, 3 one left
    and two right, 4 a 2x2 grid). Returns [(workspace label, tab label, [(pane, position)], ok)],
    ok = the tab already holds exactly those panes in that layout. `layouts` = {tab id: herdr pane
    layout}. The desk and organizations on hold are left alone."""
    cfg = cfg or dict(LAYOUT_DEFAULTS)
    renamed, layouts = renamed or {}, layouts or {}
    ws_label = {w["workspace_id"]: renamed.get(w["workspace_id"], w.get("label")) for w in workspaces}
    desk_ws = {wid for wid, lab in ws_label.items() if lab == DESK}
    groups = {}
    import of_views
    pinned = of_views.pinned_positions()
    for p, a in bind(positions, agents)[0]:
        if p.get("_org") in HELD or not p.get("_unit") or a["workspace_id"] in desk_ws or p["name"] in pinned:
            continue
        # a position placed in a unit by `unit:` whose system is not one of the unit's: the `owner` tab
        outside = p.get("unit") and p.get("system") not in (((p.get("_units") or {}).get(p["unit"]) or {})
                                                            .get("systems") or [])
        groups.setdefault((want_workspace(p), "owner" if outside else p.get("system")), []).append((p, a))
    tab_by_id = {t["tab_id"]: t for t in tabs}
    plan = []
    k = cfg["max_per_tab"]
    for (w, system), members in sorted(groups.items(), key=lambda kv: (kv[0][0] or "", kv[0][1] or "")):
        rank = lambda pa: (pa[0].get("status") in ("parked", "finished"),  # noqa: E731
                           STATE_ORDER.get(pa[1].get("agent_status"), 5), pa[0]["name"])
        labels = [tab_label(system, i) for i in range(-(-len(members) // k))]
        slots = {lab: [] for lab in labels}
        loose = []
        # sticky: an agent already in one of its system's tabs stays there (no churn when states change)
        for pa in sorted(members, key=rank):
            t = tab_by_id.get(pa[1].get("tab_id")) or {}
            here = t.get("label") if ws_label.get(t.get("workspace_id")) == w else None
            if here in slots and len(slots[here]) < k:
                slots[here].append(pa)
            else:
                loose.append(pa)
        # the system's keeper (its single writer) is pinned to the first slot of the first tab
        # (acme_org, 2026-11-06): the owner looks for it first; a parked or finished agent, else the
        # last-ranked one, gives up its place and goes to the overflow
        keeper = ((members[0][0].get("_systems") or {}).get(system) or {}).get("keeper")
        kp = next((pa for pa in members if pa[0]["name"] == keeper), None)
        if kp:
            for lab in labels:
                if kp in slots[lab]:
                    slots[lab].remove(kp)
            if kp in loose:
                loose.remove(kp)
            first = slots[labels[0]]
            if len(first) >= k:
                retired = [pa for pa in first if pa[0].get("status") in ("parked", "finished")]
                out = (retired or sorted(first, key=rank))[-1]
                first.remove(out)
                loose.insert(0, out)
            first.insert(0, kp)
        for pa in loose:  # newcomers and overflow: active first into the first free slot
            lab = next(lab for lab in labels if len(slots[lab]) < k)
            slots[lab].append(pa)
        for lab in labels:
            if not slots[lab]:
                continue
            members_here = sorted(slots[lab], key=rank)
            if kp in members_here:
                members_here.remove(kp)
                members_here.insert(0, kp)
            chunk = [(a["pane_id"], p["name"]) for p, a in members_here]
            tab = next((t for t in tabs if base_label(t.get("label")) == lab and ws_label.get(t["workspace_id"]) == w), None)
            lay = layouts.get(tab["tab_id"]) if tab else None
            ok = bool(tab) and balanced(lay, [c[0] for c in chunk], cfg.get("three"))
            if ok and kp and chunk[0][0] == kp[1]["pane_id"]:  # the keeper sits top-left, or the tab is rebuilt
                r = next((x["rect"] for x in lay.get("panes") or [] if x["pane_id"] == chunk[0][0]), None)
                ok = bool(r) and abs(r["x"] - lay["area"]["x"]) <= 2 and abs(r["y"] - lay["area"]["y"]) <= 2
            plan.append((w, lab, chunk, ok))
    return plan


def build_tab(w, label, chunk, three="left+2"):
    """Lay one tab out from scratch with herdr pane moves (no agent restarts): the first pane into a
    new tab, then the others by balanced splits (ratio 0.5). Returns True if every move succeeded."""
    workspaces = herdr_json("workspace", "list")["workspaces"]
    ws = next((x for x in workspaces if x.get("label") == w), None)
    first = chunk[0][0]
    if ws:
        ok = herdr_do(["pane", "move", first, "--new-tab", "--workspace", ws["workspace_id"], "--label", label,
                       "--no-focus"], False)
    else:
        ok = herdr_do(["pane", "move", first, "--new-workspace", "--label", w, "--tab-label", label, "--no-focus"], False)
    if not ok:
        return False
    tab = herdr_json("pane", "get", first)["pane"]["tab_id"]
    ids = [c[0] for c in chunk]
    n = len(ids)
    steps = []
    if n >= 2:
        steps.append((ids[1], "right", ids[0]))
    if n == 3 and three == "columns":
        steps = [(ids[1], "right", ids[0]), (ids[2], "right", ids[1])]
    elif n == 3:
        steps.append((ids[2], "down", ids[1]))
    elif n == 4:
        steps += [(ids[2], "down", ids[0]), (ids[3], "down", ids[1])]
    for pane, direction, target in steps:
        ratio = "0.5" if not (n == 3 and three == "columns") else ("0.333" if target == ids[0] else "0.5")
        ok = herdr_do(["pane", "move", pane, "--tab", tab, "--split", direction, "--target-pane", target,
                       "--ratio", ratio, "--no-focus"], False) and ok
    return ok


def tab_layouts(tabs):
    """{tab id: herdr pane layout} for every tab (one call per tab)."""
    panes = herdr_json("pane", "list")["panes"]
    out = {}
    for t in tabs:
        first = next((p["pane_id"] for p in panes if p.get("tab_id") == t["tab_id"]), None)
        if first:
            try:
                out[t["tab_id"]] = herdr_json("pane", "layout", "--pane", first)["layout"]
            except OfError:
                pass
    return out


def cmd_apply(args):
    positions, problems = load_positions()
    for pr in problems:
        print(f"registry: {pr}", file=sys.stderr)
    agents = live_agents()
    tabs = herdr_json("tab", "list")["tabs"]
    workspaces = herdr_json("workspace", "list")["workspaces"]
    labels = {x["pane_id"]: x.get("label") for x in herdr_json("pane", "list")["panes"]}
    cmds, notes = plan_apply(positions, agents, tabs, workspaces, labels)
    ok = all([herdr_do(c, args.dry_run) for c in cmds])
    renamed = {c[2]: c[3] for c in cmds if c[:2] == ["workspace", "rename"]}
    cfg = layout_config()
    plan = plan_layout(positions, agents, tabs, workspaces, renamed, tab_layouts(tabs), cfg)
    todo = [x for x in plan if not x[3]]
    for w, label, chunk, _ in todo:
        names = ", ".join(n for _, n in chunk)
        if args.dry_run:
            print(f"  lay out {w} / {label}: {names}")
            continue
        try:
            ok = build_tab(w, label, chunk, cfg.get("three")) and ok
        except OfError as e:
            notes.append(f"{w} / {label}: not laid out ({e})")
            ok = False
    cmds = cmds + [["layout"]] * len(todo)
    if not args.dry_run:
        try:
            import of_lifecycle
            import of_store
            written = of_lifecycle.record(of_store.connect(), positions, agents, bind)
            if written:
                print(f"model: {written} mandate/holder change(s) recorded")
        except Exception as e:
            print(f"model: not recorded ({type(e).__name__}: {e})", file=sys.stderr)
        import of_events
        for p in positions:
            if p.get("_bound_by_name"):
                of_events.emit("holder_changed", {"position": p["name"], "previous_session": None,
                                                  "new_session": p["_bound_by_name"],
                                                  "evidence": "live agent started under the canonical name"},
                               position=p["name"], org=p.get("_orgid"))
    if not cmds:
        print("herdr already matches the registry.")
    for n in notes:
        print(n)
    return 0 if ok and not problems else 1


# --------------------------------------------------------------------- who

STATE_RANK = {"blocked": 0, "done": 1, "working": 2, "idle": 3, "unknown": 4}


def _transcript_exists(session_id, cache={}):
    """Does any harness config dir hold a transcript for this session? A pane whose herdr session has
    none carries a stale reference (for example a nested `claude -p` run from inside the pane)."""
    if not session_id:
        return True
    if session_id not in cache:
        import glob
        pats = [os.path.expanduser(f"~/.claude*/projects/*/{session_id}.jsonl"),
                os.path.expanduser(f"~/.codex/sessions/**/*{session_id}*")]
        cache[session_id] = any(glob.glob(p, recursive=True) for p in pats)
    return cache[session_id]


def who_rows(positions, agents):
    pairs, unheld, unknown = bind(positions, agents)
    rows = []
    for p, a in pairs:
        rows.append(_row(p, a))
    for p in unheld:
        rows.append(_row(p, None))
    for a in unknown:
        rows.append(_row(None, a))

    def key(r):
        needs_owner = r["state"] in ("blocked", "done") or r["waiting_on"] == "owner"
        retired = r["status"] in ("parked", "finished")
        return (0 if needs_owner else 1, 1 if retired else 0, waiting_rank(r["waiting_on"]) or 0,
                r["position"] is None, STATE_RANK.get(r["state"], 5), r["system"] or "~", r["name"])
    return sorted(rows, key=key)


def _row(p, a):
    tokens = (a or {}).get("tokens") or {}
    return {
        "name": (p or {}).get("name") or (a or {}).get("name") or (a or {}).get("terminal_title_stripped") or "-",
        "position": (p or {}).get("name"),
        "system": (p or {}).get("system") or tokens.get("system") or "",
        "status": (p or {}).get("status") or "",
        "waiting_on": (p or {}).get("waiting_on") or "",
        "note": (p or {}).get("note") or "",
        "throughput": (p or {}).get("throughput") or "",
        "state": (a or {}).get("agent_status") or "offline",
        "stale_session": bool(a) and not _transcript_exists(agent_session(a)),
        "unit": (p or {}).get("_unit") or "",
        "summary": (p or {}).get("summary") or tokens.get("summary") or "",
        "mandate": (p or {}).get("mandate") or "",
        "pane": (a or {}).get("pane_id") or "",
    }


def _merge_presence(rows, positions, timeout_s=2, remote=None):
    """Positions held on the organization's other machines (docs/server-several-machines.md §4.4): a row offline here
    and present on the org's server (relay presence) shows `remote:<state>`, and its pane column names the machine,
    the person and the presence's age; --json carries machine, person and age_s. Best effort: a server that does not
    answer leaves the rows as they are."""
    offline = {r["position"]: r for r in rows if r.get("position") and r.get("state") == "offline"}
    if not offline:
        return
    try:
        import of_presence
        by_org = remote if remote is not None else of_presence.remote(
            {p.get("_org") for p in positions if p["name"] in offline}, timeout_s=timeout_s)
    except Exception:  # noqa: BLE001
        return
    org_of = {p["name"]: p.get("_org") for p in positions}
    for org, hs in by_org.items():
        for h in hs:
            r = offline.get(h.get("position"))
            if r is None or org_of.get(h.get("position")) != org:
                continue
            machine = str(h.get("machine_id") or "?")
            r["state"] = f"remote:{h.get('state') or h.get('kind') or 'live'}"
            age = h.get("age_s")
            r["pane"] = " · ".join(x for x in (f"machine {machine[:8]}", h.get("person"),
                                               age is not None and of_presence.age_text(age) + " ago") if x)
            r.update(machine=machine, person=h.get("person"), age_s=h.get("age_s"))


def cmd_who(args):
    positions, problems = load_positions()
    for pr in problems:
        print(f"registry: {pr}", file=sys.stderr)
    agents = live_agents_or_none()
    rows = who_rows(positions, agents)
    _merge_presence(rows, positions)
    try:  # the one display projection, shared with Studio (of_pulse is the only herdr reader)
        import of_studio
        att = {r["position"]: r for r in of_studio.attention_all()}
    except Exception:
        try:
            att = {r["position"]: r for r in _attention(positions, agents)}
        except Exception:
            att = {}
    order = {"waiting_owner": 0, "waiting_peer": 1, "waiting_external": 1, "stalled": 2}
    for r in rows:
        a = att.get(r["position"] or "")
        r["attention"] = (a["kind"].replace("_", " ") + (f" {a['on']}" if a.get("on") and a["kind"] != "waiting_owner" else "")) if a else ""
    rows.sort(key=lambda r: (order.get((att.get(r["position"] or "") or {}).get("kind"), 3),))
    if not args.json:
        warn = _server_warning()
        if warn:
            print(warn, file=sys.stderr)
    if args.json:
        print(json.dumps(rows, ensure_ascii=False, indent=2))
        return 0
    cols = ["name", "system", "state", "attention", "waiting_on", "status", "summary", "pane"]
    if any(r.get("unit") for r in rows):
        cols[1:1] = ["unit"]
    if args.long:
        cols[-1:-1] = ["throughput", "mandate", "note"]
    table = [[c.upper() for c in cols]]
    for r in rows:
        name = r["name"] if r["position"] else r["name"] + " (no position)"
        vals = [r[c] + (" (stale session)" if c == "state" and r.get("stale_session") else "") for c in cols[1:]]
        table.append([name] + vals)
    widths = [max(len(row[i]) for row in table) for i in range(len(cols))]
    for row in table:
        print("  ".join(v.ljust(w) for v, w in zip(row, widths)).rstrip())
    return 0


def _server_warning():
    """One line about of-server's queue: dead batches, a failing writer, a backlog draining or stuck."""
    import urllib.request
    try:
        with urllib.request.urlopen("http://127.0.0.1:18200/v1/health", timeout=1) as r:
            h = json.loads(r.read())
    except Exception:
        return None  # not running here; `of server status` tells more
    if h.get("dead"):
        return f"of-server: {h['dead']} dead batch(es): data did not reach the store; see `of server status`"
    return server_health_line(h)


def calendar_ts(iso):
    import calendar
    import time
    return calendar.timegm(time.strptime(iso[:19], "%Y-%m-%dT%H:%M:%S"))


def server_health_line(h, now=None):
    """The of-server line for `of who`, from /v1/health: nothing when the queue is fine."""
    import time
    if h.get("dead"):
        return f"of-server: {h['dead']} dead batch(es): data did not reach the store; see `of server status`"
    if h.get("writer_error"):
        return f"of-server: writer failing ({h['writer_error'][:80]}); {h.get('queued', 0)} batch(es) queued"
    q = h.get("queued") or 0
    if not q:
        return None
    size = f" ({h['queue_bytes'] / 1e9:.1f} GB)" if h.get("queue_bytes") else ""
    eta = h.get("drain_eta_s")
    if eta is not None and h.get("drain_rate_bps"):
        m = max(1, round(eta / 60))
        left = f"{m // 60} h {m % 60} min" if m >= 60 else f"{m} min"
        return f"of-server: draining {q} batch(es){size}, ~{left} left"
    oldest = h.get("oldest_queued")
    try:
        age = (now or time.time()) - calendar_ts(oldest)
    except (TypeError, ValueError):
        age = 0
    if age > 600:
        return f"of-server: queue not draining: {q} batch(es){size}, oldest {int(age // 60)} min; see `of server status`"
    return None


# ---------------------------------------------------------------------- go

def resolve(query, positions, agents):
    """Return the agent to focus, or raise OfError (unknown, ambiguous, offline)."""
    q = strip_label(query).lower()
    pairs, unheld, unknown = bind(positions, agents)
    targets = [(p, a) for p, a in pairs] + [(p, None) for p in unheld] + [(None, a) for a in unknown]

    def keys(t):
        p, a = t
        exact, loose = set(), set()
        if p:
            exact |= {p["name"]} | {str(x).lower() for x in p.get("aliases") or []}
            if session_of(p):
                exact.add(session_of(p))
            if p.get("role"):
                loose.add(str(p["role"]).lower())
        if a:
            exact |= {x.lower() for x in (a.get("name"), a.get("pane_id"), agent_session(a)) if x}
        return exact, loose

    def label(t):
        p, a = t
        return (p or {}).get("name") or (a or {}).get("name") or (a or {}).get("pane_id")

    for stage in ("exact", "role", "prefix"):
        hits = []
        for t in targets:
            exact, loose = keys(t)
            if stage == "exact" and q in exact:
                hits.append(t)
            elif stage == "role" and q in loose:
                hits.append(t)
            elif stage == "prefix" and len(q) >= 3 and any(k.startswith(q) for k in exact | loose):
                hits.append(t)
        if len(hits) > 1:
            raise OfError(f"{query!r} is ambiguous: " + ", ".join(sorted(label(t) for t in hits)))
        if hits:
            p, a = hits[0]
            if a is None:
                raise OfError(f"{p['name']} has no live holder (session {session_of(p) or 'not set'})")
            return a
    raise OfError(f"no position or live agent matches {query!r}")


def _tool_parts(position, sid, config_dir, log=print):
    """The position's tool profile for a launch (docs/tools.md §4; of_tools.launch_parts): (argv, settings keys).
    An organization without a `tools:` catalogue gets ([], {}). A broken catalogue is of registry check's to report:
    the launch goes on without a profile, and says so."""
    try:
        import of_tools
        return of_tools.launch_parts(position, sid, config_dir)
    except Exception as e:  # noqa: BLE001
        log(f"tools: no profile for {position} ({type(e).__name__}: {e}); the session starts with the account's own")
        return [], {}


def cmd_spawn(args):
    """of spawn <position>: start its session with the brief, declared by construction (bin/of_spawn.py)."""
    import of_capacity
    import of_memory
    import of_relay_client
    import of_spawn
    positions, _ = load_positions()
    p = next((x for x in positions if args.position in [x["name"]] + [str(a) for a in x.get("aliases") or []]), None)
    if not p:
        raise OfError(f"no position {args.position!r} in the registries")
    roots = {o: os.path.dirname(os.path.dirname(f)) for o, f, _ in org_registries()}
    rows = None
    if not args.config_dir:
        rows = of_capacity.status(positions, probe=False)
        rows = rows if isinstance(rows, list) else rows.get("rows") or []
    # RFC 0006: the position's own memory directory once of_capacity has seeded the directories and turned it on
    # (capacity.yaml position_memory: true, as for a move); before that a spawn would start without its lessons
    memory = of_memory.settings(p, make=not args.dry_run) if of_capacity.load_policy().get("position_memory") else None
    agents = org_agents(p.get("_org"))  # the organization's default model and effort (of init writes them)
    # the credentials catalogue (docs/registry.md, Credentials): the session's own deny rules; the guard does the rest
    try:
        import of_credentials
        deny = of_spawn.deny_rules(p["name"], p.get("_org"), of_credentials.load())
    except Exception as e:  # noqa: BLE001 - a broken catalogue is of registry check's to report; the guard still runs
        deny = None
        print(f"credentials: no deny rules for this session ({type(e).__name__}: {e}); the guard still applies")
    try:
        pl = of_spawn.plan(p, positions, live_agents(), bind, p.get("_systems") or {}, _org_paths().get(p["_org"]),
                           roots.get(p["_org"], ""), want_workspace, config_dir=args.config_dir, cwd=args.cwd,
                           capacity_rows=rows, best_target=of_capacity.best_target,
                           trusted=lambda d, c: of_spawn.trusted_with_parents(d, c, of_capacity.trusted_key),
                           model=args.model or agents.get("model"), effort=getattr(args, "effort", None) or agents.get("effort"),
                           bypass=not args.no_bypass, memory=memory, deny=deny, accepted=of_spawn.bypass_accepted,
                           tools=_tool_parts)
    except of_spawn.SpawnError as e:
        raise OfError(str(e))
    print(f"{pl['position']}: session {pl['session']}\n  account {pl['config_dir']}\n  folder {pl['cwd']}\n"
          f"  place {pl['workspace']} / {pl['tab']}\n"
          f"  memory {of_memory.directory(p) if memory else 'the folder memory (position_memory is off)'}\n"
          f"  credentials: {len(pl['deny']) // 2} paths and roots denied in the session's own rules\n"
          f"  brief: {pl['brief']}")
    stop = None
    if not pl["trusted"]:
        stop = (of_spawn.trust_task(pl), f"stopped: {pl['cwd']} is not trusted in {pl['config_dir']}; Claude Code "
                f"would show the trust dialog, and trusting a folder is the owner's act.")
    elif not pl["bypass_ok"]:
        stop = (of_spawn.bypass_task(pl), f"stopped: {pl['config_dir']} has not accepted Claude Code's Bypass "
                f"Permissions warning; the session would open on it, and accepting it is the owner's act.")
    if stop:
        (title, steps), line = stop
        print(line)
        if args.dry_run:
            return 2
        r = subprocess.run([sys.executable, os.path.realpath(__file__), "ask", title, "--task", steps],
                           capture_output=True, text=True, timeout=60)
        print("  " + ((r.stdout or r.stderr).strip().splitlines() or ["(no output)"])[-1]
              if r.returncode == 0 else f"  could not file the task (run of ask yourself): {(r.stderr or '').strip()[:200]}")
        return 2
    if args.dry_run:
        print(f"  would run: {pl['command']}")
        return 0
    herdr = lambda *a: of_capacity._herdr(*a)
    try:
        pane = of_spawn.run(pl, herdr,
                            deliver=lambda pane, text, sid: of_relay_client.herdr_deliver(pane, text, sid, "of_spawn", wait_s=120, via="of spawn"),
                            rename=of_capacity.rename_agent,
                            wait_session=lambda sid, t: of_spawn.wait_for(lambda: of_capacity._agent_by_session(sid), t),
                            of_bin=os.path.realpath(__file__))
    except (of_spawn.SpawnError, of_capacity.MoveError) as e:
        raise OfError(str(e))
    print(f"{pl['position']} runs in pane {pane}. The structure keeper adds to its registry entry:\n"
          + of_spawn.registry_line(pl, pane))
    return 0


def cmd_loop(args):
    """of loop hypothesis|run|decision|show <work> (RFC 0005 §4.1; bin/of_loop.py)."""
    import of_events
    import of_loop
    import of_store
    regs = {o: p for o, p, _ in org_registries()}
    orgs = [args.org] if args.org else sorted(regs)
    found = []
    for org in orgs:
        w, loop = work_loop(org, args.work)
        if w is not None:
            found.append((org, w, loop))
    if not found:
        raise OfError(f"no work {args.work!r} in {', '.join(orgs)}")
    if len(found) > 1:
        raise OfError(f"work {args.work!r} is in several organizations; pass --org")
    org, w, loop = found[0]
    if loop is None:
        raise OfError(f"work {args.work!r} has no loop: its structure keeper adds loop: (RFC 0005 §4)")
    conn = of_store.connect()
    rows = [{"name": n, "ts": ts, "payload": json.loads(pl or "{}")} for n, ts, pl in conn.execute(
        "SELECT name, ts, payload FROM event WHERE name IN ('of.loop_hypothesis', 'of.loop_run', 'of.loop_decision') "
        "AND json_extract(payload, '$.work') = ? ORDER BY ts", (args.work,))]
    reg = of_loop.register(rows, args.work)
    if args.action == "show":
        print(f"{args.work} ({org}): target {(loop.get('target') or {}).get('metric')}; ladder {' > '.join(of_loop.rungs(loop))}")
        for h in reg["hypotheses"]:
            print(f"  {h['id']} {h['status']:<8} voi {h['voi'] or '?':<4} cost {h['cost'] or '?':<22} runs {h['runs']}  {h['change']}")
        for d in reg["decisions"][-5:]:
            print(f"  decision {d['ts'][:16]} {d['decision']} {d.get('hypothesis') or ''} {d.get('note') or ''}")
        return 0
    positions = _load_quiet()
    me = _me(positions, getattr(args, "sender", None))
    known = {h["id"] for h in reg["hypotheses"]}

    def need_hypothesis(required):
        hid = args.hypothesis
        if not hid and required:
            raise OfError("--hypothesis <id> is required here (of loop show lists them)")
        if hid:
            m = [k for k in known if k.startswith(hid)]
            if len(m) != 1:
                raise OfError(f"no single hypothesis {hid!r} on {args.work}")
            return m[0]
        return None
    if args.action == "hypothesis":
        if not args.text:
            raise OfError('usage: of loop hypothesis <work> "<change>" --predict "…" --cost "…" --voi low|med|high')
        if args.voi not in of_loop.VOI:
            raise OfError("--voi is low, med or high")
        hid = of_loop.hypothesis_id(args.work, args.text)
        payload = {"work": args.work, "id": hid, "hypothesis": hid, "change": args.text, "predict": args.predict,
                   "cost": of_loop.cost_of(args.cost, of_loop.rungs(loop)), "voi": args.voi, "status": "open"}
        kind = "loop_hypothesis"
    elif args.action == "run":
        if args.rung not in of_loop.rungs(loop):
            raise OfError(f"rung {args.rung!r} is not on {args.work}'s ladder: {', '.join(of_loop.rungs(loop))}")
        try:
            value = float(args.value) if args.value is not None else None
        except ValueError:
            raise OfError("--value is a number in the metric's unit")
        if args.accepted not in (None, "yes", "no"):
            raise OfError("--accepted is yes or no (the rung's accept criterion met)")
        if args.run and any(r["name"] == "of.loop_run" and r["payload"].get("run") == args.run for r in rows):
            print(f"loop_run: {args.work} run {args.run} is already recorded; nothing written")  # a re-sync is harmless
            return 0
        sid = os.environ.get("CLAUDE_CODE_SESSION_ID") or session_of(me)
        model = conn.execute("SELECT model FROM event WHERE session_id = ? AND model IS NOT NULL ORDER BY ts DESC LIMIT 1",
                             (sid,)).fetchone() if sid else None
        payload = {"work": args.work, "run": args.run or of_loop.hypothesis_id(args.work, f"run:{args.rung}"), "rung": args.rung,
                   "hypothesis": need_hypothesis(False), "metric": args.metric or (loop.get("target") or {}).get("metric"),
                   "value": value, "accepted": None if args.accepted is None else args.accepted == "yes",
                   "result": args.result, "evidence": args.evidence, "queued_at": args.queued_at,
                   "started_at": args.started_at, "ended_at": args.ended_at or of_events.now_iso(),
                   "runner_h": float(args.runner_h) if args.runner_h else None,
                   "tokens": int(args.tokens) if args.tokens else None,
                   "session": sid, "model": model[0] if model else None, "source": args.source or "manual"}
        kind = "loop_run"
    else:
        dec = args.text
        if dec not in of_loop.DECISIONS:
            raise OfError(f"a decision is one of {', '.join(of_loop.DECISIONS)}")
        if dec == "change_objective" and not (args.metric and (args.to_money or args.money)):
            raise OfError('change_objective names the new metric and its chain to money: --metric "…" --to-money "…" '
                          "(RFC 0005 §6)")
        if args.rung and args.rung not in of_loop.rungs(loop):
            raise OfError(f"rung {args.rung!r} is not on {args.work}'s ladder")
        payload = {"work": args.work, "decision": dec, "hypothesis": need_hypothesis(dec in of_loop.STATUS_OF),
                   "rung": args.rung, "metric": args.metric if dec == "change_objective" else None,
                   "to_money": (args.to_money or args.money) if dec == "change_objective" else None,
                   "money": (args.to_money or args.money) if dec == "change_objective" else None,  # Studio's name
                   "note": args.note}
        kind = "loop_decision"
    of_events.emit(kind, {k: v for k, v in payload.items() if v is not None}, position=me["name"],
                   org=me.get("_orgid") or org)
    # the hypothesis's status as its own update event, same id (docs/studio.md 5.6): testing at its first run,
    # kept / dropped / parked at a decision
    hid = payload.get("hypothesis") if kind != "loop_hypothesis" else None
    cur = next((h for h in reg["hypotheses"] if h["id"] == hid), None) if hid else None
    new_status = ("testing" if kind == "loop_run" and cur and cur["status"] == "open"
                  else of_loop.STATUS_OF.get(payload.get("decision")) if kind == "loop_decision" else None)
    if cur and new_status and new_status != cur["status"]:
        of_events.emit("loop_hypothesis", {"work": args.work, "id": hid, "hypothesis": hid, "status": new_status,
                                           "status_at": of_events.now_iso()}, position=me["name"], org=me.get("_orgid") or org)
    print(f"{kind}: {args.work}" + (f" {payload['hypothesis']}" if payload.get("hypothesis") else ""))
    return 0


def cmd_fit(args):
    """`of fit replay`: the mandate-fit judge over recorded messages; prints what it flags, records nothing."""
    import concurrent.futures
    import of_fit
    import of_store
    positions = _load_quiet()
    since = args.since or time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(time.time() - 86400))
    conn = of_store.connect()
    only = None
    if args.event:
        only = {eid for (eid,) in conn.execute("SELECT event_id FROM event WHERE name = 'of.agent_message_in' AND ts >= ?",
                                               (since,)) if any(eid.endswith(e) or eid.startswith(e) for e in args.event)}
    ds = of_fit.dispatches(conn, since, args.until, args.sender, args.receiver, only=only)
    if args.limit:
        ds = ds[:args.limit]
    print(f"{len(ds)} message(s) to judge ({of_fit.VERSION}, {of_fit.MODEL})", flush=True)
    out = open(args.out, "a") if args.out else None
    n = {"flagged": 0, "work": 0, "error": 0, "cost": 0.0}
    with concurrent.futures.ThreadPoolExecutor(max(1, args.jobs)) as ex:
        cache = {}  # the registry as of each message (acme_org, 2026-11-10)
        for d, v in zip(ds, ex.map(lambda d: of_fit.judge(d, positions, as_of=True, cache=cache), ds)):
            n["cost"] += v.get("cost_usd") or 0
            if v.get("error"):
                n["error"] += 1
            n["work"] += bool(v.get("assigns_work"))
            if out:
                out.write(json.dumps({**{k: d[k] for k in ("event_id", "ts", "sender", "receiver")},
                                      "text": d["text"][:300], **v}, ensure_ascii=False) + "\n")
                out.flush()
            if of_fit.flagged(v, args.min_confidence):
                n["flagged"] += 1
                print(f"{d['ts'][:16]} {d['event_id'][-8:]} {d['sender']} -> {d['receiver']}: {v['verdict']}"
                      f"{' (' + v['owner'] + ')' if v.get('owner') else ''} {v.get('confidence'):.2f}\n"
                      f"    {d['text'][:160]}\n    why: {v.get('reason')}", flush=True)
    print(f"judged {len(ds)}: {n['work']} hand out work, {n['flagged']} flagged, {n['error']} errors, "
          f"${n['cost']:.3f}")
    return 0


def cmd_delegate(args):
    """`of delegate "<task>"`: who should do it, by the organization's mandates; records nothing."""
    import of_fit
    positions = _load_quiet()
    me = _me(positions, args.sender)
    v = of_fit.delegate(args.task, positions, me.get("_orgid", me.get("_org")), asker=me["name"])
    if args.json:
        print(json.dumps(v, ensure_ascii=False, indent=2))
        return 1 if v.get("error") else 0
    if v.get("error"):
        raise OfError(f"of delegate: {v['error']}")
    for i, c in enumerate(v["candidates"], 1):
        print(f"{i}. {c['name']} ({c['fit']}): {c['why']}")
    if v.get("none_fits") or not v["candidates"]:
        print(f"no position's mandate covers it: {v.get('suggestion') or '-'}")
        print("  propose the change to your structure keeper (a mandate rewrite or a new position: of diff)")
    if (v.get("overlap") or "").strip():
        print(f"overlap: {v['overlap']}  (tell your structure keeper)")
    return 0


def cmd_conductor(args):
    import of_conductor_panel
    try:
        return of_conductor_panel.run(every=max(5, args.every), once=args.once, text=not args.picture,
                                      cards=not (args.text or args.picture) and sys.stdout.isatty())
    except KeyboardInterrupt:
        return 0


def _panel_panes(v, panes_now, dry_run, say, anchor=None):
    """{panel name: pane id} for a view's panels (views.yaml `panels: {name: command}`, placed in `positions` as
    `panel:<name>`): the pane labelled "▤ <name>", started in a new pane with its command when there is none
    (hand-over a8ee7e96: the conductor's panel in its pinned view). The layout then places it like an agent."""
    out = {}
    for name, command in (v.get("panels") or {}).items():
        label = f"▤ {name}"
        hit = next((p["pane_id"] for p in panes_now if (p.get("label") or "").strip() == label), None)
        if not hit and not dry_run:
            import of_capacity
            r = herdr_json("pane", "split", anchor, "--direction", "right", "--cwd", os.path.expanduser("~"),
                           "--no-focus") if anchor else None
            hit = of_capacity.first_pane_id(r) if r else None
            if hit:
                cmd = str(command).replace("of ", f"{os.path.realpath(__file__)} ", 1) if str(command).startswith(
                    "of ") else str(command)
                herdr_do(["pane", "run", hit, cmd], False)
                herdr_do(["pane", "rename", hit, label], False)
                say(f"  panel {name}: started in {hit}")
        if hit:
            out[name] = hit
    return out


def cmd_resume_command(args):
    """Print the line that resumes a session as it ran; exit 1 (print nothing) when no account holds it."""
    import of_capacity
    import of_memory
    import of_resume
    mem, p = None, None
    try:
        p = next((x for x in _load_quiet() if session_of(x) == args.session), None)
    except Exception:  # noqa: BLE001 - no registry: resume as it ran, without the position's settings
        p = None
    if p and of_capacity.load_policy().get("position_memory"):
        try:
            mem = of_memory.directory(p)
        except Exception:  # noqa: BLE001
            mem = None
    deny = of_capacity.deny_for(p, log=lambda m: None) if p else None  # its credential deny rules, as of spawn
    d, _ = of_resume.newest_copy(args.session)
    tools = _tool_parts(p["name"], args.session, d, log=lambda m: None) if p and d else None  # its tool profile
    line = of_resume.command(args.session, memory_dir=mem, deny=deny, tools=tools,
                             defaults=org_agents(p.get("_org")) if p else None)
    if not line:
        return 1
    print(line)
    return 0


def cmd_go(args):
    positions, _ = load_positions()
    a = resolve(args.name, positions, live_agents())
    out = subprocess.run([HERDR, "agent", "focus", a["pane_id"]], capture_output=True, text=True, timeout=20)
    if out.returncode != 0:
        raise OfError(f"herdr agent focus failed: {(out.stderr or out.stdout).strip()}")
    print(f"focused {a.get('name') or a['pane_id']} ({a['pane_id']})")
    return 0


# ---------------------------------------------------------------- registry

def cmd_registry(args):
    TREE_REF["ref"] = getattr(args, "ref", None) or "remote"
    positions, problems = load_positions(deep=True)
    if args.action == "check":
        import of_grants
        grants_by_org = of_grants.load()
        for org, gid, ok, why in of_grants.check_all(grants_by_org, _grant_keys(), _now_iso()):
            if not ok:
                problems.append(f"{org}:registry/grants.yaml: {gid}: {why}")
        try:  # a deny ends only by a signed revocation: an issued grant gone from the file is a problem
            import of_events
            rows = of_events._conn().execute("SELECT name, org, payload FROM event WHERE name IN "
                                             "('of.grant_issued', 'of.grant_revoked')").fetchall()
            events = [(n, o, json.loads(p) if isinstance(p, str) else (p or {})) for n, o, p in rows]
        except Exception:  # noqa: BLE001 - no local store: nothing to compare with
            events = []
        for org, gid in of_grants.missing_issued(grants_by_org, events):
            problems.append(f"{org}:registry/grants.yaml: {gid}: issued (of.grant_issued) and never revoked, but "
                            "missing from the file")
        import of_credentials  # docs/registry.md, Credentials: ids, keepers, listed ids, one claim per path
        problems += of_credentials.check(ORGS_FILE)
        for pr in problems:
            print(pr)
        warnings = [p_ for p_ in problems if WARN in p_]
        problems = [p_ for p_ in problems if WARN not in p_]
        orgs = {p["_org"] for p in positions}
        print(f"{len(positions)} positions in {len(orgs)} organizations: "
              + (f"{len(problems)} problem(s)" if problems else "ok")
              + (f", {len(warnings)} warning(s)" if warnings else ""))
        return 1 if problems else 0
    return 2


# ------------------------------------------------------------------- asks

def _send_outbox():
    """`of asks send-outbox`: the detached sender the popup hands its pending answers to on q/Esc/g."""
    import of_asks_answer
    import of_asks_tui
    import of_store
    positions = _load_quiet()

    def pane_of(name):
        try:
            return next((a["pane_id"] for p, a in bind(positions, live_agents())[0] if p["name"] == name), None)
        except OfError:
            return None

    def answer(item, text):
        own = of_store.connect()
        try:
            return of_asks_answer.answer(own, item, text, positions, pane_of)
        finally:
            own.close()

    def still_open(ids):
        open_ids = {a["event_id"] for a in _current_asks() if a["state"] == "open"}
        return not ids or any(i in open_ids for i in ids)
    n = of_asks_tui.send_outbox(answer, of_asks_tui.act_cli(os.path.realpath(__file__)), still_open,
                                reconcile=lambda: _reconcile_ask_tokens(positions),
                                log=lambda m: print(m, file=sys.stderr))
    print(f"{n} answer(s) sent from the outbox")
    return 0


def _asks_actor():
    """Who closes or withdraws an ask: the founder in his own terminal is "owner"; an agent (an asker withdrawing its
    own stale ask, a unit owner answering a routed one) is recorded by its position, never as the owner (task bd12d0)."""
    if os.environ.get("CLAUDE_CODE_SESSION_ID") or os.environ.get("OF_POSITION"):
        try:
            return _me(_load_quiet())["name"]
        except OfError:
            return "agent"
    return "owner"


def _asks_deliver(position=None):
    """`of asks deliver [<position>]`: type now what the founder answered, and the questions routed to a unit owner,
    that has no record in the pane yet. The listener runs it when the position ends a turn, so an answer given while
    the agent was busy goes in then, not at the next pulse. It reads the listener's asks view when it is live (the
    whole projection takes seconds)."""
    import time
    import of_asks
    import of_asks_answer
    import of_listen
    import of_store
    conn = of_store.connect()
    if of_listen.fresh(conn):
        asks = of_listen.read_asks(conn)
        since = time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(time.time() - of_asks_answer.REDELIVER_MAX_AGE_H * 3600))
        extra = {e: (src, srcv) for e, src, srcv in conn.execute(
            "SELECT event_id, json_extract(payload, '$.escalated_from'), json_extract(payload, '$.source') FROM event "
            "WHERE name = 'of.agent_question' AND ts >= ? AND json_extract(payload, '$.escalated_from') IS NOT NULL",
            (since,))}
        for a in asks:  # the view keeps no escalated_from: pending needs it to tell a rewrite from OF's copy
            if a["event_id"] in extra:
                a["escalated_from"], a["source"] = extra[a["event_id"]]
    else:
        asks = of_asks.project(of_asks.load(conn))
    soon = bool(position)
    n = of_asks_answer.redeliver_pass(
        conn, asks, _load_quiet(), live_agents(), bind, only=position,
        min_age=of_asks_answer.REDELIVER_SOON_S if soon else of_asks_answer.REDELIVER_MIN_AGE_S,
        wait_s=15 if soon else 3, need_idle=not soon)
    print(f"{_now_iso()} deliver {position or 'all'}: {n} typed")
    return 0


def cmd_asks(args):
    if args.action == "send-outbox":
        return _send_outbox()
    if args.action == "judge":  # bin/of_judge.py: does a question left in a pane wait on the owner?
        import of_judge
        return of_judge.run([x for x in [args.id, *(args.reason or [])] if x], args.pending, args.pane, args.dry_run)
    if args.action == "deliver":  # the listener, at the end of a position's turn (of_asks_answer.redeliver_pass)
        return _asks_deliver(args.id)
    if args.watch and args.action not in ("answered", "withdraw"):  # the popup: first frame before any store work
        import of_asks_tui
        import threading
        lock, cache = threading.Lock(), {}

        def positions():  # the registry loads on first use, in a background thread: the first frame needs none
            with lock:
                if "p" not in cache:
                    cache["p"] = _load_quiet()
                return cache["p"]

        def refresh():
            """Background, after the first frame: reconcile with live sessions, the herdr counts."""
            import of_asks_live
            import of_store
            try:
                agents = live_agents()
            except OfError:
                agents = None
            own = of_store.connect()
            try:
                of_asks_live.run(own, positions(), agents, bind, log=lambda m: None)
            finally:
                own.close()
            _reconcile_ask_tokens(positions())

        def pane_of(name):
            try:
                return next((a["pane_id"] for p, a in bind(positions(), live_agents())[0] if p["name"] == name), None)
            except OfError:
                return None
        return of_asks_tui.main(positions, None, os.path.realpath(__file__), pane_of,
                                after=lambda: _reconcile_ask_tokens(positions()), refresh=refresh)
    import of_asks
    import of_store
    conn = of_store.connect()
    asks = of_asks.project(of_asks.load(conn))
    if args.action == "answer":  # the person's answer given in their conductor's chat (bin/of_asks_chat.py)
        import of_asks_chat
        positions = _load_quiet()

        def pane_of(name):
            try:
                return next((a["pane_id"] for p, a in bind(positions, live_agents())[0] if p["name"] == name), None)
            except OfError:
                return None
        relayed_by = _asks_actor()
        try:
            out = of_asks_chat.answer(conn, asks, positions, args.id, args.prompt, pane_of, option=args.option,
                                      text=args.text, relayed_by=None if relayed_by == "owner" else relayed_by)
        except ValueError as e:
            raise OfError(f"not recorded: {e}")
        print("\n".join(out))
        _reconcile_ask_tokens(positions)
        return 0
    if getattr(args, "chat", False) and args.action == "list":
        import of_asks_chat
        print(of_asks_chat.chat_view(conn, asks))
        return 0
    if args.action == "answered":
        import of_events
        if not args.id:
            raise OfError("usage: of asks answered <ask id or prefix>")
        groups = of_asks.group(asks)
        g = next((g for g in groups if any(i.startswith(args.id) or i.endswith(args.id) for i in g["ask_ids"])), None)
        if not g:  # a routed ask OF escalated, settled by its unit owner: close the founder's copy (acme_org, 2026-11-09)
            src = [a for a in asks if a["state"] == "escalated" and (a["event_id"].startswith(args.id)
                                                                      or a["event_id"].endswith(args.id))]
            copies = [a for a in asks if len(src) == 1 and a.get("escalated_from") == src[0]["event_id"]
                      and a["state"] == "open"]
            if copies:
                g = {"ask_ids": [a["event_id"] for a in copies], "who": [f"the founder's copy of {src[0]['position']}"]}
        if not g:
            raise OfError(f"no open ask matches {args.id!r}")
        # who answers: the founder in his own terminal is "owner"; an agent (a unit owner answering a routed
        # question) is recorded by its position, never as the owner (2026-11-07, task bd12d0)
        by = _asks_actor()
        of_events.emit("agent_question_answered", {"ask_id": g["ask_ids"][0], "ask_ids": g["ask_ids"], "by": by,
                                                   "note": " ".join(args.reason) or None})
        print(f"answered: {len(g['ask_ids'])} ask(s) from {', '.join(g['who'])}")
        _reconcile_ask_tokens(_load_quiet())
        return 0
    if args.action == "withdraw":
        import of_events
        if not args.id:
            raise OfError("usage: of asks withdraw <ask id or prefix> [reason]")
        hits = [a for a in asks if (a["event_id"].startswith(args.id) or a["event_id"].endswith(args.id))
                and a["state"] == "open"]
        if len(hits) != 1:
            raise OfError(f"{len(hits)} open asks match {args.id!r}")
        a = hits[0]
        of_events.emit("ask_withdrawn", {"ask_id": a["event_id"], "reason": " ".join(args.reason) or None, "by": _asks_actor()},
                       position=a["position"], session=a["session_id"])
        print(f"withdrawn: {a['event_id']} ({a['position'] or a['session_id']})")
        _reconcile_ask_tokens(_load_quiet())
        return 0
    cfg = of_asks.config()
    shown = asks if args.all else [a for a in of_asks.for_owner(asks) if a["state"] == "open"]
    shown.sort(key=lambda a: a["ts"])  # the oldest wait first
    if args.json:
        import of_asks_chat  # how the conductor presents each in a chat: answer, steps, or waiting for the machine
        print(json.dumps([dict(a, in_chat=of_asks_chat.in_chat(a)) if a["state"] == "open" else a for a in shown],
                         ensure_ascii=False, indent=2))
        return 0
    panes = {}
    try:
        for a in live_agents():
            if a.get("agent_session"):
                panes[a["agent_session"].get("value")] = a["pane_id"]
    except OfError:
        pass
    if not args.all:  # one decision asked by several agents = one item, with everyone waiting on it
        groups = of_asks.group(asks)
        print(f"{len(groups)} open item(s) waiting on you ({sum(len(g['ask_ids']) for g in groups)} asks)")
        for g in groups:
            mark = of_asks.label(g["since"], cfg)
            print(f"  {g['ask_ids'][0][-8:]}  {of_asks.age(g['since']):>5} {mark:<8} {', '.join(g['who']):<34} "
                  f"{g['kind']:<22} {g['text'][:80]}")
        if groups:
            print("answer in the agent's pane (of go <name>), then: of asks answered <id>")
        return 0
    counts = {}
    for a in asks:
        counts[a["state"]] = counts.get(a["state"], 0) + 1
    print(f"asks: {counts.get('open', 0)} open" + "".join(f", {n} {k}" for k, n in sorted(counts.items()) if k != "open"))
    for a in shown:
        who = a["position"] or (a["session_id"] or "?")[:8]
        state = "" if a["state"] == "open" else f" [{a['state']}]"
        mark = of_asks.label(a["ts"], cfg) if a["state"] == "open" else ""
        print(f"  {a['event_id'][-8:]}  {of_asks.age(a['ts']):>5} {mark:<8} {who:<24} {a['kind']:<20} "
              f"{panes.get(a['session_id'], '-'):<6} {a['text'][:80]}{state}")
    if shown and not args.all:
        print("answer in the agent's pane: of go <name>")
    return 0


# ----------------------------------------------------------------- server

def cmd_server(args):
    import of_server
    if args.action == "start" or (args.action == "run" and args.daemon):
        pid, msg = of_server.start_daemon(log_path=args.log)
        print(msg)
        return 0 if pid else 1
    if args.action == "stop":
        ok, msg = of_server.stop_daemon()
        print(msg)
        return 0 if ok else 1
    if args.action == "run":
        of_server.run(log=lambda m: print(m, flush=True))
        return 0
    if args.action == "enroll-machine":
        import of_client
        import of_events
        mid = args.machine_id or of_events.machine_id()
        pub = open(os.path.expanduser(args.pubkey)).read() if args.pubkey else of_client.ensure_key()
        orgs = args.org or ([o for o, _, _ in org_registries()] if args.tenant else [])
        store = of_server.Store(of_server.load_config()["state_dir"])
        of_server.enroll(store, mid, pub, orgs, args.raw_org or (orgs if args.tenant else []), tenant=args.tenant)
        print(f"enrolled {mid}{' (tenant)' if args.tenant else ''}: orgs {', '.join(orgs) or '-'}")
        return 0
    if args.action == "revoke":
        store = of_server.Store(of_server.load_config()["state_dir"])
        of_server.revoke(store, args.machine_id)
        print(f"revoked {args.machine_id}")
        return 0
    if args.action == "export-secret-key":
        if not args.path:
            raise OfError("usage: of server export-secret-key <new file>")
        of_server.export_secret_key(of_server.load_config(), args.path)
        print(f"wrote the derived masking key to {args.path} (mode 600); the value is not shown")
        return 0
    if args.action == "status":
        import of_client
        import of_ship
        c = of_client.Client(of_ship.config()["server_url"])
        print(json.dumps(c._request("GET", "/v1/health")[1]))
        print(json.dumps(c._authed("GET", "/v1/metrics")[1]))
        return 0
    return 2


# ---------------------------------------------------------------- secrets

def cmd_secrets(args):
    import of_archive
    import of_grants
    import of_route
    import of_secrets
    import of_ship
    import glob
    import of_events
    import of_store
    of_archive.lower_priority()
    key = of_grants.purpose_key("of/secret/v1")
    router = of_route.Router(of_ship.config())
    sdir = os.path.join(of_events.STATE_DIR, "secrets")
    reports = args.reports or sorted(glob.glob(os.path.join(sdir, "gitleaks-*.json"))) + \
        [p for p in [os.path.join(sdir, "context.json")] if os.path.exists(p)]
    if args.action == "summarize":
        items = of_secrets.summarize(reports, key, router, args.exclude_session)
        of_secrets.write_summary(items, args.out)
        print(f"summary (no values): {args.out}")
        return 0
    if args.action == "scan-context":
        files = [f for f in of_archive.sources() if f.endswith(".jsonl")]
        n = of_secrets.scan_contextual(files, os.path.join(sdir, "context.json"), args.exclude_session)
        print(f"{n} contextual findings (EVM keys, URL passwords) in {len(files)} files: {sdir}/context.json")
        return 0
    conn = of_store.connect()
    cache = os.path.join(sdir, "review.json")
    if args.action == "mark":
        if len(args.reports) != 2 or args.reports[1] not in of_secrets.DECISIONS:
            raise OfError(f"usage: of secrets mark <hmac prefix> {'|'.join(of_secrets.DECISIONS)} [--note TEXT]")
        prefix, decision = args.reports
        items = json.load(open(cache)) if os.path.exists(cache) else []
        hits = [i for i in items if i["hmac"].startswith(prefix)]
        if len(hits) != 1:
            raise OfError(f"{len(hits)} reviewed items match {prefix!r}; run `of secrets review` first")
        i = hits[0]
        of_events.emit("secret_reviewed", {"hmac": i["hmac"], "rule": i["rule"], "kind": i["kind"],
                                           "decision": decision, "note": args.note, "orgs": i["orgs"]})
        print(f"marked {i['hmac'][:8]} ({i['kind']}): {decision}")
        return 0
    if args.action == "rotations":
        if not args.org:
            raise OfError("usage: of secrets rotations --org ORG [--json]")
        items = json.load(open(cache)) if os.path.exists(cache) else []
        regs = {o: p for o, p, _ in org_registries()}
        systems = (yaml.safe_load(open(regs[args.org])) or {}).get("systems") if args.org in regs and os.path.exists(regs[args.org]) else {}
        rows = of_secrets.rotations(items, of_secrets.reviewed(conn), args.org, _org_paths().get(args.org, []), systems)
        if args.json:
            print(json.dumps(rows, indent=1))
            return 0
        print(f"{len(rows)} item(s) marked rotate for {args.org} (no values; ref = an opaque tag)")
        for r in rows:
            print(f"  P{r['priority']}  {r['ref']}  {r['class']:<17} systems: {', '.join(r['systems']) or '?':<24} "
                  f"repos: {', '.join(r['repos']) or '?':<20} seen {r['seen']}x {r['first']}..{r['last']}")
        return 0
    # review: the owner's tool; values are never printed
    items = of_secrets.build_review(reports, key, router, args.exclude_session, width=args.width)
    with open(os.open(cache, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as fh:
        json.dump(items, fh)
    marks = of_secrets.reviewed(conn)
    shown = [i for i in items if args.all or i["hmac"] not in marks]
    print(f"{len(items)} items to review ({len(items) - len(shown)} already marked); values are never shown")
    for n, i in enumerate(shown, 1):
        mark = f" [{marks[i['hmac']]}]" if i["hmac"] in marks else ""
        print(f"\n{n}. {i['kind']}  {i['hmac'][:8]}{mark}  orgs: {', '.join(i['orgs'])}  "
              f"seen {len(i['locations'])}x, {str(i['first'])[:10]} .. {str(i['last'])[:10]}")
        print(f"   at {i['locations'][0]}")
        print(f"   {i['context']}")
    if shown:
        print(f"\nmark one: of secrets mark <hmac> {'|'.join(of_secrets.DECISIONS)} [--note TEXT]")
    return 0


# ------------------------------------------------------------------ store

def _harness_of(path):
    return "codex" if "/.codex/" in path else "claude-code"


def cmd_ingest(args):
    import of_archive
    import of_store
    of_archive.lower_priority()
    conn = of_store.connect()
    if args.pending:
        return _ingest_worker(conn, args)
    total = 0
    for path in args.paths:
        total += of_store.ingest_file(conn, os.path.abspath(path), _harness_of(path))
    if not args.quiet:
        print(f"{total} new records")
    try:  # near real time: ship right after ingesting; the central store may be down
        import of_ship
        of_ship.ship(log=(lambda m: None) if args.quiet else print)
    except Exception as e:
        if not args.quiet:
            print(f"ship skipped: {e}")
    return 0


def _reads_hook():
    """on_record callback for live ingest: cross-position Read/Grep/Glob → of.artifact_read."""
    import of_events
    import of_hook
    import of_reads
    import of_store
    index = of_hook._registry_index()
    pos_system = {name: info[3] for name, info in (index.get("labels") or {}).items()}
    found = []

    def on_record(obj):
        sid = obj.get("sessionId") or obj.get("session_id")
        reader = ((index.get("sessions") or {}).get(sid) or [None])[0]
        for payload, tuid in of_reads.detect(obj, reader, pos_system.get(reader), index.get("systems") or []):
            rec = of_events.record("artifact_read", payload, position=reader, session=sid, source="import",
                                   extra={"of.cwd": obj.get("cwd")})
            rec["of.event.id"] = of_reads.event_id(sid, tuid)
            rec["timestamp"] = obj.get("timestamp") or rec["timestamp"]
            found.append(rec)  # written after the file, on the ingest's own connection (see below)
    on_record.found = found
    return on_record


def _ingest_with_reads(conn, path):
    """Ingest one transcript, then write the of.artifact_read events it found on the same connection.
    Writing them from inside ingest_file's write transaction through a second connection deadlocked
    the store: each one waited 10 s on the lock its own process held, and every other writer
    (hooks, listener, relay, the asks popup) waited behind it (2026-11-06)."""
    import of_store
    hook = _reads_hook()
    n = of_store.ingest_file(conn, path, _harness_of(path), on_record=hook)
    for rec in hook.found:
        try:
            of_store.add_event(conn, rec)
        except Exception:  # noqa: BLE001 - a read event never stops the ingest
            pass
    return n


def _ingest_worker(conn, args):
    """One per machine (flock). Drains the hook spool, then every queued transcript, until the
    queue is empty; then ships. Hooks only queue and spawn; they never wait for this."""
    import fcntl
    import of_events
    import of_store
    lock = open(os.open(os.path.join(of_events.STATE_DIR, "ingest.lock"), os.O_WRONLY | os.O_CREAT, 0o600))
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0
    pending = os.path.join(of_events.STATE_DIR, "pending")
    os.makedirs(pending, mode=0o700, exist_ok=True)
    total = of_store.drain_spool(conn)
    while True:
        markers = sorted(os.listdir(pending))
        if not markers:
            # No lost wakeup: a hook queues its marker BEFORE it checks the lock. Release, look
            # again, and take the lock back if something arrived meanwhile (lab finding).
            fcntl.flock(lock, fcntl.LOCK_UN)
            if not os.listdir(pending):
                break
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                break  # another worker took over
            continue
        for m in markers:
            mp = os.path.join(pending, m)
            try:
                with open(mp) as fh:
                    path = fh.read().strip()
                os.remove(mp)  # a new turn re-queues it while we work
            except FileNotFoundError:
                continue
            for one in of_store.with_subagents(path):  # subagents spend too (of_capacity, 2026-11-06)
                total += _ingest_with_reads(conn, one)  # a new transcript's fork mark lands with its rows
        total += of_store.drain_spool(conn)
    if not args.quiet:
        print(f"{total} records")
    try:
        import of_ship
        of_ship.ship(log=(lambda m: None) if args.quiet else print)
    except Exception:
        pass
    return 0


IMPORT_MIN_FREE = 50 * 10 ** 9  # of_architect, 2026-11-06: alert below 50 GB free


def cmd_import(args):
    import time
    if args.source == "git":  # local commits on each default branch as work records, for an organization that never pushes
        import of_github
        import of_store
        if not args.org:
            raise OfError("usage: of import git --org ORG|all [--since YYYY-MM-DD] (default: since the last import)")
        regs = {o: p for o, p, _ in org_registries()}
        roots = _org_paths()
        conn = of_store.connect()
        rc = 0
        for org in (sorted(regs) if args.org == "all" else [args.org]):
            doc = yaml.safe_load(open(regs[org])) or {}
            if args.org == "all" and of_github.has_repos(doc.get("systems")):
                continue  # an organization whose systems name GitHub repositories keeps of import github
            try:
                of_github.import_local(conn, org, doc.get("systems") or {}, roots.get(org) or [], args.since,
                                       works=doc.get("works") or {}, branches=_org_entry(org).get("branches") or {})
            except Exception as e:  # noqa: BLE001
                print(f"{org}: {type(e).__name__}: {e}", file=sys.stderr)
                rc = 1
        return rc
    if args.source == "github":
        import of_github
        import of_store
        if not args.org:
            raise OfError("usage: of import github --org ORG|all [--since YYYY-MM-DD] (default: since the last import)")
        regs = {o: p for o, p, _ in org_registries()}
        conn = of_store.connect()
        rc = 0
        for org in (sorted(regs) if args.org == "all" else [args.org]):
            doc = yaml.safe_load(open(regs[org])) or {}
            if not of_github.has_repos(doc.get("systems")):
                continue
            since = args.since or of_github.since_for(conn, org)
            print(f"{org}: merged PRs since {since}")
            position_system = {p["name"]: p.get("system") for p in doc.get("positions") or [] if p.get("name")}
            try:
                of_github.import_org(conn, org, doc.get("systems") or {}, since, position_system=position_system,
                                     works=doc.get("works") or {}, open_fetcher=of_github.fetch_open,
                                     closed_fetcher=of_github.fetch_closed, detail_fetcher=of_github.fetch_detail)
            except Exception as e:  # noqa: BLE001 - one organization failing never stops the others
                print(f"{org}: {type(e).__name__}: {e}", file=sys.stderr)
                rc = 1
        return rc
    import of_archive
    import of_store
    of_archive.lower_priority()
    files = [f for f in of_archive.sources() if f.endswith((".jsonl", ".jsonl.zst"))]
    files.sort(key=os.path.getmtime)
    if args.limit:
        files = files[:args.limit]
    size = sum(os.path.getsize(f) for f in files)
    if args.dry_run:
        print(f"would import {len(files)} transcript files, {size / 1e9:.2f} GB")
        return 0
    import shutil
    conn = of_store.connect()
    t0, total = time.time(), 0
    for i, f in enumerate(files, 1):
        if i % 25 == 1:  # stop before the disk runs low; a re-run resumes from the cursors
            free = shutil.disk_usage(os.path.expanduser("~")).free
            if free < IMPORT_MIN_FREE:
                msg = f"of import stopped at {i - 1}/{len(files)} files: {free / 1e9:.0f} GB free (< {IMPORT_MIN_FREE / 1e9:.0f} GB)"
                print(msg, file=sys.stderr, flush=True)
                subprocess.run([HERDR, "notification", "show", "of import stopped", "--body", msg],
                               capture_output=True, timeout=10)
                return 1
        try:
            total += of_store.ingest_file(conn, f, _harness_of(f))
        except Exception as e:
            print(f"skip {f}: {e}", file=sys.stderr)
        if i % 25 == 0:
            print(f"  {i}/{len(files)} files, {total} records, {time.time() - t0:.0f}s", flush=True)
    print(f"imported {total} records from {len(files)} files in {time.time() - t0:.0f}s")
    import of_derive
    of_derive.derive(conn)
    return cmd_db(argparse.Namespace(action="stats"))


def cmd_redact(args):
    """of redact <session|sha>… [--event ID] --reason R [--from-scan FILE] [--dry-run] [--local-only]: remove a secret from
    every stored copy, here and on the servers that hold it (bin/of_redact.py)."""
    import of_redact
    import of_store
    if not args.reason and not getattr(args, "transcripts", False):
        raise OfError("of redact needs --reason (it is recorded in of.redacted; never the content)")
    conn = of_store.connect()
    sessions = [t for t in args.targets if not re.fullmatch(r"[0-9a-f]{64}", t)]
    shas = [t for t in args.targets if re.fullmatch(r"[0-9a-f]{64}", t)]
    t_ids, h_ids = [], []
    if args.from_scan:
        for line in open(args.from_scan):
            f = json.loads(line)
            (t_ids if f["table"] == "transcript_record" else h_ids).append(int(f["id"]))
    t_ids = sorted(set(t_ids) | set(of_redact.select(conn, sessions, shas)))
    h_ids = sorted(set(h_ids) | set(of_redact.select(conn, sessions, shas, table="hook_record")))
    if args.transcripts:  # the founder's option A: the harness's own files; dry run unless --apply
        live = set()
        try:
            for a in live_agents():
                live.add((a.get("agent_session") or {}).get("value"))
        except OfError:
            pass
        rep = of_redact.redact_transcripts(of_redact.transcript_files(), apply=args.apply, live_sessions=live)
        if rep["skipped_live"]:
            print(f"live sessions not touched ({len(rep['skipped_live'])}): stop them, or run again later")
        if args.json:
            print(json.dumps({"files": rep["files"], "changed": rep["changed"], "lines": rep["lines"],
                              "skipped_live": [os.path.basename(p)[:-6] for p in rep["skipped_live"]],
                              "skipped_recent": len(rep["skipped_recent"]),
                              "credentials": {k: len(v) for k, v in sorted(rep["credentials"].items())}}))
        return 0
    if args.resend:  # rows a local-only run redacted: send their masked copies to the servers now
        out = of_redact.resend(conn, args.reason, t_ids, h_ids)
        for table, reqs in out.items():
            print(f"{table}: {sum(r[2] for r in reqs)} row(s) in {len(reqs)} request(s): {[r[3] for r in reqs]}")
        return 0
    t_ids = of_redact.would_change(conn, t_ids)
    h_ids = of_redact.would_change(conn, h_ids, table="hook_record")
    e_ids = []
    for eid in args.event or []:  # events by event_id: their payload and record (of_redact.redact_events)
        row = conn.execute("SELECT rowid, payload, record FROM event WHERE event_id = ?", (eid,)).fetchone()
        if row and (of_store.redact_keys((row[1] or "").encode()) != (row[1] or "").encode()
                    or of_store.redact_keys((row[2] or "").encode()) != (row[2] or "").encode()):
            e_ids.append(row[0])
    print(f"rows the rules change: transcript_record {len(t_ids)}, hook_record {len(h_ids)}, event {len(e_ids)}")
    if args.dry_run or not (t_ids or h_ids or e_ids):
        return 0
    totals = {}
    for i in range(0, max(len(t_ids), len(h_ids), len(e_ids)), 300):  # chunks: the store's write lock is held briefly
        out = of_redact.run(conn, args.reason, t_ids[i:i + 300], h_ids[i:i + 300],
                            send_to_servers=not args.local_only, log=lambda m: None, event_ids=e_ids[i:i + 300])
        for table, s_ in out.items():
            t = totals.setdefault(table, [0, 0, 0])
            t[0] += s_["local"]
            t[1] += len(s_["requests"])
            t[2] += sum(1 for r in s_["requests"] if not str(r[3]).startswith(("queued", "done")))
    for table, (n, req, bad) in totals.items():
        print(f"{table}: {n} redacted here; {req} server request(s), {bad} failed")
    return 0


def _prompt_origins(conn, since, apply):
    """`of db prompt-origins`: of_hook.correct_prompt_origins, with a report."""
    import collections
    import of_hook
    seen, found, n = of_hook.correct_prompt_origins(conn, since, apply)
    by = collections.Counter(f[4] + " (" + f[5] + ")" for f in found)
    print(f"{seen} prompts recorded as the owner's since {since}; {len(found)} were not: "
          + ", ".join(f"{k} {v}" for v, k in ((v, k) for k, v in by.most_common())))
    for eid, sid, pos, org, fixed, to, txt in found[:15]:
        print(f"  {eid[-8:]} {pos or sid[:8]}: {fixed} | {txt}")
    print(f"{n} corrections written" if apply else "report only; --apply writes the corrections")
    return 0


def cmd_db(args):
    import of_store
    conn = of_store.connect()
    if args.action == "index":  # the lookups redaction and blob GC need (of_architect, 2026-11-06); once
        import time as _t
        for name, sql in (("transcript_blob", "CREATE INDEX IF NOT EXISTS transcript_blob ON transcript_record (blob_sha256)"),
                          ("hook_blob", "CREATE INDEX IF NOT EXISTS hook_blob ON hook_record (blob_sha256)")):
            if conn.execute("SELECT 1 FROM sqlite_master WHERE name = ?", (name,)).fetchone():
                print(f"{name}: exists")
                continue
            t0 = _t.time()
            with of_store.write_tx(conn):
                conn.execute(sql)
            print(f"{name}: built in {_t.time() - t0:.1f} s")
        return 0
    if args.action == "forks":  # build the uuid index once, then find every fork in the store
        if not of_store.has_uuid_index(conn):
            print("building the transcript_uuid index (once; writers wait or spool meanwhile)…")
            with of_store.write_tx(conn):
                conn.execute("CREATE INDEX IF NOT EXISTS transcript_uuid ON transcript_record (record_uuid)")
        with of_store.write_tx(conn):  # a full pass recomputes every mark
            conn.execute("DELETE FROM session_fork")
        found = of_store.detect_forks(conn, log=print)
        print(f"{len(found)} fork(s); copies left out of transcript_own: {sum(n for *_, n in found)} records")
        return 0
    if args.action == "prompt-origins":
        return _prompt_origins(conn, args.since, args.apply)
    st = of_store.stats(conn)
    size = os.path.getsize(of_store.db_path())
    print(f"{of_store.db_path()}: {size / 1e6:.1f} MB on disk")
    for k, v in st.items():
        print(f"  {k:<20} {v / 1e6:.1f} MB" if k.endswith("bytes") else f"  {k:<20} {v}")
    return 0


# ------------------------------------------------------------- enrollment

TIERS_TEXT = """What this machine would send to the organization's server:
  typed  events about the work: prompts and messages with secrets masked, asks, answers, timings,
         tokens, work records. Always on: it is what the organization's views are built from.
  raw    the full transcripts and hook payloads, unmasked, kept in the tenant's vault on that server.
         Off unless you say yes for that organization; you can turn it off later (`of consent`)."""


def _ttl(text):
    m = re.match(r"^(\d+)([hdm]?)$", str(text or "72h"))
    if not m:
        raise OfError("--ttl takes a number with h, d or m, e.g. 72h")
    return int(m.group(1)) * {"h": 3600, "d": 86400, "m": 60, "": 3600}[m.group(2)]


def set_org_servers(orgs, server, orgs_file=ORGS_FILE, raw_orgs=None):
    """Point these organizations at `server` in orgs.yaml (adding entries when missing); with
    raw_orgs, record the raw-tier consent per organization (`raw: true|false`), which `of ship`
    obeys on this machine before anything leaves it."""
    doc = {}
    if os.path.exists(orgs_file):
        with open(orgs_file) as fh:
            doc = yaml.safe_load(fh) or {}
    lst = doc.setdefault("orgs", [])
    for org in orgs:
        e = next((o for o in lst if o.get("name") == org), None)
        if e is None:
            e = {"name": org}
            lst.append(e)
        if server:
            e["server"] = server
        if raw_orgs is not None:
            e["raw"] = org in raw_orgs
    os.makedirs(os.path.dirname(orgs_file), mode=0o700, exist_ok=True)
    with open(orgs_file, "w") as fh:
        yaml.safe_dump(doc, fh, sort_keys=False, allow_unicode=True)


def cmd_invite(args):
    import of_client
    c = of_client.Client(args.server)
    r = c.invite(args.org, args.raw_allowed or [], _ttl(args.ttl), args.note, args.person)
    orgs = " ".join(f"--org {o}" for o in args.org)
    exp = r.get("expires_at") or r.get("expires")  # expires_at: the server's own text (of_server f4f5011)
    if isinstance(exp, (int, float)):
        import time as _t
        exp = _t.strftime("%Y-%m-%dT%H:%M:%SZ", _t.gmtime(exp))
    print(f"one-time invite for {', '.join(args.org)} (expires {exp}); give the person this command:\n")
    print(f"  of enroll {args.server} --code {r['code']} {orgs}\n")
    print("The code is shown only now and not stored.")
    return 0


def _resolve_address(name, positions):
    """'<org>:<position>' or a canonical name / alias, resolved through the registries. A target that fails the name
    rule, or that an organization listed here does not have, is refused with the nearest names, never queued
    (of_architect, 2026-11-06: 'org:pos --reply-to …' quoted as one argument was queued as a target)."""
    import difflib
    org, sep, pos = name.strip().rpartition(":")
    known = {p["_org"] for p in positions}

    def nearest(cands):
        near = difflib.get_close_matches(pos.split()[0] if pos.split() else pos, sorted(set(cands)), n=3, cutoff=0.5)
        return f"; nearest: {', '.join(near)}" if near else ""
    if sep and not NAME_RE.match(pos):
        raise OfError(f"{name!r} is not an address: {pos!r} breaks the name rule [a-z][a-z0-9_-]{{0,31}}"
                      + nearest(f"{p['_org']}:{p['name']}" for p in positions if p["_org"] == org))
    for p in positions:
        if (not sep or p["_org"] == org) and (pos == p["name"] or pos in [str(x) for x in p.get("aliases") or []]):
            return f"{p['_org']}:{p['name']}"
    if sep and org not in known:
        return name.strip()  # an organization this machine does not list: its server decides
    raise OfError(f"no position {pos!r} in {org or 'the registries'}" + (": use <org>:<position>" if not sep else "")
                  + nearest(p["name"] for p in positions if not sep or p["_org"] == org))


def pick_grants(grants_by_org, position, to_org, now=None, to_position=None):
    """Ids of the allow grants whose subject is `position`, whose scope's to_org covers `to_org` and, when the
    scope names to_positions (patterns of '<org>:<position>', fnmatch, as the relay checks them), covers
    `to_position` too; not expired or revoked."""
    import fnmatch
    import time as _t
    now = now or _t.strftime("%Y-%m-%dT%H:%M:%SZ", _t.gmtime())
    out = []
    for gs in grants_by_org.values():
        for g in gs or []:
            scope = g.get("scope") or {}
            orgs = scope.get("to_org")
            orgs = orgs if isinstance(orgs, list) else [orgs] if orgs else []
            pos = scope.get("to_positions")
            pos = pos if isinstance(pos, list) else [pos] if pos else []
            if pos and not (to_position and any(fnmatch.fnmatchcase(to_position, p) for p in pos)):
                continue  # this grant writes only to the named positions
            if g.get("subject") == position and g.get("effect", "allow") == "allow" and not g.get("revoked") \
                    and (to_org in orgs or "*" in orgs) and (not g.get("expires") or str(g["expires"]) > now):
                out.append(g.get("id"))
    return out


def cmd_send(args):
    """Send a message to a position on any machine, through its organization's server."""
    import of_client
    import of_events
    import of_grants
    import of_ship
    positions = _load_quiet()
    to = _resolve_address(args.to, positions)
    sender = args.sender
    if not sender:
        sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
        me = next((p for p in positions if session_of(p) and session_of(p) == sid), None)
        if not me:
            raise OfError("cannot tell which position is sending; pass --from <position>")
        sender = f"{me['_org']}:{me['name']}"
    elif ":" not in sender:
        sender = _resolve_address(sender, positions)
    grants = None
    to_org, from_org = to.split(":", 1)[0], sender.split(":", 1)[0]
    if not args.grant and to_org != from_org:  # across organizations: the sender's one grant for it, if it holds one
        picks = pick_grants(of_grants.load(), sender.split(":", 1)[-1], to_org, to_position=to)
        if len(picks) == 1:
            args.grant = picks[0]
        elif len(picks) > 1:
            raise OfError(f"several grants let {sender} write to {to_org}: {', '.join(picks)}; choose with --grant")
    if args.grant:
        by_id = {g.get("id"): g for gs in of_grants.load().values() for g in gs}
        chain, g = [], by_id.get(args.grant)
        while g is not None and len(chain) < 8:
            chain.append(g)
            g = next((x for x in by_id.values() if x.get("subject") == g.get("issuer")
                      and isinstance((x.get("scope") or {}).get("grants"), dict)), None)
        if not chain:
            raise OfError(f"no grant {args.grant} in the registries")
        grants = chain
    cfg = of_ship.config()
    servers, default = of_ship.org_servers(cfg), cfg["server_url"].rstrip("/")
    server = servers.get(to.split(":", 1)[0], default)
    client = of_client.Client(server)
    # `verified` needs this machine to present the sending position on the receiving server: PUT
    # presence first, with everything this machine holds for that server plus the sender.
    import of_relay_client
    try:
        local = of_relay_client.local_holders(positions, bind, live_agents_or_none(warn=False))
    except OfError:
        local = {}
    body = of_relay_client.presence_bodies(local, servers, default).get(server, [])
    if not any(f"{h['org']}:{h['position']}" == sender for h in body):
        org, pos = sender.split(":", 1)
        body.append({"org": org, "position": pos, "session_id": os.environ.get("CLAUDE_CODE_SESSION_ID"),
                     "state": "working", "pane": os.environ.get("HERDR_PANE_ID"), "kind": "agent"})
    client.put_presence(body)
    priority = "fyi" if getattr(args, "fyi", False) else ("urgent" if getattr(args, "urgent", False) else None)
    r = client.send_message(to, sender, args.text, args.reply_to, args.grant, grants, priority=priority)
    of_events.emit("agent_message_out", {"to": to, "to_position": to.split(":", 1)[1], "delivery": r.get("state"),
                                         "authority": r.get("authority"), "msg_id": r.get("msg_id"), "via": "relay",
                                         "chars": len(args.text)},
                   position=sender.split(":", 1)[1], session=os.environ.get("CLAUDE_CODE_SESSION_ID"))
    reason = f": {r['authority_reason']}" if r.get("authority_reason") else ""
    print(f"{r.get('state')}: {r.get('msg_id')} to {to} (authority: {r.get('authority')}{reason})"
          + (f" under grant {args.grant}" if args.grant else ""))
    if r.get("state") == "queued":  # say when nothing will deliver it (a new organization's install, 2026-11-11)
        org, pos = to.split(":", 1)
        try:
            pres = client.presence(org)
            held = {h.get("position") for h in ((pres.get("holders") if isinstance(pres, dict) else pres) or [])}
        except Exception:  # noqa: BLE001
            held = None
        if held is not None and pos not in held:
            print(f"warning: no running relay shows {to} as held on any machine, so nothing types this message in "
                  f"yet; it waits on the server until one does, and {pos} can read it now with `of inbox --mine`")
        elif any(f"{h['org']}:{h['position']}" == to for h in body):
            w = _relay_warning()
            if w:
                print(f"warning: {to} is held here and {w}")
    return 0


def cmd_inbox(args):
    """Messages to positions held by people on this machine; with --mine, the messages queued on the
    server for the agent that runs this command (no --from: only the holder reads its own queue)."""
    import of_relay_client as of_relay
    import of_store
    if args.mine or args.take or getattr(args, "taken", False):
        return _inbox_mine(args)
    conn = of_store.connect()
    of_relay.ensure_tables(conn)
    if args.action == "read":
        conn.execute("UPDATE inbox SET read_at = ? WHERE msg_id LIKE ? AND read_at IS NULL",
                     (__import__("of_events").now_iso(), (args.id or "") + "%"))
        return 0
    rows = conn.execute("SELECT msg_id, received_at, to_position, sender, authority, text, read_at FROM inbox "
                        + ("" if args.all else "WHERE read_at IS NULL ") + "ORDER BY received_at").fetchall()
    print(f"{len(rows)} message(s)")
    for mid, at, to, frm, auth, text, read in rows:
        print(f"\n{mid[:8]}  {at[:16]}  {frm} -> {to}  ({auth}){'  read' if read else ''}\n  {text}")
    return 0


def _inbox_mine(args):
    import of_client
    import of_relay_client as of_relay
    import of_ship
    positions = _load_quiet()
    me = _me(positions, getattr(args, "sender", None))
    if ((me.get("holder") or {}).get("runtime") or "") == "human":
        raise OfError(f"{me['name']} is held by a person: its messages are kept in `of inbox` on its machine "
                      "(--mine is an agent's own queue)")
    env_sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if getattr(args, "sender", None) and env_sid and session_of(me) and env_sid != session_of(me):
        # --from only says which position you are when the registry cannot (a shared lab registry); the proof stays
        # the session: a peer never reads another position's queue (of_lab, 2026-11-07)
        raise OfError(f"this session does not hold {me['name']} (its holder is session {session_of(me)[:8]}…)")
    session = env_sid or session_of(me)
    if not session:
        raise OfError(f"{me['name']}: no session to prove you hold it; run this from the holder's own session")
    key = f"{me.get('_org')}:{me['name']}"
    cfg = of_ship.config()
    url = of_ship.org_servers(cfg).get(me.get("_org")) or cfg["server_url"]
    busy = False
    try:  # is this agent's pane busy? A message the relay holds then waits for it; take it here instead
        for p, a in bind(positions, live_agents())[0]:
            if p["name"] == me["name"]:
                busy = a.get("agent_status") in ("working", "blocked")
    except Exception:  # noqa: BLE001
        pass
    if getattr(args, "taken", False):  # what was taken here, kept with its text (the server's masked copy)
        import time
        kept = of_relay.taken_messages(key)
        print(f"{len(kept)} message(s) taken for {me['name']} in the last 14 days")
        for at, m in kept:
            print(f"\n[taken {time.strftime('%Y-%m-%dT%H:%M', time.gmtime(at))}Z] {(m.get('created_at') or '')[:16]}\n"
                  f"{of_relay.header(m)}")
        return 0
    try:
        got = of_relay.pull(of_client.Client(url.rstrip("/")), key, session, take=args.take, pane_busy=busy)
    except Exception as e:  # noqa: BLE001 - the server's 403 says why (not the holder, or a person)
        raise OfError(f"of inbox --mine: {e}")
    if args.take and args.take != "all" and not any(t for _, t in got):
        raise OfError(f"no queued message for {me['name']} matches {args.take!r}")
    print(f"{len(got)} message(s) queued for {me['name']}" + ("" if args.take else
          " (listed, still queued: the relay types them in when you are idle; take them with --take <id>|all)"))
    for m, taken in got:
        if m.get("_note"):  # under a live lease: the relay is typing it in; act on it there, not here
            print(f"\n[{m['_note']}] {(m.get('created_at') or '')[:16]}  msg {m['msg_id']} from {m.get('from')}")
            continue
        tag = "taken" if taken else m.get("_new") or m.get("state") or "queued"
        print(f"\n[{tag}] {(m.get('created_at') or '')[:16]}\n{of_relay.header(m)}")
    return 0


def cmd_relay(args):
    import of_client
    import of_desk
    import of_relay_client as of_relay
    import of_ship
    if args.action in ("on", "off"):
        return _relay_service(args.action)
    cfg = of_ship.config()
    servers, default = of_ship.org_servers(cfg), cfg["server_url"].rstrip("/")
    clients = {}
    # a machine whose positions are held by people runs no herdr: no agents, people's inboxes still work
    stop, threads = of_relay.run(lambda: of_relay.local_holders(load_positions()[0], bind, live_agents_or_none(warn=False)),
                                 lambda u: clients.setdefault(u, of_client.Client(u)), servers, default,
                                 log=lambda m: print(m, flush=True))
    try:
        while not stop.is_set():
            stop.wait(3600)
    except KeyboardInterrupt:
        stop.set()
    return 0


RELAY_LABEL = "dev.organic-framework.relay"


def relay_alive():
    """Whether an `of relay run` process runs on this machine (True/False), or None when it cannot be told (no pgrep).
    A new organization's install, 2026-11-11: no relay ran, so a conductor's first message never arrived and nothing said so."""
    import subprocess
    try:
        r = subprocess.run(["pgrep", "-f", r"of relay run"], capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return None
    pids = [p for p in r.stdout.split() if p.isdigit() and int(p) != os.getpid()]
    return bool(pids)


def _relay_warning():
    """One line when no relay runs here, else None."""
    if relay_alive() is False:
        return ("no relay runs on this machine: messages to positions held here wait on the server and are never "
                "typed in; start it with `of relay on`, and until then read them with `of inbox --mine`")
    return None


def _relay_service(action):
    """`of relay on|off`: bootstrap or boot out the launchd unit (installed by of_server, modelled on
    the pulse). A relay started the old way (pid file) is stopped first: one poller per machine."""
    import subprocess
    plist = os.path.expanduser(f"~/Library/LaunchAgents/{RELAY_LABEL}.plist")
    target = f"gui/{os.getuid()}/{RELAY_LABEL}"
    old = _pid_stop("relay.pid")
    if old:
        print(f"of relay: stopped the pid-file relay (pid {old})")
    if action == "off":
        r = subprocess.run(["launchctl", "bootout", target], capture_output=True, text=True)
        print("of relay: off" if r.returncode == 0 else "of relay: was not loaded")
        return 0
    if not os.path.exists(plist):  # a machine set up before of init installed it (of_onboarding, 9b8f7e9)
        import of_init
        failed = of_init.install_units()
        if "relay" in failed:
            raise OfError("of relay on: the relay unit did not start; `of relay run` runs it in the foreground")
        print("of relay: installed and started its service")
        return 0
    subprocess.run(["launchctl", "bootout", target], capture_output=True)
    r = subprocess.run(["launchctl", "bootstrap", f"gui/{os.getuid()}", plist], capture_output=True, text=True)
    if r.returncode != 0:
        raise OfError(f"of relay on: launchctl bootstrap failed: {r.stderr.strip()[:200]}")
    p = subprocess.run(["launchctl", "print", target], capture_output=True, text=True)
    pid = next((ln.split("=")[1].strip() for ln in p.stdout.splitlines() if ln.strip().startswith("pid =")), "?")
    print(f"of relay: on ({RELAY_LABEL}, pid {pid}); log ~/.local/state/of/relay.log")
    return 0


def _pid_stop(name):
    import signal
    import of_events
    pf = os.path.join(of_events.STATE_DIR, name)
    try:
        pid = int(open(pf).read())
        os.kill(pid, signal.SIGTERM)
    except Exception:
        pid = None
    try:
        os.remove(pf)
    except FileNotFoundError:
        pass
    return pid


def _me(positions, explicit=None):
    """The position this process speaks for: --from, else this Claude session, else this herdr pane."""
    if explicit:
        p = next((x for x in positions if explicit == x["name"] or explicit in [str(a) for a in x.get("aliases") or []]), None)
        if not p:
            raise OfError(f"no position {explicit!r}")
        return p
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
    p = next((x for x in positions if sid and session_of(x) == sid), None)
    if p:
        return p
    pane = os.environ.get("HERDR_PANE_ID")
    if pane:
        try:
            for pos, a in bind(positions, live_agents())[0]:
                if a["pane_id"] == pane:
                    return pos
        except OfError:
            pass
    raise OfError("cannot tell which position you are; pass --from <position>")


def _work(org, wid):
    """--work <id>: the work must exist in the organization's works: (when it has one); returns the id."""
    if not wid:
        return None
    path = next((p for o, p, _ in org_registries() if o == org), None)
    works = None
    if path and os.path.exists(path):
        with open(path) as fh:
            works = (yaml.safe_load(fh) or {}).get("works")
    if works is not None and wid not in works:
        close = [w for w in works if wid in w or w in wid][:3]
        raise OfError(f"no work {wid!r} in {org}'s works:" + (f" (did you mean {', '.join(close)}?)" if close else ""))
    return wid


def _due(text, now=None):
    """--due: an ISO time (UTC unless it says otherwise) or +40m / +2h / +1d from now -> ISO UTC."""
    import datetime as dt
    now = now or dt.datetime.now(dt.timezone.utc)
    m = re.match(r"^\+(\d+)\s*([mhd])$", str(text).strip())
    if m:
        unit = {"m": "minutes", "h": "hours", "d": "days"}[m.group(2)]
        t = now + dt.timedelta(**{unit: int(m.group(1))})
    else:
        try:
            t = dt.datetime.fromisoformat(str(text).strip().replace("Z", "+00:00"))
        except ValueError:
            raise OfError(f"--due {text!r}: an ISO time (2026-11-06T15:00Z) or +40m / +2h / +1d")
        t = t if t.tzinfo else t.replace(tzinfo=dt.timezone.utc)
    return t.astimezone(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def cmd_ask(args):
    """An agent asks the founder (or a peer) something, visibly: an event plus a batched notification."""
    import of_events
    import of_pulse
    positions = _load_quiet()
    me = _me(positions, args.sender)
    opts = [o.strip() for o in (args.options or "").split("|") if o.strip()]
    if not args.question and not args.task:
        raise OfError('usage: of ask "<question>" [--options "a|b"] | of ask "<title>" --task "<steps>" [--command "…"]')
    import of_ask_text  # no estimate of effort or duration (founder, 2026-11-11)
    refusal = of_ask_text.check(args.question, opts, args.task)
    if refusal:
        raise OfError(refusal)
    import of_asks_chat  # where the person can do a task: phone, browser or machine (docs/remote.md §3 row 4)
    refusal = of_asks_chat.check_where(getattr(args, "where", None), args.task, args.command)
    if refusal:
        raise OfError(refusal)
    task = of_hook_mask(args.task) if args.task else None
    text = of_hook_mask(args.question or (task or "").strip().splitlines()[0][:200])
    import of_classify
    try:
        # declared tags are authoritative ('none' declares that no risk tag applies); guessed ones only without them
        tags_declared = bool(args.tags)
        tags = ([] if args.tags.strip().lower() == "none" else of_classify.parse_tags(args.tags)) if args.tags \
            else of_classify.tags_of(text, systems=[me["system"]] if me.get("system") else None)
    except ValueError as e:
        raise OfError(str(e))
    to, esc_rule, rerouted = route_ask(me, args.to, tags)
    src = _escalates(me, args.escalates) if args.escalates else None
    if src and to != "founder":
        raise OfError(f"--escalates: your asks go to {to}, not to the founder; answer {src['position']} yourself "
                      f"(of send {src['position']} --reply-to {src['event_id'][-8:]} …)")
    eid = of_events.emit("agent_question", {
        "detected_by": "declared", "source": "declared", "from_position": me["name"], "to": to, "tags": tags,
        "tags_declared": tags_declared,
        "context": _ask_context(me, args),
        "delegation": (me.get("_delegation") or {}).get("id") if (to != "founder" or esc_rule) else None,
        **({"escalate_rule": esc_rule} if esc_rule else {}), **({"asked_to": args.to} if rerouted else {}),
        "blocking": bool(args.blocking), "topic_key": _topic_key(text), **({"due": _due(args.due)} if args.due else {}),
        "questions": [{"question": text, "options": opts}], "classifications": {"q-v0": True, "q-v1": True},
        **({"task": True, "steps": task, "command": of_hook_mask(args.command) if args.command else None,
            "where": "machine" if args.command else (getattr(args, "where", None) or "machine")} if task else {}),
        **({"work": _work(me.get("_org"), args.work)} if args.work else {}),
        **({"escalated_from": src["event_id"]} if src else {})},
        position=me["name"], org=me.get("_orgid"), session=_asker_session(me, args.sender))
    if src:  # the unit owner's rewrite: OF's copy is superseded (of_asks), or there is none yet and none will come
        if src["state"] == "open":
            import of_asks_answer
            import of_store
            pl = of_asks_answer.ask_details(of_store.connect(), src["event_id"])[0]
            of_events.emit("ask_escalated", {"ask_id": src["event_id"], "from_owner": me["name"], "to": "founder",
                                             "rule": "by_owner", "delegation": pl.get("delegation")},
                           position=src["position"])
        print(f"your rewrite of {src['position']}'s ask {src['event_id'][-8:]} is the founder's card"
              + (" and replaces OF's copy" if src["state"] == "escalated" else "")
              + f"; his answer reaches you and {src['position']}.")
    esc_now = None
    if to != "founder" and eid:  # a rule that fires at filing escalates now, so the unit owner is told in the frame
        a = {"event_id": eid, "ts": _now_iso(), "state": "open", "to": to, "position": me["name"], "text": text,
             "kind": "question (declared)" + (" blocking" if args.blocking else ""), "tags": tags,
             "tags_declared": tags_declared}
        hit = of_pulse.escalations(positions, [a], __import__("time").time())
        if hit:
            esc_now = hit[0][1]
            of_pulse.escalate(*hit[0])
    try:  # show it in herdr: the `ask` token on the asker's pane (sidebar, red)
        import of_herdr_asks
        pane = of_herdr_asks.panes_by_position(positions, live_agents(), bind).get(me["name"])
        if pane:
            of_herdr_asks.set_ask(pane, text)
    except Exception:
        pass
    if rerouted:  # one line on where it went (of_architect, 577eb3c5)
        print(f"--to {args.to}: your unit {me.get('_unit')} is delegated, so this goes to its owner {to}; it reaches the "
              "founder at once only with a declared tag the delegation's escalate_when lists (of ask --tags …), "
              "otherwise by escalate_when later")
    elif esc_rule:
        print(f"asked the founder directly: the declared tag matches escalate_when {esc_rule!r} of delegation "
              f"{(me.get('_delegation') or {}).get('id')}; the unit owner {ask_target(me)} cannot decide it")
    if to != "founder":  # a delegated unit: the question goes to its owner position, in its pane
        _deliver_ask(positions, me, to, eid, text, opts, bool(args.blocking), esc_now)
        if esc_now:
            print(f"asked {to} (owner of unit {me.get('_unit')}, delegated){' (blocking)' if args.blocking else ''}, "
                  f"and escalated to the founder at once ({esc_now}); {to} is told and may rewrite it for him. "
                  "It stays open until answered; meanwhile carry on with other work.")
            _reconcile_ask_tokens(positions)
            return 0
        print(f"asked {to} (owner of unit {me.get('_unit')}, delegated){' (blocking)' if args.blocking else ''}; "
              "it reaches the founder only on the delegation's escalate_when. It stays open until answered; "
              "meanwhile carry on with other work.")
        _reconcile_ask_tokens(positions)
        return 0
    if to == "founder":
        of_pulse.queue_notice(f"{me['name']}: {text[:80]}")
        mem = of_pulse.load_memory()
        if of_pulse.flush_notices(mem, __import__("time").time()):
            of_pulse.save_memory(mem)
    _reconcile_ask_tokens(positions)
    if task:
        print(f"task for {to} (ask {eid[-8:] if eid else '?'}): it shows at the top of the popup under "
              f"'{tr('To do for you')}'. "
              "An answer or a reply does not close it: check the result yourself, then "
              f"`of status working --done-task {eid[-8:] if eid else '<id>'}` (or --reopen-task with what you still see).")
        return 0
    print(f"asked {to}{' (blocking)' if args.blocking else ''} (ask {eid[-8:] if eid else '?'}); it shows in `of asks` "
          "and stays open until answered. Meanwhile carry on with other work. When the answer reaches you elsewhere, "
          f"run `of status working --answered {eid[-8:] if eid else '<id>'}`.")
    return 0


# ------------------------------------------------------------------- pinned views

def cmd_view(args):
    """Pinned views (bin/of_views.py): of view list|apply <name>|add <name> ...|remove <name>."""
    import of_views
    views = of_views.load()
    by = {v["name"]: v for v in views}
    if args.action == "list":
        for v in views:
            print(f"  {v['name']:<12} {v.get('workspace')}/{v.get('tab')}  {v.get('layout', 'main-left-60'):<13} "
                  f"{', '.join(v.get('positions') or [])}")
        print(f"{len(views)} view(s) in {of_views.path()}")
        return 0
    if not args.name:
        raise OfError(f"usage: of view {args.action} <name>")
    if args.action == "remove":
        if args.name not in by:
            raise OfError(f"no view {args.name!r}")
        of_views.save([v for v in views if v["name"] != args.name])
        print(f"removed view {args.name}")
        return 0
    if args.action == "add":
        v = {"name": args.name, "workspace": args.workspace, "tab": args.tab or args.name,
             "layout": args.layout or "main-left-60", "positions": [x.strip() for x in (args.positions or "").split(",") if x.strip()]}
        probs = of_views.check(v, {p["name"] for p in _load_quiet()})
        if probs:
            raise OfError("; ".join(probs))
        of_views.save([x for x in views if x["name"] != args.name] + [v])
        print(f"view {args.name}: {v['workspace']}/{v['tab']} {v['layout']} {', '.join(v['positions'])}; "
              f"now `of view apply {args.name}`")
        return 0
    if args.name not in by:
        raise OfError(f"no view {args.name!r} (of view list)")
    return view_apply(by[args.name], dry_run=args.dry_run, quiet=args.quiet)


def view_apply(v, dry_run=False, quiet=False):
    """Build or restore a view's tab: its live panes, in its order and layout. Returns 0 if it holds."""
    import of_views
    positions = _load_quiet()
    agents = live_agents()
    pane_of = {p["name"]: a["pane_id"] for p, a in bind(positions, agents)[0]}
    say = (lambda m: None) if quiet else print
    if v.get("panels"):
        first = next((pane_of[n] for n in v.get("positions") or [] if n in pane_of), None)
        pane_of.update({f"panel:{k}": x for k, x in _panel_panes(
            v, herdr_json("pane", "list")["panes"], dry_run, say, anchor=first).items()})
    panes = [pane_of[n] for n in v.get("positions") or [] if n in pane_of]
    missing = [n for n in v.get("positions") or [] if n not in pane_of]
    for n in missing:
        say(f"  {n}: no live pane; left out")
    workspaces = herdr_json("workspace", "list")["workspaces"]
    ws = next((w for w in workspaces if w.get("label") == v["workspace"]), None)
    tabs = herdr_json("tab", "list")["tabs"]
    tab = next((t for t in tabs if ws and t["workspace_id"] == ws["workspace_id"] and base_label(t.get("label")) == v["tab"]), None)
    if tab and panes:
        lay = herdr_json("pane", "layout", "--pane", panes[0])["layout"] if \
            next((a for a in agents if a["pane_id"] == panes[0] and a.get("tab_id") == tab["tab_id"]), None) else None
        if of_views.matches(v, lay, panes):
            say(f"view {v['name']}: in place ({len(panes)} panes)")
            return 0
    # the view's tab exists and holds its first pane: lay the others out in it, never by a new tab, which empties
    # and closes the tab the founder may be looking at (hand-over 3c7e6f17)
    in_tab = bool(tab and panes and herdr_json("pane", "get", panes[0])["pane"].get("tab_id") == tab["tab_id"])
    cmds = of_views.plan_moves(v, panes, workspace_id=ws["workspace_id"] if ws else None, in_tab=in_tab)
    if dry_run:
        for c in cmds:
            say("would run: herdr " + " ".join(c))
        return 0
    ok, tab_id = True, None
    for c in cmds:
        if "{TAB}" in c:
            if not tab_id:
                tab_id = herdr_json("pane", "get", panes[0])["pane"]["tab_id"]
            c = [tab_id if x == "{TAB}" else x for x in c]
        ok = herdr_do(c, False) and ok
    # a pane moved to another workspace gets a new id: read them again before checking
    pane_of = {p["name"]: a["pane_id"] for p, a in bind(positions, live_agents())[0]}
    if v.get("panels"):
        pane_of.update({f"panel:{k}": x for k, x in _panel_panes(v, herdr_json("pane", "list")["panes"], True,
                                                                  lambda m: None).items()})
    panes = [pane_of[n] for n in v.get("positions") or [] if n in pane_of]
    lay = herdr_json("pane", "layout", "--pane", panes[0])["layout"] if panes else None
    held = of_views.matches(v, lay, panes)
    say(f"view {v['name']}: {'laid out' if held else 'laid out, but the sizes differ from the layout'} "
        f"({len(panes)} panes)")
    if lay and not held:
        for p in lay.get("panes") or []:
            say(f"    {p['pane_id']}: {p['rect']}")
    return 0 if ok and held else 1


# ------------------------------------------------------------------- the listener

LISTEN_LABEL = "dev.organic-framework.listen"


def cmd_listen(args):
    """The listener (RFC 0001 §5.1a): of listen run|rebuild|status|install|uninstall."""
    import of_listen
    import of_store
    if args.action == "status":
        conn = of_store.connect()
        conn.executescript(of_listen.DDL)
        live = of_listen.fresh(conn)
        print(f"of listen: {'live' if live else 'not running (the CLI computes from the log)'}")
        top = conn.execute("SELECT max(rowid) FROM event").fetchone()[0] or 0
        for name, ver, last, at in conn.execute("SELECT processor, version, last_rowid, updated_at FROM listener_cursor"):
            print(f"  {name}@{ver}: at event {last} of {top} ({top - last} behind), {at}")
        return 0
    if args.action in ("run", "rebuild"):
        return of_listen.run(log=lambda m: print(m, flush=True), rebuild=args.action == "rebuild") or 0
    import platform
    if platform.system() != "Darwin":
        raise OfError("of listen install: launchd only for now (systemd: run `of listen run` under your init)")
    plist = os.path.expanduser(f"~/Library/LaunchAgents/{LISTEN_LABEL}.plist")
    target = f"gui/{os.getuid()}/{LISTEN_LABEL}"
    subprocess.run(["launchctl", "bootout", target], capture_output=True)
    if args.action == "uninstall":
        if os.path.exists(plist):
            os.remove(plist)
        print("of listen: uninstalled")
        return 0
    import of_events
    log = os.path.join(of_events.STATE_DIR, "listen.log")
    with open(plist, "w") as fh:
        fh.write(f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>{LISTEN_LABEL}</string>
  <key>ProgramArguments</key><array><string>{sys.executable}</string><string>{os.path.realpath(__file__)}</string>
    <string>listen</string><string>run</string></array>
  <key>EnvironmentVariables</key><dict><key>OF_AUTOMATION</key><string>1</string><key>SSH_AUTH_SOCK</key><string></string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>Nice</key><integer>5</integer>
  <key>StandardOutPath</key><string>{log}</string>
  <key>StandardErrorPath</key><string>{log}</string>
</dict></plist>
""")
    import time as _t
    for attempt in range(4):  # right after a bootout launchd may answer "Input/output error" for a moment
        r = subprocess.run(["launchctl", "bootstrap", f"gui/{os.getuid()}", plist], capture_output=True, text=True)
        if r.returncode == 0:
            break
        _t.sleep(1.5)
    else:
        raise OfError(f"of listen install: launchctl bootstrap failed: {r.stderr.strip()[:200]}")
    print(f"of listen: installed and started ({plist}); log {log}")
    return 0


# ------------------------------------------------------------------- structural diffs

def _diff_registry(org):
    regs = {o: (p, w) for o, p, w in org_registries()}
    if org not in regs:
        raise OfError(f"organization {org!r} is not in orgs.yaml")
    return regs[org][0]


def _diff_check(d):
    """(problems, notes, new registry text, registry path, briefs)."""
    import shutil
    import tempfile
    import of_diff
    notes = []
    try:
        import of_measures
        catalogue = set(getattr(of_measures, "CATALOGUE", ()) or ()) or None
    except Exception:
        catalogue = None
    if catalogue is None:
        notes.append("metric names not checked: of_studio's measures catalogue is not published yet")
    problems = of_diff.check_format(d, catalogue)
    if problems and any(x.startswith(("kind", "org is")) for x in problems):
        return problems, notes, None, None, []
    path = _diff_registry(d["org"])
    with open(path) as fh:
        text = fh.read()
    new, more = of_diff.preview(d, text)
    problems += more
    _, briefs, _ = of_diff.plan(d, yaml.safe_load(text) or {})
    repo = os.path.dirname(os.path.dirname(path))
    for b in briefs:  # v2: a rule line in the organization's AGENTS.md needs its anchor there, exactly once
        if b.get("op") == "insert_line":
            try:
                with open(os.path.join(repo, b["path"])) as fh:
                    of_diff.insert_line(fh.read(), b["after"], b["text"])
            except (OSError, ValueError) as e:
                problems.append(f"changes.agents_md: {b['path']}: {e}")
    # the registry as it would be: the same checks `of registry check` runs, on a copy
    before = set(load_positions()[1])
    with tempfile.TemporaryDirectory() as tmp:
        root = os.path.join(tmp, "org")
        os.makedirs(os.path.join(root, "registry"))
        with open(os.path.join(root, "registry", "positions.yaml"), "w") as fh:
            fh.write(new)
        with open(ORGS_FILE) as fh:
            orgs = yaml.safe_load(fh) or {}
        for o in orgs.get("orgs") or []:
            if o.get("name") == d["org"]:
                o["path"] = root
        tmp_orgs = os.path.join(tmp, "orgs.yaml")
        with open(tmp_orgs, "w") as fh:
            yaml.safe_dump(orgs, fh)
        after = load_positions(tmp_orgs)[1]
        shutil.rmtree(root, ignore_errors=True)
    problems += [f"registry after the change: {x}" for x in after if x not in before]
    return problems, notes, new, path, briefs


def _diff_events(conn):
    rows = conn.execute("SELECT ts, name, payload FROM event WHERE name IN ('of.diff_proposed', 'of.diff_approved', "
                        "'of.diff_applied', 'of.diff_rejected') ORDER BY ts, rowid").fetchall()
    out = {}
    for ts, name, pl in rows:
        p = json.loads(pl or "{}")
        e = out.setdefault(p.get("id"), {"id": p.get("id"), "state": None, "digest": None, "diff": None})
        if name == "of.diff_proposed":
            e.update(state="proposed", digest=p.get("digest"), diff=p.get("diff"), proposed_at=ts, ask=p.get("ask_id"))
        elif name == "of.diff_approved" and p.get("digest") == e.get("digest"):
            e.update(state="approved", approved_at=ts)
        elif name == "of.diff_rejected":
            e.update(state="rejected")
        elif name == "of.diff_applied":
            e.update(state="applied", applied_at=ts, review_due=p.get("review_due"), diff=e.get("diff") or p.get("diff"))
    return out


def _diff_approved_by_answer(conn, ask_id):
    """An owner's popup answer `approve…` to the diff's ask counts as the approval: only the popup's (`via:
    asks-ui`), which the owner clicks at the machine. An answer recorded through the conductor's chat (`via:
    conductor`) or any other path never does: it would apply any tier past the terminal approval and the remote hold
    (after-the-fact review of 2026-11-11, finding 1; organic-framework-build release/reviews)."""
    if not ask_id:
        return False
    import of_locale
    words = sorted({v.lower() for k in ("approve", "yes") for v in of_locale.variants(k)}, key=len, reverse=True)
    # a whole word in any of OF's languages: an answer that only starts like one ("let me think" in Russian) is no yes
    # (review 2026-11-11, PR 2 follow-up, of_server)
    yes = re.compile(r"^\s*(?:" + "|".join(re.escape(w) for w in words) + r")(?!\w)", re.I)
    for (pl,) in conn.execute("SELECT payload FROM event WHERE name = 'of.agent_question_answered'"):
        p = json.loads(pl or "{}")
        if ask_id in (p.get("ask_ids") or [p.get("ask_id")]) and p.get("by") == "owner" and \
                p.get("via") == "asks-ui" and yes.match(str(p.get("answer") or "")):
            return True
    return False


def cmd_diff(args):
    import of_diff
    import of_events
    import of_store
    conn = of_store.connect()
    if args.action == "list":
        for e in _diff_events(conn).values():
            d = e.get("diff") or {}
            print(f"  {e['id']:<40} {e['state']:<9} {d.get('kind', ''):<16} {d.get('org', ''):<24} "
                  f"{str(e.get('digest') or '')[:8]:<9}"  # the yes from the chat may name it (docs/remote.md)
                  f"{('review ' + e['review_due']) if e.get('review_due') else ''}")
        return 0
    if not args.target:
        raise OfError(f"usage: of diff {args.action} <file|id>")
    if args.action == "approve" and getattr(args, "prompt", None):  # docs/remote.md §3 row 2
        e = _diff_events(conn).get(args.target)
        if not e or e["state"] != "proposed":
            raise OfError(f"no proposed diff {args.target!r} (of diff list)")
        why, prompt = _remote_approval(conn, e, args.prompt, _load_quiet())
        if why:
            raise OfError(f"not approved: {why}")
        d = e["diff"]
        of_events.emit("diff_approved", {"id": d["id"], "digest": e["digest"], "by": "owner", "via": "remote",
                                         "prompt": prompt["event_id"], "session": prompt["session_id"],
                                         "machine": of_events.machine_id()})
        print(f"approved {d['id']} on the owner's words in prompt {args.prompt[-8:]}; its author applies it with "
              f"`of diff apply {d['id']}`")
        return 0
    if args.action == "approve":
        import sys as _s
        if os.environ.get("CLAUDE_CODE_SESSION_ID") or os.environ.get("OF_AUTOMATION") or not _s.stdin.isatty():
            raise OfError("only the owner approves, from a terminal: not from an agent session or a script; from "
                          "the owner's conductor, `--prompt <event id>` of their recorded yes (docs/remote.md)")
        e = _diff_events(conn).get(args.target)
        if not e or e["state"] != "proposed":
            raise OfError(f"no proposed diff {args.target!r} (of diff list)")
        d = e["diff"]
        print(f"{d['id']} ({d['kind']}, tier {d['tier']}) by {d['author']}\n  {d['hypothesis']}")
        typed = input("Type the diff id to approve it: ").strip()
        if typed != d["id"]:
            print("not approved")
            return 1
        of_events.emit("diff_approved", {"id": d["id"], "digest": e["digest"], "by": "owner",
                                         "machine": of_events.machine_id()})
        print(f"approved {d['id']}; its author applies it with `of diff apply {d['id']}`")
        return 0
    if os.path.exists(args.target):
        d = of_diff.load(args.target)
    else:
        e = _diff_events(conn).get(args.target)
        if not e:
            raise OfError(f"no diff file or proposed diff {args.target!r}")
        d = e["diff"]
    problems, notes, new, path, briefs = _diff_check(d)
    for n in notes:
        print(f"note: {n}")
    for pr in problems:
        print(f"problem: {pr}")
    if problems:
        print(f"{d.get('id')}: {len(problems)} problem(s)")
        return 1
    if args.action == "check":
        print(f"{d['id']}: ok ({d['kind']}, tier {d['tier']}; {path})")
        return 0
    dg = of_diff.digest(d)
    if args.action == "propose":
        pos = _me(_load_quiet(), args.sender)
        me, sid = pos["name"], _asker_session(pos, args.sender)
        if not args.ask and d["tier"] in ("medium", "high"):
            raise OfError(f"{d['id']} is tier {d['tier']}: the owner gets a hand-written ask, never one generated "
                          "from the hypothesis. Pass --ask \"<the decision in one line, why now, context, options>\" "
                          "in the owner's language (AGENTS.md, Asking the founder)")
        if args.ask:  # the owner's own language and a question that stands on its own (AGENTS.md); the
            # diff file stays an English document, and its hypothesis stays in the event (acme_org, 2026-11-06)
            q = (f"{of_hook_mask(args.ask).strip()}\n\n(diff {d['id']}, {d['kind']}, tier {d['tier']}; "
                 + tr("in a terminal: of diff approve {id}", id=d['id']) + ")")
        else:
            q = (f"Structural diff {d['id']} ({d['kind']}, tier {d['tier']}) from {me}: {d['hypothesis']} "
                 f"Approve? (or in a terminal: of diff approve {d['id']})")
        import of_ask_text  # no estimate of effort or duration on his card (founder, 2026-11-11)
        refusal = of_ask_text.check(q)
        if refusal:
            raise OfError(refusal)
        ask = of_events.emit("agent_question", {
            "detected_by": "declared", "source": "declared", "from_position": me, "to": "founder", "blocking": False,
            "topic_key": d["id"], "diff_id": d["id"], "hypothesis": d.get("hypothesis"),
            "questions": [{"question": q, "options": ["approve", "reject"]}],
            "classifications": {"q-v0": True, "q-v1": True}}, position=me, org=pos.get("_orgid"), session=sid)
        of_events.emit("diff_proposed", {"id": d["id"], "kind": d["kind"], "tier": d["tier"], "org": d["org"],
                                         "author": d["author"], "digest": dg, "diff": d, "ask_id": ask},
                       position=me, org=pos.get("_orgid"), session=sid)
        print(f"proposed {d['id']} (digest {dg}); the owner approves it on card {(ask or '?')[-8:]} in the asks popup "
              "or with `of diff approve`")
        return 0
    if args.action == "apply":
        e = _diff_events(conn).get(d["id"]) or {}
        if e.get("state") == "applied":
            raise OfError(f"{d['id']} was applied already")
        if d["tier"] != "low":
            if e.get("digest") != dg:
                raise OfError(f"{d['id']} is not proposed in this exact form: `of diff propose` it first")
            if e.get("state") != "approved" and not _diff_approved_by_answer(conn, e.get("ask")):
                raise OfError(f"{d['id']} waits for the owner's approval")
        repo = os.path.dirname(os.path.dirname(path))
        written = [path]
        with open(path, "w") as fh:
            fh.write(new)
        for b in briefs:
            target = os.path.join(repo, b["path"])
            if b.get("op") == "insert_line":  # v2: one line into AGENTS.md after its anchor, the rest untouched
                with open(target) as fh:
                    before = fh.read()
                after = of_diff.insert_line(before, b["after"], b["text"])
                if after != before:
                    with open(target, "w") as fh:
                        fh.write(after)
                    written.append(target)
                continue
            body = b.get("text")
            if body is None:
                with open(os.path.join(repo, b["from"])) as fh:
                    body = fh.read()
            os.makedirs(os.path.dirname(target), exist_ok=True)
            with open(target, "w") as fh:
                fh.write(body if body.endswith("\n") else body + "\n")
            written.append(target)
        due = of_diff.review_due(d)
        of_events.emit("diff_applied", {"id": d["id"], "kind": d["kind"], "tier": d["tier"], "org": d["org"],
                                        "digest": dg, "files": [os.path.relpath(w, repo) for w in written],
                                        "review_due": due, "predicted": d.get("predicted"),
                                        "continuation": d.get("continuation"), "diff": d})
        try:
            import of_lifecycle
            positions = load_positions()[0]
            of_lifecycle.record(conn, positions, live_agents_or_none(warn=False), bind)
        except Exception as e2:
            print(f"model: not recorded ({e2})", file=sys.stderr)
        print(f"applied {d['id']}: " + ", ".join(os.path.relpath(w, repo) for w in written) + f" in {repo}")
        print((f"review due {due}. " if due else "") +
              "The structure keeper commits it there (git add those files; Position trailer).")
        if d.get("continuation"):
            print("continuation (not automated in v1): " + json.dumps(d["continuation"], ensure_ascii=False))
        return 0
    return 2


# ------------------------------------------------------------------- issues

ISSUE_LABELS = ("true_positive", "false_positive", "true_but_not_now", "wrong_remedy")


def cmd_issues(args):
    """`of issues [list]` shows of_studio's diagnosed issues; `of issues label <id> <label>` writes the
    owner's label, the only stored kind of the catalogue (docs/diagnose.md): of.issue_labelled."""
    import of_events
    if args.action == "list":
        import of_studio_cli
        return of_studio_cli.main(["model", "issues", "--org", args.org or "all"] + (["--json"] if args.json else []))
    if not args.id or args.label not in ISSUE_LABELS:
        raise OfError(f"usage: of issues label <issue id> {'|'.join(ISSUE_LABELS)} [--note \"…\"]")
    # every organization's issues: an id from one organization's keeper digest labels without --org (2026-11-11)
    r = subprocess.run([sys.executable, os.path.realpath(__file__), "model", "issues", "--json", "--org", args.org or "all"],
                       capture_output=True, text=True, timeout=300)
    try:
        issues = json.loads(r.stdout)["issues"]
    except (ValueError, KeyError):
        raise OfError(f"cannot read the diagnosed issues: {(r.stderr or r.stdout).strip()[:200]}")
    hits = [i for i in issues if i["issue_id"] == args.id or i["issue_id"].startswith(args.id)]
    if len({i.get("org") for i in hits}) > 1:
        raise OfError(f"{args.id!r} is open in {', '.join(sorted({i['org'] for i in hits}))}: add --org <organization>")
    if len(hits) != 1 and not (args.rule_version and args.id):
        raise OfError(f"no single open issue matches {args.id!r}" + ("" if hits else
                      "; for an issue no longer open pass --rule-version ap.<rule>@<n>, the full id and --org"))
    i = hits[0] if len(hits) == 1 else {"issue_id": args.id, "rule_version": args.rule_version,
                                         "rule": args.rule_version.split("@")[0], "org": args.org}
    # who labels: the owner (a shell that is no agent's session) or a position the owner delegates (--from)
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if args.sender or sid:
        by = _me(_load_quiet(), args.sender)["name"]
    else:
        by = "owner"
    payload = {"issue_id": i["issue_id"], "rule": i.get("rule"), "rule_version": i.get("rule_version"),
               "label": args.label, "by": by}
    if args.note:
        payload["note"] = of_hook_mask(args.note)
    # the issue's organization: the owner's label has no position to resolve it from, and its model must see it
    of_events.emit("issue_labelled", payload, position=None if by == "owner" else by, org=i.get("org"))
    print(f"labelled {i['issue_id']} ({i.get('rule_version')}{', ' + i['org'] if i.get('org') else ''}): {args.label} by {by}")
    return 0


# ------------------------------------------------------------------- hand-overs

def _resolve_position(ref, positions, me=None):
    """A position's canonical name (name or alias). `org:name` stays as given only for another organization than
    the caller's; the caller's own organization's address is its bare name (the parties compare by name)."""
    if ":" in ref:
        org, _, name = ref.partition(":")
        if not me or org not in (me.get("_org"), me.get("_orgid")):
            return ref
        ref = name
    p = next((x for x in positions if ref == x["name"] or ref in [str(a) for a in x.get("aliases") or []]), None)
    if not p:
        raise OfError(f"no position {ref!r}; for another organization use org:name")
    return p["name"]


def _handover_offer(h, positions, agents=None, wait_s=5):
    """Type the hand-over into the receiver's pane if it is local and idle; record the offer."""
    import of_events
    import of_handover
    import of_relay_client
    to = of_handover.short(h["to"])
    agents = live_agents() if agents is None else agents
    pane = next((a["pane_id"] for p, a in bind(positions, agents)[0] if p["name"] == to), None)
    if not pane:
        return False
    ok, _ = of_relay_client.herdr_deliver(pane, of_handover.offer_text(h), None, f"of-handover:{h['from']}",
                                          wait_s=wait_s)
    if ok is True:
        rec = of_events.record("handover_offered", {"id": h["id"], "to": h["to"], "pane": pane}, position=to)
        rec["of.event.id"] = of_handover.event_id(h["id"], "offered")
        of_events.append(rec)
    return ok


def cmd_handover(args):
    """Hand-overs between positions (docs/handover.md §1): propose, answer, deliver, verify, close."""
    import of_events
    import of_handover
    import of_store
    positions = _load_quiet()
    conn = of_store.connect()
    hos = of_handover.project(of_handover.load(conn))
    if args.action in ("list", None):
        rows = [h for h in hos.values() if args.all or h["state"] in of_handover.OPEN]
        if args.json:
            print(json.dumps(rows, ensure_ascii=False, indent=1))
            return 0
        for h in sorted(rows, key=lambda h: h["proposed_at"]):
            print(f"  {h['id'][-8:]}  {h['state']:<10} {h['from']:<22} -> {h['to']:<22} "
                  f"{'!' if h['priority'] == 'blocking' else ' '} {h['title'][:60]}"
                  + (f"\n            basis: {h['basis'][:100]}" if h.get("basis") else "")
                  + "".join(f"\n            note from {n['by']}: {(n['note'] or '')[:100]}" for n in h.get("notes") or []))
        print(f"{len(rows)} hand-over(s)" + ("" if args.all else " open"))
        return 0
    me_p = _me(positions, args.sender)
    me = me_p["name"]
    if args.action == "propose":
        if not args.ref or not args.title:
            raise OfError('usage: of handover propose <position> "<title>" --done-when "<checkable criteria>"')
        if not args.done_when:
            raise OfError("--done-when is required: checkable criteria (tests pass, a PR merged, a file exists)")
        basis = getattr(args, "basis", None)
        why = of_handover.basis_problem(basis, args.title, args.done_when)  # docs/handover.md §1.1
        if why:
            raise OfError(why)
        to = _resolve_position(args.ref, positions, me_p)
        verify = _resolve_position(args.verify, positions, me_p) if args.verify not in (None, "requester") else "requester"
        scope = {k: v for k, v in (("systems", args.systems), ("paths", args.paths)) if v}
        payload = {"from": me, "to": to, "title": of_hook_mask(args.title), "done_when": of_hook_mask(args.done_when),
                   "verify": verify, "due": args.due, "priority": "blocking" if args.blocking else "normal",
                   "mandate": args.mandate or next((p.get("mandate") for p in positions if p["name"] == me), None),
                   "scope": scope or None, "context": args.context or []}
        if basis:
            payload["basis"] = of_hook_mask(basis.strip())
        rec = of_events.record("handover_proposed", payload, position=me)
        payload["id"] = rec["of.event.id"]
        rec["of.payload"]["id"] = rec["of.event.id"]  # record() keeps its own JSON-safe copy of the payload
        of_events.append(rec)
        rows = of_handover.load(conn)
        if not any(r["event_id"] == payload["id"] for r in rows):  # spooled (a busy store): project from it as is
            rows.append({"event_id": payload["id"], "ts": rec["timestamp"], "name": "of.handover_proposed",
                         "position": me, "payload": rec["of.payload"]})
            print("the store is busy: the hand-over is spooled and lands in the store with the next ingest")
        h = of_handover.project(rows)[payload["id"]]
        offered = ":" not in to and _handover_offer(h, positions, wait_s=2)
        print(f"proposed {payload['id'][-8:]} to {to}" + (" (offered in its pane)" if offered else
              " (the pulse offers it when its pane is idle)"))
        if args.blocking:
            print(f"you wait on {to}: run `of status waiting --on {to}` at the end of your turn")
        return 0
    if not args.ref:
        raise OfError(f"usage: of handover {args.action} <id>")
    h = of_handover.find(hos, args.ref)
    if not h:
        raise OfError(f"no single hand-over matches {args.ref!r}")
    kind = {"accept": "accepted", "decline": "declined", "block": "blocked", "deliver": "delivered",
            "verify": "verified", "reject": "rejected", "close": "closed", "return": "returned",
            "withdraw": "withdrawn", "note": "noted"}[args.action]
    why = of_handover.check(h, kind, me, me_p.get("_org"))
    if why:
        raise OfError(why)
    if kind in ("declined", "returned", "rejected", "noted") and not args.note:
        raise OfError(f"{args.action} needs --note" + (" with the text" if kind == "noted" else " with the reason"))
    if kind == "delivered" and not args.result:
        raise OfError("deliver needs --result (a PR, a file, a report)")
    if kind == "blocked" and not args.on:
        raise OfError("block needs --on founder|<position>|external:<what>")
    payload = {"id": h["id"], "by": me, "note": of_hook_mask(args.note) if args.note else None,
               "result": args.result, "on": args.on, "from": h["from"], "to": h["to"]}
    rec = of_events.record(f"handover_{kind}", {k: v for k, v in payload.items() if v is not None}, position=me)
    rec["of.event.id"] = of_handover.event_id(h["id"], kind, len(h.get("notes") or []) if kind == "noted" else
                                              sum(1 for x in h["history"] if x[1] == kind))
    of_events.append(rec)
    state = of_handover.project(of_handover.load(conn))[h["id"]]["state"]
    print(f"{h['id'][-8:]}: {kind} -> {state}")
    if kind == "verified" and args.close:
        rec = of_events.record("handover_closed", {"id": h["id"], "by": me}, position=me)
        rec["of.event.id"] = of_handover.event_id(h["id"], "closed")
        of_events.append(rec)
        print(f"{h['id'][-8:]}: closed")
    return 0


def _ask_context(me, args):
    """What the asker is doing, captured when it asks (the card shows it above the question): its
    current mandate, its system, its last message and its last turns in short, links."""
    out = {"system": me.get("system"), "mandate": {"summary": me.get("summary"), "brief": me.get("mandate")}}
    try:
        import of_asks_answer
        import of_store
        conn = of_store.connect()
        sid = None if args.sender else os.environ.get("CLAUDE_CODE_SESSION_ID")
        sid = sid or session_of(me)
        if sid:
            last, _ = of_asks_answer.transcript_context(conn, sid, of_events_now())
            out["last_message"] = (last or "")[-3000:]
            turns = [json.loads(pl or "{}").get("last_message") or "" for (pl,) in conn.execute(
                "SELECT payload FROM event WHERE name = 'of.turn_end' AND session_id = ? ORDER BY ts DESC LIMIT 3", (sid,))]
            out["recent_turns"] = [_thesis(t) for t in reversed(turns) if t.strip()]
            out["links"] = of_asks_answer.links(last or "", " ".join(turns))
    except Exception:  # noqa: BLE001 - an ask is never lost for want of its context
        pass
    return out


def of_events_now():
    import of_events
    return of_events.now_iso()


def _thesis(text, n=160):
    """The first sentence of a turn's last message, as a short thesis."""
    t = " ".join((text or "").split())
    m = re.match(r"^(.{20,%d}?[.!?…])(\s|$)" % n, t)
    return (m.group(1) if m else t[:n]).strip()


def ask_target(p):
    """Who a position's `of ask` goes to by default: the owner of its unit when the unit is delegated
    (an agent or a colleague's position), else the founder. The unit owner asks the founder."""
    d = p.get("_delegation")
    owner = p.get("_unit_owner")
    if d and owner and owner != p["name"]:
        return owner
    return "founder"


def _asker_session(me, sender=None):
    """The session an ask is filed in: the caller's own (CLAUDE_CODE_SESSION_ID), else the position's holder; with
    --from, the holder's. The hook lists a session's open asks and the judge counts them by it (acme_org, 2026-11-10:
    of diff propose filed its card with no session, and the judge told acme_org to file it again)."""
    return session_of(me) if sender else (os.environ.get("CLAUDE_CODE_SESSION_ID") or session_of(me))


def route_ask(me, to_arg, tags):
    """(to, escalate rule, rerouted) for an ask. In a delegated unit `--to founder` goes to the unit owner, unless a
    declared tag matches the delegation's reporting.escalate_when (money, irreversible, security_incident, a matching
    prod_change): those go to the founder at once, because the unit owner cannot decide them. Nothing is refused, so
    no ask is lost (of_architect, 2026-11-07, on 577eb3c5). Guessed tags never send an ask past the unit owner."""
    default = ask_target(me)
    if not to_arg or to_arg == default or to_arg != "founder" or default == "founder":
        return (to_arg or default), None, False
    import of_pulse
    rules = [str(x).strip() for x in (((me.get("_delegation") or {}).get("reporting") or {}).get("escalate_when") or [])]
    declared = [t for t in tags or [] if t.get("source") != "guessed"]
    hit = next((r for r in rules if of_pulse.tag_match(r, declared)), None)
    return ("founder", hit, False) if hit else (default, None, True)


def _escalates(me, ident):
    """`of ask --escalates <id>`: the projected ask routed to this unit owner that it rewrites for the founder."""
    import of_asks
    import of_store
    asks = of_asks.project(of_asks.load(of_store.connect()))
    hits = [a for a in asks if (a["event_id"].endswith(ident) or a["event_id"].startswith(ident))
            and a.get("to") == me["name"] and a["state"] in ("open", "escalated")]
    if len(hits) != 1:
        raise OfError(f"--escalates {ident}: {len(hits)} open or escalated asks routed to {me['name']} match")
    return hits[0]


def _deliver_ask(positions, me, to, ask_id, text, opts, blocking, escalated=None):
    """Type a routed question into the unit owner's pane; what is not typed now, the pulse types later
    (of_asks_answer.redeliver_pass). `escalated`: the rule that already sent it to the founder."""
    import of_asks_answer
    pane = next((a["pane_id"] for p, a in bind(positions, live_agents_or_none(warn=False))[0] if p["name"] == to), None)
    frame = of_asks_answer.routed_frame(me["name"], me.get("_unit"), ask_id, text, opts, blocking, escalated)
    if pane:
        print("  " + of_asks_answer.deliver(pane, frame, None, sender=me["name"], human_channel=None))
    else:
        print(f"  {to} has no live pane here; OF types the question in when it has one (for 24 h)"
              + ("" if escalated else ", and it escalates per escalate_when"))


def _topic_key(text):
    """A stable key for deduplicating the same decision asked in different words (sorted content words)."""
    import hashlib
    words = sorted({w for w in re.findall(r"\w+", (text or "").lower()) if len(w) > 2})
    return hashlib.sha256(" ".join(words).encode()).hexdigest()[:16]


def of_hook_mask(text):
    import of_hook
    return of_hook.mask(text or "")


def _remote_approval(conn, e, prompt_id, positions, session=None, hold=True, now=None):
    """(None, prompt) when the person's recorded prompt approves the proposed diff `e`, else (the reason, prompt).
    docs/remote.md §3 row 2 and §5: the person's own words, recorded by the hook as an of.human_prompt of origin human,
    in the session that holds their organization's conductor, which runs this command; later than the proposal; naming
    the diff's id and saying a plain yes. Tiers up to medium; a high tier stays at the machine (§4).
    On hold (of_architect, 2026-11-11, docs/remote.md §5): every diff is refused until prompts are recorded by a
    component the agents cannot write to; `hold=False` runs the evidence checks, kept tested for that day."""
    import of_asks_chat
    if hold:
        return of_asks_chat.DIFF_HOLD, None
    import of_classify
    d = e["diff"]
    if d.get("tier") not in ("low", "medium"):
        return (f"{d['id']} is tier {d.get('tier')}: a high-tier diff is approved at the machine, in a terminal, by "
                "the owner reading its exact text (docs/remote.md §4)"), None
    # the same evidence rules as an answer from the chat (of_asks_chat.check; review 2026-11-11, finding 3): the event
    # as of_asks_chat.prompt_row reads it, with of.prompt_origin corrections; recorded by the hook; typed by the
    # person, not the popup's answer typed into a pane; not dated in the future; at most PROMPT_MAX_AGE_H old
    try:
        prompt = of_asks_chat.prompt_row(conn, prompt_id)
    except ValueError as err:
        return str(err), None
    if prompt["name"] != "of.human_prompt":
        return f"{prompt['event_id']} is an {prompt['name']}, not a prompt the person typed", prompt
    if prompt["source"] != "hook":
        return f"prompt {prompt['event_id'][-8:]} was not recorded by the hook (source {prompt['source']})", prompt
    if prompt["origin"] != "human" or prompt["channel"] == "asks-ui":
        return (f"prompt {prompt['event_id'][-8:]} was not typed by a person (origin {prompt['origin']}"
                + (", the popup's answer typed into a pane" if prompt["channel"] == "asks-ui" else "") + ")"), prompt
    import time as _t
    now = now or _t.time()
    pts = of_asks_chat._epoch(prompt["ts"])
    if pts > now + 60:
        return f"prompt {prompt['event_id'][-8:]} is dated in the future ({prompt['ts']})", prompt
    if now - pts > of_asks_chat.PROMPT_MAX_AGE_H * 3600:
        return (f"prompt {prompt['event_id'][-8:]} is older than {of_asks_chat.PROMPT_MAX_AGE_H} h: ask the person "
                "again"), prompt
    me = session if session is not None else os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not me or prompt["session_id"] != me:
        return "the prompt must be in the session that runs this command: the person's conductor", prompt
    holder = next((p for p in positions if session_of(p) == me), None)
    if not holder or (holder.get("role") != "conductor" and not str(holder.get("name", "")).endswith("_conductor")):
        return "only the person's conductor points to their words; this session holds no conductor position", prompt
    org = d.get("org")
    if org not in (holder.get("_org"), holder.get("_orgid")):  # of_server's review: never another organization's
        return (f"{holder['name']} is a conductor of {holder.get('_org')}, and diff {d['id']} is {org}'s; only "
                f"{org}'s owner's conductor points to the approving words"), prompt
    owner = _org_owner(positions, org)
    if (holder.get("owner") or "founder") != owner:
        return (f"{holder['name']} serves {holder.get('owner') or 'founder'}, and {org}'s diffs are approved by "
                f"{owner}"), prompt
    proposed = e.get("proposed_at") or e.get("ts") or ""
    if proposed and prompt["ts"] < proposed:
        return f"the prompt ({prompt['ts'][:19]}Z) is older than the proposal ({proposed[:19]}Z)", prompt
    text = str(prompt.get("text") or "")
    if d["id"] not in text:
        return f"the person's words do not name the diff {d['id']}", prompt
    if not of_classify.approves(text):
        return "the person's words are not a plain yes (a no, a not or a condition counts as no approval)", prompt
    # a digest counts only where the words name it as one ("digest a1b2c3d4"), so a card id is never read as one, and
    # every digest named must be this diff's (review 2026-11-11, finding 7)
    named = re.findall(r"(?i)\bdigest[:\s]+([0-9a-f]{8,64})\b", text)
    if named and not all(str(e.get("digest") or "").startswith(h.lower()) for h in named):  # the content seen
        return "the person's words name a digest that is not this diff's (of diff list shows its digest)", prompt
    return None, prompt


def _org_owner(positions, org):
    """Who approves an organization's diffs: its position of role owner (`<org>_owner`), else the founder."""
    own = next((p for p in positions if p.get("role") == "owner" and org in (p.get("_org"), p.get("_orgid"))), None)
    return own["name"] if own else "founder"


def cmd_plugins(args):
    """of plugins [list|detect] [--org O]: the families of the plugin mechanism (docs/plugins.md; bin/of_family.py),
    their implementations and where each comes from, and the choice in force; `detect` proposes from what this
    machine has."""
    import of_family
    try:
        import of_plugins  # noqa: F401 - registers of-server's built-in seams
    except Exception:  # noqa: BLE001
        pass
    doc = None
    if args.org:
        regs = {o: p for o, p, _ in org_registries()}
        if args.org not in regs:
            raise OfError(f"no organization {args.org!r} in orgs.yaml")
        doc = yaml.safe_load(open(regs[args.org])) or {}
    if args.action == "detect":
        lines = of_family.propose()
        print("\n".join(lines) if lines else "nothing to propose: no unchosen family has an implementation that "
              "finds its product on this machine")
        return 0
    for fam in sorted(of_family.FAMILIES):
        f = of_family.FAMILIES[fam]
        impls = of_family.implementations(fam)
        name, _, src = of_family.choice(fam, doc)
        chosen = f"{name} ({src})" if name else "none chosen"
        print(f"{fam:<10} {chosen:<28} {', '.join(f'{k} [{v}]' for k, v in sorted(impls.items())) or '-'}   "
              f"({f.owner}: {f.doc})")
    return 0


def cmd_prompts(args):
    """of prompts --mine [--last N] [--all]: this session's recorded prompts typed by a person, newest first, each with
    its event id, UTC time and first line. A conductor cites the id of the head's yes as provisional.event
    (docs/registry.md, Fields, provisional; of_onboarding, 2026-11-11)."""
    import of_store
    if not args.mine:
        raise OfError("of prompts takes --mine: the calling session's prompts")
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not sid:
        raise OfError("of prompts --mine runs inside a Claude Code session (no CLAUDE_CODE_SESSION_ID here)")
    conn = of_store.connect()
    rows = conn.execute("SELECT event_id, ts, payload FROM event WHERE name = 'of.human_prompt' AND session_id = ? "
                        "ORDER BY ts DESC", (sid,)).fetchall()
    shown = 0
    for eid, ts, pl in rows:
        p = json.loads(pl or "{}")
        if not args.all and p.get("origin") not in (None, "human"):
            continue  # a relayed, scheduled or injected prompt is no person's words
        first = next((ln.strip() for ln in str(p.get("text") or "").splitlines() if ln.strip()), "")
        print(f"{eid}  {ts[:19]}Z  {first[:120]}" + ("" if p.get("origin") in (None, "human") else f"  ({p.get('origin')})"))
        shown += 1
        if shown >= args.last:
            break
    if not shown:
        print("no prompts typed by a person in this session yet")
    return 0


def cmd_status(args):
    """Declare this position's state: working | waiting --on founder|<position> | idle | done."""
    import of_events
    positions = _load_quiet()
    me = _me(positions, args.sender)
    if args.state == "waiting" and not args.on:
        raise OfError("of status waiting needs --on founder|<position>|external:<who>")
    on = args.on
    if on and on not in ("founder", "owner") and not on.startswith(("external:", "resource:")):
        on = _me(positions, on)["name"]  # resolve aliases to the canonical name
    note = of_hook_mask(args.note or "")
    wait_ask = _founder_wait_ask(me, getattr(args, "wait_ask", None)) if args.state == "waiting" and \
        on in ("founder", "owner") else None
    if getattr(args, "answered", None):  # the asker got its answer elsewhere (relay, a unit owner): it closes them
        import of_asks
        import of_store
        mine = [a for a in of_asks.project(of_asks.load(of_store.connect()))
                if a["state"] == "open" and a.get("position") == me["name"] and a["kind"].startswith("question (declared")]
        ids = [a["event_id"] for a in mine] if args.answered == "all" else \
            [a["event_id"] for a in mine if a["event_id"].endswith(args.answered) or a["event_id"].startswith(args.answered)]
        if not ids:
            raise OfError(f"no open declared ask of {me['name']} matches {args.answered!r}")
        of_events.emit("agent_question_answered", {"ask_id": ids[0], "ask_ids": ids, "by": me["name"], "via": "status",
                                                   "note": note or None}, position=me["name"])
        print(f"{me['name']}: {len(ids)} ask(s) closed as answered")
    if getattr(args, "done_task", None) or getattr(args, "reopen_task", None):
        tid = args.done_task or args.reopen_task
        mine = [a for a in _current_asks() if a.get("position") == me["name"] and a["state"] == "open"
                and (a["event_id"].endswith(tid) or a["event_id"].startswith(tid))]
        if not mine:
            raise OfError(f"no open ask of {me['name']} matches {tid!r}")
        if args.reopen_task:  # the note shows on his card ("not accepted: …"): no estimate there either
            import of_ask_text
            refusal = of_ask_text.check(note)
            if refusal:
                raise OfError(refusal.replace("the ask estimates", "the note estimates", 1))
        print(f"{me['name']}: task {tid} " + ("done (checked)" if args.done_task else "reopened"))
    of_events.emit("state_declared", {"position": me["name"], "state": args.state, "waiting_on": on,
                                      "reason": note, "note": note,
                                      **({"done_task": args.done_task} if getattr(args, "done_task", None) else {}),
                                      **({"ask": wait_ask} if wait_ask and wait_ask is not True else {}),
                                      **({"work": _work(me.get("_org"), args.work)} if getattr(args, "work", None) else {}),
                                      **({"reopen_task": args.reopen_task} if getattr(args, "reopen_task", None) else {})},
                   position=me["name"], org=me.get("_orgid"),
                   session=session_of(me) if args.sender else (os.environ.get("CLAUDE_CODE_SESSION_ID") or session_of(me)))
    _reconcile_ask_tokens(positions)
    print(f"{me['name']}: {args.state}{' on ' + on if on else ''}")
    try:  # messages waiting on the server for this position (the relay refreshes the file every 60 s)
        import of_relay_client
        note = of_relay_client.queue_note(f"{me.get('_org')}:{me['name']}")
        if note:
            print(note)
    except Exception:  # noqa: BLE001
        pass
    w = _relay_warning()  # a dead relay is said where every agent looks at the end of each turn (a new organization's install, 2026-11-11)
    if w:
        print(f"warning: {w}")
    return 0


def _founder_wait_ask(me, ref=None, asks=None):
    """A wait on the founder needs a question he can see (founder, ask ddd6e3a3, 2026-11-07: three "declared waits"
    without an ask were all stale or someone else's). True when the position has an open ask or task to him; with
    --ask, the id of the open ask it waits on (another position's, e.g. its unit owner's escalation)."""
    def check(asks):
        if ref:
            hit = [a for a in asks if a["state"] == "open" and (a["event_id"].endswith(ref) or a["event_id"].startswith(ref))]
            return hit[0]["event_id"] if hit else None
        return any(a["state"] == "open" and a.get("position") == me["name"] and a.get("to") in ("founder", "owner", None)
                   and (a.get("kind") or "").startswith(("question (declared", "task")) for a in asks) or None

    found = check(_current_asks() if asks is None else asks)
    if found is None and asks is None:  # an ask filed a moment ago may not be in the listener's view yet: the log
        import of_asks
        import of_store
        found = check(of_asks.project(of_asks.load(of_store.connect())))
    if found is not None:
        return found
    if ref:
        raise OfError(f"of status waiting --on founder --ask {ref}: no open ask matches {ref!r} (of asks --all)")
    raise OfError("of status waiting --on founder: you have no open ask to the founder, so he cannot see this wait. "
                  "File the question with of ask first (it stays in his list until it is answered), or name the open "
                  "ask you wait on with --ask <id> (another position's ask, or your task). Nothing was recorded.")


def _reconcile_ask_tokens(positions):
    """After any ask change: herdr's pane `ask` tokens and workspace `asks` counts, from the one
    projection (of_herdr_asks.refresh_ask_tokens). Best effort; herdr may be absent."""
    try:
        import of_herdr_asks
        asks = _current_asks(fallback=False)
        if asks is None:  # no live view: skip the tokens rather than project the whole log in every agent's
            return        # of status (2026-11-11: 26 of a status call's 32 s, ~40 agents, Ghostty lagged)
        of_herdr_asks.refresh_ask_tokens(positions, live_agents(), asks, bind)
    except Exception:
        pass


def _current_asks(conn=None, fallback=True):
    """The asks as the listener's view holds them (a few ms), or projected from the log when the
    listener is not fresh (20 s and more on today's log); fallback=False returns None then."""
    import of_asks
    import of_listen
    import of_store
    conn = conn or of_store.connect()
    if of_listen.fresh(conn):
        return of_listen.read_asks(conn)
    return of_asks.project(of_asks.load(conn)) if fallback else None


def _attention(positions, agents=None):
    """of_pulse.project over the local store; [] when there is no store yet."""
    import of_asks
    import of_pulse
    import of_store
    conn = of_store.connect()
    rows = of_asks.load(conn)
    asks = of_asks.project(rows)
    agents = agents if agents is not None else live_agents()
    mem = of_pulse.load_memory()
    idle = {p: v[1] for p, v in (mem.get("panes") or {}).items() if v[0] in ("idle", "done")}
    return of_pulse.project(positions, agents, rows, asks, idle, bind=bind)


def cmd_pulse(args):
    import of_asks
    import of_pulse
    import of_store
    if args.action in ("install", "uninstall"):
        return _pulse_service(args.action)
    positions = load_positions()[0]
    conn = of_store.connect()
    import time as _t0
    observed = _t0.time()  # what the projection saw: a nudge re-checks declarations after this (of_pulse.still_waits)
    rows = of_asks.load(conn)
    asks = of_asks.project(rows)
    # herdr's agents and those in tmux or screen (of_herdr, 2026-11-11): every pulse path types through
    # of_relay_client.herdr_deliver, which takes tmux: and screen: panes; without herdr the pulse still runs
    agents = live_agents_or_none(warn=False)
    import of_handover
    handovers = of_handover.project(of_handover.load(conn))
    rows = of_pulse.with_messages(conn, rows)  # relayed replies (of send) count as answers to a waiting peer
    if not args.no_nudge:
        try:  # the founder's answers and routed questions not in their pane yet, before any nudge takes an idle pane
            import of_asks_answer
            of_asks_answer.redeliver_pass(conn, asks, positions, agents, bind,
                                          log=(lambda m: None) if args.quiet else print)
        except Exception as e:  # noqa: BLE001
            print(f"redeliver: {e}")
    try:  # positions held on the organization's other machines: their machine acts on them (§4.3)
        import of_presence
        elsewhere = of_presence.elsewhere(positions, {p["name"] for p, _ in bind(positions, agents)[0]})
    except Exception as e:  # noqa: BLE001
        elsewhere = {}
        if not args.quiet:
            print(f"presence: {e}")
    out = of_pulse.run(positions, agents, rows, asks, bind, prompt=None if args.no_nudge else of_pulse.herdr_prompt,
                       log=(lambda m: None) if args.quiet else print, handovers=handovers,
                       offer=None if args.no_nudge else (lambda h: _handover_offer(h, positions, agents)),
                       elsewhere=elsewhere, observed=observed)
    if not args.no_nudge:
        try:  # the question judge (bin/of_judge.py): candidates nobody judged yet, and the delayed corrections
            import of_judge
            of_judge.pulse_pass(conn, asks, positions, agents, bind, log=(lambda m: None) if args.quiet else print)
        except Exception as e:  # noqa: BLE001
            print(f"judge: {e}")
    try:  # free disk below 50 GB (docs/storage.md, "Disk and retention")
        import time as _time
        mem = of_pulse.load_memory()
        of_pulse.disk_check(mem, _time.time(), log=(lambda m: None) if args.quiet else print)
        of_pulse.save_memory(mem)
    except Exception as e:  # noqa: BLE001
        print(f"disk check: {e}")
    try:  # live sessions' scratch folders and the founder's low-disk card (bin/of_scratch.py; Acme, 2026-11-11)
        import of_scratch
        mem = of_pulse.load_memory()
        of_scratch.check(positions, agents, bind, mem, prompt=None if args.no_nudge else of_pulse.herdr_prompt,
                         log=(lambda m: None) if args.quiet else print, conn=conn)
        of_pulse.save_memory(mem)
    except Exception as e:  # noqa: BLE001
        print(f"scratch check: {e}")
    try:  # capacity (of_capacity): ask the owner once when a position's account passes a threshold
        _capacity_watch(positions, (lambda m: None) if args.quiet else print)
        import of_capacity
        if of_capacity.load_policy().get("auto") and not _listener_runs_capacity():
            of_capacity.balance(positions, log=print, ask=_capacity_ask)  # spend first what expires first
    except Exception as e:
        print(f"capacity: {e}")
    if not args.quiet:
        for r in out:
            print(f"  {r['kind']:<14} {r['position']:<26} {('on ' + r['on']) if r['on'] else '':<20} "
                  f"{(r['text'] or '')[:60]}")
        print(f"{len(out)} position(s) need attention")
    return 0


def _listener_runs_capacity():
    """The listener's capacity processor runs the balancer (RFC 0001 §5.1a); the pulse then leaves it alone."""
    try:
        import of_listen
        import of_store
        conn = of_store.connect()
        row = conn.execute("SELECT 1 FROM listener_cursor WHERE processor = 'capacity'").fetchone()
        return bool(row) and of_listen.fresh(conn)
    except Exception:
        return False


def _capacity_ask(text, options=None, task=None, due=None, blocking=False, positions=None):
    """The balancer's asks and tasks to the owner. Every field cmd_ask reads is set: a Namespace without `task`
    raised AttributeError from 2026-11-06 (a2b0d44) to 2026-11-07, and no capacity ask reached the owner. A task
    keeps its title, as `of ask "<title>" --task "<steps>"` does (of_capacity's review of PR 23).
    The sender is the machine's capacity position (of_capacity.actor()). When no registry on this machine has that
    position (a colleague's machine with no capacity position; of_capacity, 2026-11-12), cmd_ask would refuse it and
    the ask would be lost: it is filed as a machine card instead, as the disk card is (bin/of_scratch.py)."""
    import of_capacity
    sender = of_capacity.actor()
    positions = _load_quiet() if positions is None else positions
    if not any(sender == p["name"] or sender in [str(a) for a in p.get("aliases") or []] for p in positions):
        return _capacity_card(sender, text, options, task, due, blocking)
    with open(os.devnull, "w") as null:
        saved, sys.stdout = sys.stdout, null
        try:
            cmd_ask(argparse.Namespace(question=text, options=options, blocking=blocking,
                                       to="founder", sender=sender, task=task, command=None, tags=None,
                                       due=due, work=None, where=None, escalates=None))
        finally:
            sys.stdout = saved


def _capacity_card(sender, text, options=None, task=None, due=None, blocking=False):
    """The balancer's ask as a machine card to the owner, with no registry position behind it."""
    import of_events
    steps = of_hook_mask(task) if task else None
    question = of_hook_mask(text or (steps or "").strip().splitlines()[0][:200])
    opts = [o.strip() for o in (options or "").split("|") if o.strip()]
    return of_events.emit("agent_question", {
        "detected_by": "declared", "source": "capacity", "from_position": sender, "to": "founder",
        "blocking": bool(blocking), "topic_key": _topic_key(question), **({"due": _due(due)} if due else {}),
        "questions": [{"question": question, "options": opts}],
        **({"task": True, "steps": steps, "command": None, "where": "machine"} if task else {})},
        position=sender)


def _capacity_watch(positions, log):
    """docs/capacity.md: probes each account at most every 30 minutes; one ask per account, window and reset."""
    import of_capacity
    return of_capacity.watch(positions, lambda t: _capacity_ask(t, tr("move now") + "|" + tr("wait for the reset")), log=log)


def _pulse_service(action):
    """The pulse runs inside the listener now (RFC 0001 §5.1a): `of pulse install` installs `of listen`
    and removes the old 5-minute launchd job; `uninstall` removes that job only."""
    import platform
    label = "dev.organic-framework.pulse"
    plist = os.path.expanduser(f"~/Library/LaunchAgents/{label}.plist")
    if platform.system() == "Darwin":
        subprocess.run(["launchctl", "bootout", f"gui/{os.getuid()}/{label}"], capture_output=True)
        if os.path.exists(plist):
            os.remove(plist)
            print(f"of pulse: removed the launchd job {label} (the listener runs the pulse)")
    if action == "install":
        return cmd_listen(argparse.Namespace(action="install"))
    return 0


def _pulse_service_launchd(action):  # the earlier standalone job, kept for systems without the listener
    import platform
    import subprocess
    import of_events
    label = "dev.organic-framework.pulse"
    plist = os.path.expanduser(f"~/Library/LaunchAgents/{label}.plist")
    if platform.system() != "Darwin":
        raise OfError("of pulse install: launchd only for now (systemd timer: TODO)")
    if action == "uninstall":
        subprocess.run(["launchctl", "bootout", f"gui/{os.getuid()}/{label}"], capture_output=True)
        if os.path.exists(plist):
            os.remove(plist)
        print("of pulse: uninstalled")
        return 0
    log = os.path.join(of_events.STATE_DIR, "pulse.log")
    with open(plist, "w") as fh:
        fh.write(f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>{label}</string>
  <key>ProgramArguments</key><array><string>{sys.executable}</string><string>{os.path.realpath(__file__)}</string>
    <string>pulse</string><string>--quiet</string></array>
  <key>EnvironmentVariables</key><dict><key>OF_AUTOMATION</key><string>1</string><key>SSH_AUTH_SOCK</key><string></string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin</string></dict>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>{log}</string>
  <key>StandardErrorPath</key><string>{log}</string>
</dict></plist>
""")
    subprocess.run(["launchctl", "bootout", f"gui/{os.getuid()}/{label}"], capture_output=True)
    subprocess.run(["launchctl", "bootstrap", f"gui/{os.getuid()}", plist], check=False)
    print(f"of pulse: every 5 minutes ({plist}); log {log}")
    return 0


def cmd_machines(args):
    import of_client
    if bool(args.machine_id) == bool(args.person):
        raise OfError("usage: of machines revoke --server URL (--machine-id ID | --person P)")
    r = of_client.Client(args.server).revoke(args.machine_id, args.person)
    print(f"revoked: {', '.join(r.get('revoked') or []) or 'nothing'}")
    return 0


def cmd_enroll(args):
    import of_client
    c = of_client.Client(args.server)
    terms = c.terms()
    print(TIERS_TEXT)
    print(f"\nTerms version {terms.get('current')}: {terms.get('url') or terms.get('text_url') or '(no link)'}")
    if terms.get("effect_on_shipped"):
        print(f"If you later withdraw consent, what was already sent: {terms['effect_on_shipped']}.")
    print()
    consent = {}
    for org in args.org:
        raw = org in (args.raw or [])
        if not raw and not args.yes:
            raw = input(f"Send the raw tier for {org}? [y/N] ").strip().lower() in ("y", "yes", "д", "да")
        consent[org] = {"tiers": ["typed", "raw"] if raw else ["typed"], "terms": terms.get("current")}
    r = c.enroll(args.code, consent)
    raw_orgs = r.get("raw_orgs") if r.get("raw_orgs") is not None else [o for o, v in consent.items() if "raw" in v["tiers"]]
    set_org_servers(r.get("orgs") or args.org, args.server, raw_orgs=raw_orgs)
    print(f"enrolled {r.get('machine_id')} for {', '.join(r.get('orgs') or [])}; raw tier: "
          f"{', '.join(r.get('raw_orgs') or []) or 'none'}")
    print(f"orgs.yaml now ships these organizations to {args.server}. Clone each organization's repository and set its "
          "`path:` to get names and positions locally.")
    return 0


def cmd_consent(args):
    import of_client
    import of_ship
    doc = yaml.safe_load(open(ORGS_FILE)) or {}
    targets = [o for o in doc.get("orgs") or [] if not args.org or o.get("name") in args.org]
    by_server = {}
    for o in targets:
        by_server.setdefault(o.get("server") or of_ship.config()["server_url"], []).append(o["name"])
    for server, orgs in by_server.items():
        c = of_client.Client(server)
        terms = c.terms().get("current")
        consent = {o: {"tiers": ["typed", "raw"] if args.raw == "on" else ["typed"], "terms": terms} for o in orgs}
        r = c.set_consent(consent)
        set_org_servers(orgs, None, raw_orgs=orgs if args.raw == "on" else [])  # of ship obeys it here
        print(f"{server}: {json.dumps(r, ensure_ascii=False)}")
    return 0


def cmd_shipped(args):
    """What has left this machine: receipts per server, with organizations and tiers."""
    import of_client
    import of_ship
    # the servers this machine ships to: each organization's own, and the default only for one that names none
    # (of_lab, 2026-11-07: a client probed 127.0.0.1:18200, which it never ships to)
    servers = set(of_ship.org_servers(of_ship.config()).values()) or {of_ship.config()["server_url"].rstrip("/")}
    for server in sorted(servers):
        try:
            rs = of_client.Client(server).receipts(0).get("receipts") or []
        except Exception as e:
            print(f"{server}: unreachable ({type(e).__name__})")
            continue
        per = {}
        for r in rs:
            for org, n in (r.get("by_org") or {}).items():
                d = per.setdefault(org, {"records": 0, "batches": 0, "tiers": set()})
                d["records"] += n
                d["batches"] += 1
                d["tiers"].update((r.get("tiers") or {}).get(org, []))
        print(f"{server}: {len(rs)} batches")
        for org, d in sorted(per.items()):
            print(f"  {org:<26} {d['records']:>8} records in {d['batches']} batches; tiers {', '.join(sorted(d['tiers'])) or 'typed'}")
    return 0


# ----------------------------------------------------------------- grants

def _now_iso():
    import time
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def _grant_keys():
    """What this machine trusts for grants: its own pinned grant public key (the tenant's). The legacy HMAC key is
    retired (hand-over 4c7ac78f): no grant carries one, and whoever can verify an HMAC can also forge it."""
    import of_grants
    pins = []
    if os.path.exists(of_grants.pin_path()):
        with open(of_grants.pin_path()) as fh:
            pins = [line for line in fh.read().splitlines() if line.strip()]
    return of_grants.Keys(ed25519=pins)


def _owners_terminal(what):
    """Signing through the owner's 1Password happens only in his own terminal: never from an agent's session (Claude
    Code sets CLAUDECODE in its tools' environment) or a service (OF_AUTOMATION=1). The guard denies it too (G13)."""
    if os.environ.get("CLAUDECODE") or os.environ.get("CLAUDE_CODE_SESSION_ID") or \
            os.environ.get("OF_AUTOMATION") == "1":
        raise OfError(f"{what} signs with the key in the owner's 1Password: run it in his own terminal tab, never "
                      "from an agent's session or a service")


def _ensure_grant_key():
    """The tenant's grant signing key (Ed25519, OpenSSH), made on first use; it never leaves here."""
    import subprocess
    import of_grants
    if not os.path.exists(of_grants.GRANT_KEY) and not os.path.exists(of_grants.pin_path()):
        os.makedirs(os.path.dirname(of_grants.GRANT_KEY), mode=0o700, exist_ok=True)
        env = dict(os.environ, SSH_AUTH_SOCK="")  # never an SSH agent (the founder's is 1Password)
        subprocess.run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", "of tenant grant key",
                        "-f", of_grants.GRANT_KEY], check=True, env=env)
        os.chmod(of_grants.GRANT_KEY, 0o600)
        print(f"made the tenant grant key: {of_grants.GRANT_KEY} (pin its .pub on each server: trusted_grant_keys)")


def cmd_grant(args):
    """Issue or revoke a signed grant, or move every grant to the key in the owner's 1Password (rekey). Tenant only:
    it signs with the key file while one exists, else through 1Password's SSH agent (Touch ID)."""
    import of_events
    import of_grants
    if args.action == "rekey":
        _owners_terminal("of grant rekey")
        paths, n, line = of_grants.rekey()
        fp = __import__("subprocess").run(["ssh-keygen", "-lf", of_grants.pin_path()], capture_output=True,
                                          text=True).stdout.split()[1:2]
        of_events.emit("grant_key_rotated", {"grants": n, "files": len(paths), "fingerprint": (fp or [None])[0]})
        print(f"re-signed {n} grants in {len(paths)} files with the key in 1Password ({(fp or ['?'])[0]}); "
              f"pinned it in {of_grants.pin_path()}; the old key file is removed.")
        for p in paths:
            print(f"  changed: {p} (its organization's structure keeper commits it)")
        print("Pin the same public key on every other server (trusted_grant_keys): it is the line in "
              f"{of_grants.pin_path()}.")
        return 0
    if of_grants.signs_with_agent():
        _owners_terminal(f"of grant {args.action}")
    _ensure_grant_key()
    key = _grant_keys()
    if not args.org:
        raise OfError("of grant issue|revoke needs --org")
    path = of_grants.grants_path(args.org)
    doc = yaml.safe_load(open(path)) if os.path.exists(path) else None
    doc = doc or {"grants": []}
    grants = doc.setdefault("grants", [])
    if args.action == "issue":
        if not (args.subject and args.tier):
            raise OfError("usage: of grant issue --org ORG --subject POSITION --tier TIER [--scope JSON] ...")
        gid = args.id or f"g-{_now_iso()[:10]}-{len(grants) + 1:03d}"
        if any(g.get("id") == gid for g in grants):
            raise OfError(f"grant {gid} already exists in {path}")
        g = {"id": gid, "subject": args.subject, "issuer": args.issuer, "tier": args.tier,
             "scope": json.loads(args.scope) if args.scope else {}, "effect": "deny" if args.deny else "allow",
             "critical": bool(args.critical), "expires": args.expires, "counter": args.counter,
             "provenance": {"kind": args.kind, "chain": [], "source": args.source}, "note": args.note,
             "revoked": None}
        if args.except_:  # signed with the grant: an exception cannot be added by hand (Organization rules)
            g["except"] = [x.strip() for x in args.except_.split(",") if x.strip()]
        shape = of_grants.shape_problems(g)
        if shape:
            raise OfError("refused: " + "; ".join(shape))
        g["signature"] = of_grants.sign_ed25519(g)
        by_subject = {}
        for gs in of_grants.load().values():
            for x in gs:
                by_subject.setdefault(x.get("subject"), []).append(x)
        ok, why = of_grants.verify_chain(g, by_subject, key, _now_iso())
        if not ok:
            raise OfError(f"refused: {why}")
        grants.append(g)
        event = "grant_issued"
    else:
        g = next((x for x in grants if x.get("id") == args.id), None)
        if not g:
            raise OfError(f"no grant {args.id} in {path}")
        g["revoked"] = {"at": _now_iso(), "by": "tenant", "reason": args.note}
        g["signature"] = of_grants.sign_ed25519(g)
        event = "grant_revoked"
    with open(path, "w") as fh:
        fh.write("# Signed grants (docs/registry.md, Grants). Edit only with `of grant`; a hand edit breaks the signature.\n")
        yaml.safe_dump(doc, fh, sort_keys=False, allow_unicode=True)
    scope_digest = __import__("hashlib").sha256(json.dumps(g["scope"], sort_keys=True).encode()).hexdigest()[:16]
    of_events.emit(event, {"grant_id": g["id"], "subject": g["subject"], "issuer": g["issuer"], "tier": g["tier"],
                           "effect": g["effect"], "critical": g["critical"], "scope_digest": scope_digest,
                           "expires": g["expires"], "reason": args.note}, org=args.org)
    print(f"{event.replace('_', ' ')}: {g['id']} for {g['subject']} ({g['tier']}) in {path}")
    return 0


# ------------------------------------------------------------- hook, event

def cmd_hook(args):
    import of_hook
    return of_hook.main([args.hook_event] if args.hook_event else [])


def cmd_event(args):
    """Write an event declared by a tool or a supervisor (docs/events.md)."""
    import hashlib
    import time
    import of_events
    if args.kind == "injected_prompt":
        if args.text is None:
            raise OfError("usage: of event injected_prompt --injector NAME [--session ID] --text TEXT")
        digest = hashlib.sha256(args.text.strip().encode()).hexdigest()
        of_events.emit("injected_prompt", {"injector": args.injector, "target_session": args.session,
                                           "text_sha256": digest, "reason": args.reason})
        path = os.path.join(of_events.STATE_DIR, "injections.jsonl")
        with open(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600), "a") as fh:
            fh.write(json.dumps({"ts": time.time(), "session": args.session, "sha256": digest,
                                 "injector": args.injector}) + "\n")
    elif args.kind == "published":
        if not (args.from_org and args.to_org and args.artifact):
            raise OfError("usage: of event published --from-org ORG --to-org ORG --artifact PATH[@REV] [--grant G] [--reason TEXT]")
        of_events.emit("published", {"from_org": args.from_org, "to_org": args.to_org, "artifact": args.artifact,
                                     "grant": args.grant, "note": args.reason},
                       position=args.position, org=args.to_org,
                       extra={"of.serves": args.from_org} if args.from_org != args.to_org else None)
    elif args.kind == "finance_fact":
        return _finance_fact(args)
    elif args.kind == "state_declared":
        if args.state not in ("suspended", "resumed"):
            raise OfError("usage: of event state_declared --state suspended|resumed --session ID --reason TEXT")
        of_events.emit("state_declared", {"state": args.state, "reason": args.reason},
                       session=args.session, position=args.position)
    return 0


def _finance_fact(args):
    """of event finance_fact: one month's T, OE or I, or one day's balance B, straight to the organization's server;
    a stub here."""
    import of_client
    import of_finance
    import of_ship
    import of_store
    positions = _load_quiet()
    me = _me(positions, args.position)
    org = me.get("_orgid") or me.get("_org")
    p = of_finance.build(args.fact_kind, args.period, args.amount, args.currency, args.basis, args.source,
                         grant_id=args.grant, category=args.category, product=args.product, account=args.account,
                         amount_usd=args.amount_usd, fx_rate=args.fx_rate, fx_source=args.fx_source,
                         fx_date=args.fx_date, supersedes=args.supersedes)
    systems = set(me.get("_systems") or {})
    cfg = of_ship.config()
    url = of_ship.org_servers(cfg).get(org) or cfg["server_url"]
    try:
        eid, answer = of_finance.write(p, me["name"], org, url, of_client.Client(url), of_store.connect(),
                                       systems=systems or None,
                                       session=os.environ.get("CLAUDE_CODE_SESSION_ID") or session_of(me))
    except ValueError as e:
        raise OfError(f"of event finance_fact: {e}")
    except Exception as e:  # noqa: BLE001  unreachable or refused: nothing queued; the writer tries again
        raise OfError(f"of event finance_fact: the server did not take it ({type(e).__name__}: {str(e)[:200]}); "
                      "nothing was kept here, try again")
    print(f"finance fact {eid[-8:]} stored on {url}: {answer}")
    return 0


# -------------------------------------------------------------------- desk

def _ago(seconds):
    seconds = int(seconds)
    if seconds < 90:
        return f"{seconds}s"
    if seconds < 5400:
        return f"{seconds // 60}m"
    return f"{seconds // 3600}h{seconds % 3600 // 60:02d}m"


def _load_quiet():
    positions, problems = load_positions()
    for pr in problems:
        print(f"registry: {pr}", file=sys.stderr)
    return positions


def cmd_desk(args):
    import time
    import of_desk
    action = args.action or "show"
    log = lambda m: print(m, flush=True)
    if action == "run":
        of_desk.run(lambda: load_positions()[0], bind, lambda m: log(f"{time.strftime('%H:%M:%S')} {m}"))
        return 0
    if action == "on":
        print(f"of desk: router running, pid {of_desk.start(os.path.realpath(__file__))}")
        print(f"log: {os.path.join(of_desk.STATE_DIR, 'desk.log')}")
        return 0
    if action == "off":
        pid = of_desk.stop()
        print(f"of desk: router stopped (pid {pid})" if pid else "of desk: router was not running")
        return 0
    if action == "once":
        acts = of_desk.reconcile(_load_quiet(), bind, log)
        print(f"{len(acts)} action(s)")
        return 0
    if action in ("pin", "unpin"):
        if not args.name:
            raise OfError(f"usage: of desk {action} <name>")
        positions = _load_quiet()
        a = resolve(args.name, positions, live_agents())
        p = dict((a2["pane_id"], p) for p, a2 in bind(positions, [a])[0]).get(a["pane_id"])
        name = p["name"] if p else (a.get("name") or a["pane_id"])
        with of_desk.State() as st:
            pins = set(st["pinned"])
            pins.add(name) if action == "pin" else pins.discard(name)
            st["pinned"] = sorted(pins)
        print(f"pinned: {', '.join(sorted(pins)) or '-'}")
        return 0
    if action == "put":
        if not args.name:
            raise OfError("usage: of desk put <name> [slot]")
        positions = _load_quiet()
        cfg = of_desk.load_config()
        world = of_desk.World(positions, bind, cfg)
        a = resolve(args.name, positions, world.agents)
        incoming = world.view(a)
        slots = world.ordered_desk()
        if any(s["pane"] == incoming["pane"] for s in slots):
            print(f"{incoming['name']} is already on the desk")
            return 0
        evicted = None
        if args.slot:
            if not 1 <= args.slot <= len(slots):
                raise OfError(f"slot must be 1..{len(slots)}")
            evicted = slots[args.slot - 1]
        elif len(slots) >= cfg["slots"]:
            with of_desk.State() as st:  # only what the router placed; the lowest in the case first
                placed = dict(st.get("placed") or {})
            sc = of_desk.scores(_desk_cases(cfg), cfg)
            free = [s for s in slots if s["name"] in placed and not s.get("focused")]
            if not free:
                raise OfError("the desk holds only your own panes; name one to replace: of desk put <name> <slot>")
            evicted = min(free, key=lambda s: (sc.get(s["name"], (0,))[0], placed[s["name"]]))
        if not of_desk.bring_in(world, incoming, evicted, log):
            return 1
        of_desk._emit("bring_in", incoming, replaced=evicted and evicted["name"], by="owner")
        if evicted:
            of_desk._emit("evict", evicted, by=incoming["name"])
        return 0
    if action == "case":
        return _desk_case(args)
    # show
    positions = _load_quiet()
    cfg = of_desk.load_config()
    world = of_desk.World(positions, bind, cfg)
    now = time.time()
    import of_case
    import of_store
    conn = of_store.connect()
    try:
        latest = of_case.latest(conn, max_age_s=cfg["case_max_age_s"]) or {}
        touched = {p["position"] for p in of_case.founder_prompts(conn, of_case._iso(now - cfg["touch_s"]),
                                                                  of_case._iso(now))}
    finally:
        conn.close()
    cases = latest.get("cases") or []
    sc = of_desk.scores(cases, cfg)
    with of_desk.State() as st:
        st["since"] = of_desk.update_since(st["since"], world.agents, now)
        since, pins, placed = dict(st["since"]), set(st["pinned"]), dict(st.get("placed") or {})
    slots = world.ordered_desk()
    pid = of_desk.running_pid()
    print(f"desk {cfg['label']!r}: {len(slots)}/{cfg['slots']} slots · router {'on, pid ' + str(pid) if pid else 'off'}")
    for i, s in enumerate(slots, 1):
        if s["name"] in pins:
            why = "pinned"
        elif s["name"] not in placed:
            why = "yours"
        else:
            v = sc.get(s["name"])
            why = f"case {v[0]:.1f}: {v[2]}" if v else "case: not in the current case"
        mark = " (you typed to it)" if s["name"] in touched else ""
        print(f"  {i}  {s['name']:<26} {s['status']:<8} {_ago(now - since.get(s['pane'], ['', now])[1]):>6}  "
              f"{why}{mark}")
    if cases:
        print(f"case ({latest['ts'][11:16]}Z): {cases[0]['title']}")
        on = {s["name"] for s in slots}
        for m in cases[0]["members"]:
            print(f"     {m['position']:<26} {m['weight']:.1f}  {'on the desk' if m['position'] in on else ''}")
        for c in cases[1:]:
            print(f"  also: {c['title']}: " + ", ".join(m["position"] for m in c["members"]))
    else:
        print("case: none yet (the desk follows your hand only)")
    _, off = world.split()
    dialogs = [d for d in off if d.get("dialog")]
    if dialogs:
        print("waiting in a dialog: " + ", ".join(d["name"] for d in dialogs))
    return 0


def cmd_corrections(args):
    """of corrections [list|judge|digest] (RFC 0006 §2.4; bin/of_corrections.py): the founder's corrections as
    records, judged from his prompts in positions' panes, and each structure keeper's daily digest."""
    import fcntl
    import time
    import of_corrections
    import of_store
    action = args.action or "list"
    conn = of_store.connect()
    try:
        if action == "list":
            rows = of_corrections.corrections(conn, since=of_corrections._iso(time.time() - args.days * 86400))
            if not rows:
                print(f"no corrections recorded in the last {args.days} days")
            for r in rows:
                print(f"{r['ts'][:16]}Z  {r['position']:<26} {r['kind']:<8} {r['rule']}"
                      + (f"  (repeats {r['repeat_of'][-8:]})" if r["repeat_of"] else ""))
            return 0
        os.makedirs(of_corrections.of_events.STATE_DIR, mode=0o700, exist_ok=True)
        lock = open(os.path.join(of_corrections.of_events.STATE_DIR, "corrections-run.lock"), "w")
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return 0  # a run is going: it takes what is pending
        stamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        say = (lambda m: None) if args.quiet else print
        positions = _load_quiet()
        out = of_corrections.judge(conn, positions, emit=not args.dry_run, log=lambda m: print(f"{stamp} {m}"))
        for c, v in out:
            if "error" not in v and (v["correction"] or args.dry_run):
                say(f"{c['ts'][:16]}Z {c['position']}: " + (f"[{v['kind']}] {v['rule']}"
                    + (f" (repeats {v['repeat_of']})" if v["repeat_of"] else "") if v["correction"] else "no"))
        if action == "digest":
            n = of_corrections.send_digests(conn, positions, force=args.force, dry_run=args.dry_run,
                                            log=lambda m: print(f"{stamp} {m}"))
            say(f"{n} digest(s) sent")
        return 0
    finally:
        conn.close()


def _desk_cases(cfg):
    import of_case
    import of_store
    conn = of_store.connect()
    try:
        return (of_case.latest(conn, max_age_s=cfg["case_max_age_s"]) or {}).get("cases") or []
    finally:
        conn.close()


def _desk_case(args):
    """of desk case [--infer [--dry-run]] [--json]: the founder's current case (docs/desk.md)."""
    import fcntl
    import of_case
    import of_store
    conn = of_store.connect()
    try:
        if args.infer:
            os.makedirs(of_case.of_events.STATE_DIR, mode=0o700, exist_ok=True)
            lock = open(os.path.join(of_case.of_events.STATE_DIR, "case-run.lock"), "w")
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                print("of desk case: an inference is running already")
                return 0
            r = of_case.infer(conn, _load_quiet(), emit=not args.dry_run, trigger=args.trigger or "cli")
            if r is None:
                print("of desk case: no prompts of yours in the last 90 minutes")
                return 0
            r.pop("prompt", None)
        else:
            r = of_case.latest(conn)
            if r is None:
                print("of desk case: none inferred in the last 6 hours")
                return 0
    finally:
        conn.close()
    if args.json:
        print(json.dumps(r, ensure_ascii=False, indent=1))
        return 0
    if r.get("error"):
        print(f"of desk case: {r['error']}")
        return 1
    head = f"{r.get('ts', 'now')[:16]} · {r.get('model')} · {r.get('ms', 0) / 1000:.0f} s"
    print(head + (" · not recorded" if args.infer and args.dry_run else ""))
    for i, c in enumerate(r.get("cases") or []):
        print(f"{'now' if i == 0 else 'also'}: {c['title']}")
        print(f"     {c['summary']}")
        for m in c["members"]:
            print(f"     {m['position']:<26} {m['weight']:.1f}  {m['why']}")
    return 0


# -------------------------------------------------------------------- main

def cmd_capacity(args):
    """of capacity status [--json] [--fresh|--no-probe]: model limits per config dir (account), the
    positions running on each, from a minimal probe at most every 30 minutes (docs/capacity.md)."""
    import of_capacity
    positions = _load_quiet()
    if args.action == "close":
        if not args.session or not args.position or not args.reason:
            raise OfError("usage: of capacity close <position> --session SID --reason TEXT [--dry-run]")
        try:
            of_capacity.close(args.session, args.position, args.reason, dry_run=args.dry_run)
        except of_capacity.MoveError as e:
            raise OfError(f"capacity close: {e}")
        return 0
    if args.action == "memory":  # RFC 0006 §2.2: seed each position's own memory directory
        only = None
        if args.position:
            me = _me(positions, args.position)
            only = (me.get("_org"), me["name"])
        r = of_capacity.seed_memory(positions, only=only, dry_run=args.dry_run, transcripts=args.from_transcripts)
        for mdir, acts in r["positions"].items():
            files, who = len(r["owners"][mdir]), r["members"][mdir]
            changed = ", ".join(f"{a} {sum(1 for _, x in acts if x == a)}" for a in sorted({x for _, x in acts}))
            scope = "/".join(mdir.rstrip("/").split("/")[-2:])
            shared = f" (shared by {', '.join(sorted(who))})" if len(who) > 1 or who[0] != scope.split("/")[-1] else ""
            print(f"{scope}{shared}: {files} file(s); {changed or 'nothing new'}")
        if not only:
            print(f"unattributed: {len(r['unattributed'])} file(s) stay in the folder memories for the structure keepers")
        if args.report and not only:
            left = of_capacity.leftover_memory(r["unattributed"], r["writes"], r["sessions"], of_capacity.config_dirs())
            for org, rows in sorted(left.items(), key=lambda x: str(x[0])):
                path = of_capacity.write_leftover_report(org, rows, dry_run=args.dry_run)
                print(f"leftover for {org or 'no organization'}: {len(rows)} file(s) -> {path}")
        print(("would seed " if args.dry_run else "seeded ") + of_capacity.MEMORY_ROOT
              + ("" if of_capacity.load_policy().get("position_memory") else
                 "; of spawn starts on it; moves and resumes too once capacity.yaml has position_memory: true"))
        return 0
    if args.action == "babysit":
        import time
        if not args.position:
            raise OfError("usage: of capacity babysit <position|session> [--since YYYY-MM-DD] [--until YYYY-MM-DD]")
        try:
            sid = ((_me(positions, args.position).get("holder") or {}).get("session") or "").strip()
        except OfError:
            sid = args.position
        until = args.until or time.strftime("%Y-%m-%dT%H:%M", time.gmtime())
        since = args.since or time.strftime("%Y-%m-%d", time.gmtime(time.time() - 7 * 86400))
        paths = of_capacity.session_paths_for(sid)
        if not paths:
            raise OfError(f"capacity babysit: no transcript for session {sid!r}")
        r = of_capacity.babysit_measure(paths, since, until)
        if args.json:
            print(json.dumps(dict(r, session=sid, since=since, until=until), indent=1))
            return 0
        share = 100 * r["babysit_usd"] / r["usd"] if r["usd"] else 0
        print(f"{args.position} ({sid[:8]}), {since} .. {until}, list price, each response once:")
        print(f"  spend ${r['usd']:,.0f} over {r['responses']} responses: "
              + ", ".join(f"{m} ${v:,.0f}" for m, v in sorted(r["by_model"].items(), key=lambda x: -x[1]) if v >= 0.5))
        print(f"  babysitting ${r['babysit_usd']:,.0f} ({share:.0f}%): monitor-woken turns ${r['monitor_turn_usd']:,.0f}, "
              f"runner-only responses ${r['runner_only_usd']:,.0f}; {r['runner_commands']} runner commands, "
              f"{r['monitor_calls']} monitor calls")
        print(f"  on {of_capacity.BABYSIT_MODEL}: same context ${r['same_context_estimate_usd']:,.0f}; "
              f"a babysitter with its own {of_capacity.BABYSITTER_CONTEXT // 1000}k context "
              f"${r['small_context_estimate_usd']:,.0f}")
        return 0
    if args.action == "vault-setup":
        try:
            path = of_capacity.vault_setup(op_account=args.op_account or of_capacity.OP_ACCOUNT)
        except of_capacity.MoveError as e:
            raise OfError(f"capacity vault-setup: {e}")
        print(f"ok: vault {of_capacity.VAULT!r} and service account of-capacity; its token is in {path} (mode 600)")
        return 0
    if args.action == "vault":
        try:
            r = of_capacity.vault_check()
        except of_capacity.MoveError as e:
            raise OfError(f"capacity vault: {e}")
        print(f"service account: {r['service_account']}; vaults it sees: {', '.join(r['vaults']) or '-'}; "
              f"{'ok' if r['ok'] else 'NOT OK: it must see exactly ' + of_capacity.VAULT}")
        return 0 if r["ok"] else 1
    if args.action == "mint":
        try:
            if not of_capacity.vault_check()["ok"]:
                raise OfError("capacity mint: the vault check fails; run `of capacity vault`")
            dirs = ([of_capacity.os.path.expanduser(args.position)] if args.position else
                    [r["name"] for r in of_capacity.due_accounts(of_capacity.creds())] if args.all_due else [])
            if not dirs:
                raise OfError("usage: of capacity mint <config-dir> | --all-due")
            for d in dirs:
                of_capacity.mint(of_capacity.os.path.expanduser(d))
        except of_capacity.MoveError as e:
            raise OfError(f"capacity mint: {e}")
        return 0
    if args.action == "creds":
        if args.store:
            if not args.kind or not args.account:
                raise OfError("usage: of capacity creds --store NAME --kind api_key --account EMAIL [--consumer C]")
            try:
                r = of_capacity.store_secret(args.store, args.kind, args.account, consumer=args.consumer)
            except of_capacity.MoveError as e:
                raise OfError(f"capacity creds: {e}")
            print(f"stored {r['name']} in the vault: {r['kind']} of {r['account']}, fingerprint {r['fingerprint']}")
            return 0
        if args.adopt:
            if not args.kind or not args.account:
                raise OfError("usage: of capacity creds --adopt NAME --kind setup_token|api_key|codex_auth --account EMAIL "
                              "(--from-stdin | --fingerprint HEX) [--expires YYYY-MM-DD] [--consumer C]")
            value = sys.stdin.read() if args.from_stdin else None
            try:
                r = of_capacity.adopt(args.adopt, args.kind, args.account, args.expires, value=value,
                                      fp=args.fingerprint, consumer=args.consumer)
            except of_capacity.MoveError as e:
                raise OfError(f"capacity creds: {e}")
            print(f"adopted {r['name']}: {r['kind']} of {r['account']}, fingerprint {r['fingerprint']}")
            return 0
        rows = of_capacity.creds()
        print(json.dumps(rows, indent=1) if args.json else of_capacity.format_creds(rows))
        return 0
    if args.action == "reboot":  # the Mac restarts (founder, 2026-11-10): prepare before, restore after
        step = args.position or "status"
        try:
            if step == "prepare":
                of_capacity.reboot_prepare(positions, hold=of_capacity.load_policy().get("hold") or (),
                                           dry_run=args.dry_run)
            elif step == "restore":
                only = {x.strip() for x in args.only.split(",") if x.strip()} if args.only else None
                import of_spawn
                done = of_capacity.reboot_restore(positions, only=only, dry_run=args.dry_run,
                                                  of_bin=os.path.realpath(__file__),
                                                  place_of=lambda p: of_spawn.place(p, want_workspace))
                return 1 if any(s == "failed" for _, s, _ in done) else 0
            elif step == "status":
                plan = of_capacity.load_reboot_plan()
                if not plan:
                    print("no restart prepared (of capacity reboot prepare)")
                    return 0
                live = {x["session"] for d in of_capacity.config_dirs() for x in of_capacity.live_sessions(d)}
                es = plan["entries"]
                print(f"prepared {plan['prepared_at']}: {len(es)} session(s), "
                      f"{sum(1 for e in es if e['session'] in live)} running now")
                for e in es:
                    if e["session"] not in live:
                        print(f"  down: {e['name']} ({of_capacity.short(e['config_dir'])})")
            else:
                raise OfError("usage: of capacity reboot prepare|restore|status [--only a,b] [--dry-run]")
        except of_capacity.MoveError as e:
            raise OfError(f"capacity reboot: {e}")
        return 0
    if args.action == "resume":
        if not args.position or not args.session or not args.to or not args.pane:
            raise OfError("usage: of capacity resume <position> --session SID --to <config-dir> --pane <pane> "
                          "[--note-file F] [--dry-run]")
        note = args.note
        if args.note_file:
            with open(os.path.expanduser(args.note_file)) as fh:
                note = fh.read()
        try:
            me = _me(positions, args.position)
            r = of_capacity.resume(me["name"], args.session, args.to, args.pane, extra_note=note,
                                   dry_run=args.dry_run, of_bin=os.path.realpath(__file__), position=me)
        except of_capacity.MoveError as e:
            raise OfError(f"capacity resume: {e}")
        if not args.dry_run:
            print(f"{args.position}: resumed in {r['pane']} as {r['session']}. Work dir: {r['work']}")
        return 0
    if args.action == "move":
        if not args.position or not (args.to or args.model):
            raise OfError("usage: of capacity move <position> --to <config-dir> | --model M [--reason R] "
                          "[--dry-run] [--allow-shells]")
        p = _me(positions, args.position)
        if args.session:  # a holder the registry does not name yet (its keeper decides)
            p = dict(p, holder=dict(p.get("holder") or {}, session=args.session))
        place = None
        if args.in_place:
            pass
        elif args.into:
            place = tuple(args.into.split("/", 1)) if "/" in args.into else (args.into, p.get("system") or p["name"])
        elif p.get("_unit") or p.get("_workspace"):
            place = (want_workspace(p), p.get("system") or p["name"])
        note = args.note
        if args.note_file:
            with open(os.path.expanduser(args.note_file)) as fh:
                note = fh.read()
        try:
            r = of_capacity.move(p, args.to, dry_run=args.dry_run, allow_shells=args.allow_shells, place=place,
                                 extra_note=note, in_place=args.in_place, model=args.model, why=args.reason,
                                 assume_empty_input=args.assume_empty_input,
                                 of_bin=os.path.realpath(__file__),
                                 registry_file=os.path.join(p["_root"], "registry", "positions.yaml") if p.get("_root") else None)
        except of_capacity.MoveError as e:
            raise OfError(f"capacity move: {e}")
        if not args.dry_run:
            print(f"{p['name']}: resumed in {r['pane']} as {r['session']}; verify with `herdr agent read {r['pane']}` "
                  f"once it is idle. Work dir: {r['work']}")
        return 0
    rows = of_capacity.status(positions, fresh=args.fresh, probe=not args.no_probe)
    if args.action == "balance":
        plan_ = of_capacity.balance(positions, dry_run=args.dry_run, ask=_capacity_ask)
        if not plan_:
            print("balance: nothing to move (the soonest-expiring capacity is already in use, or no idle holder fits)")
        return 0
    if args.action == "plan":
        steps = of_capacity.plan(rows, positions, {d: of_capacity.live_sessions(d) for d in of_capacity.config_dirs()})
        if args.json:
            print(json.dumps(steps, indent=1, ensure_ascii=False))
            return 0
        if not steps:
            print("no position runs on an account past its threshold")
        for i, st in enumerate(steps, 1):
            print(f"{i:>3}. {st['position']:<28} {of_capacity.short(st['from'])} -> "
                  f"{of_capacity.short(st['to']) if st['to'] else '(no target)'}  "
                  f"{st.get('throughput') or '-':<10} {st.get('status') or 'active':<8}{'  busy: wait' if st['busy'] else ''}")
        return 0
    if args.json:
        print(json.dumps(rows, indent=1, ensure_ascii=False))
        return 0
    print(of_capacity.format_table(rows))
    for r in rows:
        why = of_capacity.over_threshold(r)
        if why and r.get("positions"):
            t = of_capacity.best_target(rows, exclude=r["config_dir"])
            print(f"! {of_capacity.short(r['config_dir'])}: {why}; {len(r['positions'])} position(s) there"
                  + (f"; most headroom: {of_capacity.short(t['config_dir'])} ({t.get('account')})" if t else
                     "; no other logged-in account"))
    return 0


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if argv and argv[0] in ("model", "studio"):  # of_studio's commands: dispatched as is, no logic here
        import of_studio_cli
        return of_studio_cli.main(argv)
    if argv and argv[0] == "works":  # the works map and its state (docs/works.md): of_studio_cli's own `works` parser (= of model works)
        import of_studio_cli
        return of_studio_cli.main(argv)
    if argv and argv[0] == "secret":  # the agents' secrets broker (docs/agent-secrets.md): of_server's module, as is
        import of_secret
        return of_secret.main(argv[1:])
    if argv and argv[0] == "tools":  # a position's tools, bound to the position (docs/tools.md): of_tools's module
        import of_tools
        return of_tools.main(argv[1:])
    if argv and argv[0] in ("account", "claude"):  # the machine's harness accounts (docs/accounts.md): of_capacity's
        import of_accounts
        return of_accounts.main(argv[1:]) if argv[0] == "account" else of_accounts.claude(argv[1:])
    ap = argparse.ArgumentParser(prog="of", description="Organic Framework CLI v0 (over herdr)")
    sub = ap.add_subparsers(dest="cmd", required=True)
    # dispatched above, before this parser: listed here so that `of --help` names them (of_docs, 2026-11-11)
    for name, text in (("model", "the organization model and its measures (of_studio; of model --help)"),
                       ("studio", "the Studio page (of_studio; of studio --help)"),
                       ("works", "the works map and each work's state (= of model works)"),
                       ("secret", "a position's credential through the agents' secrets broker (of secret --help)"),
                       ("tools", "a position's MCP servers, plugins and connectors (of tools inventory|check|plan)"),
