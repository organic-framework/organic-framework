    pl.set_defaults(fn=cmd_pulse)
    mc = sub.add_parser("machines", help="tenant: revoke a machine or every machine of a person on a server")
    mc.add_argument("action", choices=["revoke"])
    mc.add_argument("--server", required=True)
    mc.add_argument("--machine-id")
    mc.add_argument("--person")
    mc.set_defaults(fn=cmd_machines)
    en = sub.add_parser("enroll", help="join organizations on a server with an invite code")
    en.add_argument("server")
    en.add_argument("--code", required=True)
    en.add_argument("--org", action="append", required=True)
    en.add_argument("--raw", action="append", help="send the raw tier for this organization (otherwise asked; default no)")
    en.add_argument("--yes", "-y", action="store_true", help="do not ask; raw only where --raw says so")
    en.set_defaults(fn=cmd_enroll)
    co = sub.add_parser("consent", help="change what this machine sends: of consent [--org X] --raw on|off")
    co.add_argument("--org", action="append")
    co.add_argument("--raw", choices=["on", "off"], required=True)
    co.set_defaults(fn=cmd_consent)
    sp = sub.add_parser("shipped", help="what has left this machine, per server and organization")
    sp.set_defaults(fn=cmd_shipped)
    sv = sub.add_parser("server", help="of-server: run, start, stop, enroll-machine, revoke, status (docs/server.md)")
    sv.add_argument("action", choices=["run", "start", "stop", "enroll-machine", "revoke", "status", "export-secret-key"])
    sv.add_argument("--daemon", action="store_true", help="run: detach (the same as `of server start`)")
    sv.add_argument("--log", help="start: the log file (default ~/.local/state/of/server.log)")
    sv.add_argument("path", nargs="?", help="export-secret-key: a new file (mode 600) for the derived masking key")
    sv.add_argument("--machine-id")
    sv.add_argument("--pubkey", help="the machine's public key file (default: this machine's key)")
    sv.add_argument("--org", action="append", help="an organization the machine joins (repeat)")
    sv.add_argument("--raw-org", action="append", help="an organization whose raw tier the person consented to")
    sv.add_argument("--tenant", action="store_true", help="the tenant's own machine: all organizations, raw included")
    sv.set_defaults(fn=cmd_server)
    sh = sub.add_parser("ship", help="send new local rows to the central ClickHouse")
    sh.set_defaults(fn=lambda a: __import__("of_ship").ship())
    dv = sub.add_parser("derive", help="derive typed events from ingested history (idempotent)")
    dv.add_argument("--session", action="append", help="only this session (repeat); default: all")
    dv.set_defaults(fn=lambda a: (__import__("of_derive").derive(__import__("of_store").connect(), a.session), 0)[1])
    rd = sub.add_parser("redact", help="remove a secret from every stored copy: of redact <session|sha>… --reason R")
    rd.add_argument("targets", nargs="*", help="session ids (or prefixes) and blob shas")
    rd.add_argument("--reason", help="why (recorded in of.redacted; never the content)")
    rd.add_argument("--from-scan", help="a JSON-lines file of {table, id} findings")
    rd.add_argument("--event", action="append", help="an event_id whose payload and record the rules change (repeat)")
    rd.add_argument("--dry-run", "-n", action="store_true")
    rd.add_argument("--local-only", action="store_true", help="do not ask the servers to replace shipped rows")
    rd.add_argument("--resend", action="store_true", help="send the already masked rows to the servers (after --local-only)")
    rd.add_argument("--transcripts", action="store_true",
                    help="the founder's option A: mask secrets in Claude Code's own transcript files (dry run)")
    rd.add_argument("--apply", action="store_true", help="with --transcripts: rewrite the files (only on the founder's yes)")
    rd.add_argument("--json", action="store_true", help="with --transcripts: counts as JSON (names and counts, never values)")
    rd.set_defaults(fn=cmd_redact)
    db = sub.add_parser("db", help="the local store: of db stats | forks | index | prompt-origins [--since] [--apply]")
    db.add_argument("action", choices=["stats", "forks", "index", "prompt-origins"])
    db.add_argument("--since", default="2026-11-01", help="prompt-origins: from this day (UTC)")
    db.add_argument("--apply", action="store_true", help="prompt-origins: write the corrections (default: report)")
    db.set_defaults(fn=cmd_db)
    r = sub.add_parser("registry", help="registry tools: of registry check")
    r.add_argument("action", choices=["check"])
    r.add_argument("--ref", choices=["remote", "local"], default="remote",
                   help="check path claims against GitHub's default branch (default; falls back to the "
                        "local checkout offline) or the local checkout")
    r.set_defaults(fn=cmd_registry)
    h = sub.add_parser("hook", help="Claude Code hook collector: of hook <HookEvent> < hook.json")
    h.add_argument("hook_event", nargs="?")
    h.set_defaults(fn=cmd_hook)
    e = sub.add_parser("event", help="declare an event: injected_prompt, state_declared, published or finance_fact")
    e.add_argument("kind", choices=["injected_prompt", "state_declared", "published", "finance_fact"])
    e.add_argument("--from-org")
    e.add_argument("--to-org")
    e.add_argument("--artifact")
    e.add_argument("--grant")
    e.add_argument("--injector")
    e.add_argument("--session")
    e.add_argument("--position")
    e.add_argument("--text")
    e.add_argument("--state")
    e.add_argument("--reason")
    fin = e.add_argument_group("finance_fact (docs/events.md, Finance facts; sent to the organization's server only)")
    fin.add_argument("--period", help="YYYY-MM; for B the day, YYYY-MM-DD, whose end the balance is at")
    fin.add_argument("--fact-kind", dest="fact_kind", choices=["T", "OE", "I", "B"])
    fin.add_argument("--category")
    fin.add_argument("--account", help="B: the treasury's own name for the account or wallet (never a number or an address)")
    fin.add_argument("--product")
    fin.add_argument("--amount", help="a decimal string")
    fin.add_argument("--currency")
    fin.add_argument("--amount-usd", dest="amount_usd")
    fin.add_argument("--fx-rate", dest="fx_rate")
    fin.add_argument("--fx-source", dest="fx_source")
    fin.add_argument("--fx-date", dest="fx_date")
    fin.add_argument("--basis", choices=["actual", "estimate"])
    fin.add_argument("--source", help="the document's reference (invoice number, statement, report id)")
    fin.add_argument("--supersedes", help="the event id of the fact this one corrects")
    e.set_defaults(fn=cmd_event)
    d = sub.add_parser("desk", help="the desk and the attention router",
                       description="of desk [show|case|pin|unpin|put|on|off|run|once] (docs/desk.md)")
    d.add_argument("action", nargs="?", choices=["show", "case", "pin", "unpin", "put", "on", "off", "run", "once"])
    d.add_argument("name", nargs="?")
    d.add_argument("slot", nargs="?", type=int)
    d.add_argument("--infer", action="store_true", help="case: infer the founder's current case now and record it")
    d.add_argument("--dry-run", action="store_true", help="case --infer: print it, record nothing")
    d.add_argument("--json", action="store_true", help="case: the record as JSON")
    d.add_argument("--trigger", help=argparse.SUPPRESS)
    d.set_defaults(fn=cmd_desk)
    co = sub.add_parser("corrections", help="the founder's corrections as records (RFC 0006): list | judge | digest",
                        description="of corrections [list|judge|digest] [--days N] [--dry-run] [--force]")
    co.add_argument("action", nargs="?", choices=["list", "judge", "digest"])
    co.add_argument("--days", type=int, default=7, help="list: this many days back")
    co.add_argument("--dry-run", action="store_true", help="judge and digest: print, record and send nothing")
    co.add_argument("--force", action="store_true", help="digest: send now, also before the hour or a second time")
    co.add_argument("--quiet", action="store_true", help=argparse.SUPPRESS)
    co.set_defaults(fn=cmd_corrections)
    cp = sub.add_parser("capacity", help="model limits per account and who runs where: of capacity status [--fresh] | plan | move <position> --to <dir> | resume <position> --session S --to <dir> --pane P")
    cp.add_argument("action", nargs="?", choices=["status", "move", "resume", "plan", "close", "balance", "creds",
                                                  "vault", "vault-setup", "mint", "babysit", "memory", "reboot"],
                    default="status")
    cp.add_argument("--since", help="babysit: from this date (default: 7 days ago)")
    cp.add_argument("--until", help="babysit: until this date or time (default: now)")
    cp.add_argument("--op-account", dest="op_account", help="vault-setup: the 1Password account (default: the business one)")
    cp.add_argument("--all-due", dest="all_due", action="store_true",
                    help="mint: every account with no setup-token, or one expiring within 7 days")
    cp.add_argument("--store", help="creds: paste a value you created (an API key) into a hidden prompt; it goes to the "
                                    "vault, only its fingerprint is recorded (your own terminal only)")
    cp.add_argument("--adopt", help="creds: record a token that exists outside the broker, by name (fingerprint only)")
    cp.add_argument("--kind", choices=["setup_token", "api_key", "codex_auth"], help="creds --adopt: the token's kind")
    cp.add_argument("--account", help="creds --adopt: the account that minted it (email)")
    cp.add_argument("--expires", help="creds --adopt: expiry date, YYYY-MM-DD")
    cp.add_argument("--fingerprint", help="creds --adopt: the first 12 hex digits of its SHA-256, if not on stdin")
    cp.add_argument("--from-stdin", dest="from_stdin", action="store_true",
                    help="creds --adopt: read the token on stdin; it is hashed and never kept")
    cp.add_argument("--consumer", help="creds --adopt: who uses it, e.g. acme:discovery tax workers")
    cp.add_argument("--session", help="close, move, resume: the session id (the registry may not name it)")
    cp.add_argument("--reason", help="close: why, e.g. 'wave 0, founder approved'; move --model: why the model "
                                     "changes, said to the session in its note")
    cp.add_argument("--model", help="move: restart the session on this model (its effort and permissions kept), "
                                    "on the same account unless --to names another")
    cp.add_argument("position", nargs="?", help="move: the position (canonical name or alias)")
    cp.add_argument("--to", help="move: the target config dir, e.g. ~/.claude-e; resume: the config dir that holds the session")
    cp.add_argument("--dry-run", "-n", action="store_true", help="move: checks and the plan only")
    cp.add_argument("--allow-shells", action="store_true", help="move: stop the session's background shells")
    cp.add_argument("--pane", help="resume: the herdr pane to start the session in")
    cp.add_argument("--only", help="reboot restore: these positions only, comma-separated")
    cp.add_argument("--into", help="move from Zellij: the herdr WORKSPACE/TAB to resume in (default: the unit's "
                                   "workspace and the system's tab)")
    cp.add_argument("--assume-empty-input", dest="assume_empty_input", action="store_true",
                    help="move: the pane is too small to draw the input box; trust an idle session with no dialog")
    cp.add_argument("--in-place", dest="in_place", action="store_true",
                    help="move from Zellij: change the account only, resume in the same Zellij pane")
    cp.add_argument("--note", help="move, resume: text from the organization appended to the hand-over note")
    cp.add_argument("--note-file", dest="note_file", help="move: the same, from a file")
    cp.add_argument("--from-transcripts", dest="from_transcripts", action="store_true",
                    help="memory: also attribute files with no originSessionId by the sessions that wrote them")
    cp.add_argument("--report", action="store_true",
                    help="memory: write each organization's list of files no position took, for its structure keeper")
    cp.add_argument("--fresh", action="store_true", help="probe every account now (else at most every 30 min)")
    cp.add_argument("--no-probe", dest="no_probe", action="store_true", help="the last reading only")
    cp.add_argument("--json", action="store_true")
    cp.set_defaults(fn=cmd_capacity)
    args = ap.parse_args(argv)
    try:
        return args.fn(args)
    except OfError as e:
        print(f"of: {e}", file=sys.stderr)
        return 2
    except Exception as e:  # server and network errors: one line, not a traceback
        if type(e).__name__ in ("ServerError", "TransportError", "URLError", "ConnectionRefusedError", "TimeoutError",
                                "RemoteDisconnected", "ConnectionResetError", "NoTTY"):
            print(f"of: {e}", file=sys.stderr)
            return 2
        raise


if __name__ == "__main__":
    sys.exit(main())
