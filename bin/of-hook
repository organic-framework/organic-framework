#!/usr/bin/env python3
"""The Claude Code hooks' entry: `of-hook <HookEvent> [--deny-secrets] < hook.json` (of_hook.main).

Python compiles a program it runs from its source every time and caches bytecode only for the modules it imports.
bin/of is 6,000 lines: run as the hook it was compiled on every tool call, 80 ms of a hook's 200 ms of CPU
(2026-11-14). This file is small, and of_hook comes from its cached bytecode. `of hook <Event>` still works.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
try:
    import of_hook  # noqa: E402
    code = of_hook.main(sys.argv[1:])
except BaseException as e:  # noqa: BLE001 - the guard fails closed: a PreToolUse hook that cannot load or run exits 2
    # with its reason on stderr, which Claude Code and Codex both take as a block; this file is what the hooks run
    # (of_architect and of_secrets-review on organic-framework PR 469: a failed import here exited 1, and the call ran)
    if sys.argv[1:2] == ["PreToolUse"]:
        sys.stderr.write(f"Organic Framework guard failed ({type(e).__name__}), so the call is denied until the guard "
                         "is fixed. Do not retry it another way; tell of_server, which keeps the guard\n")
        sys.exit(2)
    raise
sys.exit(code)
